                           :hasDifficultyLevel :Intermediate ;
                           :improves :Mobility ,
                                     :Relaxation ;
                           :requiresEquipment :Ball ,
                                              :Erhöhung ;
                           :hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke." ;
                           :hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus." ;
                           :hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Brust." ;
                           :hasDuration "4 Min" ;
                           :hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen.""" ;
                           rdfs:label "Brustmuskelmassage mit Ball"@de ,
                                      "Pectoralis Minor Release Ball"@en .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenDehnung
:BrustwirbelsaeulenDehnung rdf:type owl:NamedIndividual ,
                                    :Stretching ;
                           :engagedBodyPart :Spine ,
                                            :UpperBack ;
                           :hasContraindication :SpineIssue ;
                           :hasDifficultyLevel :Intermediate ;
                           :improves :Flexibility ,
                                     :Mobility ;
                           :requiresEquipment :None ;
                           :hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht." ;
                           :hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst." ;
                           :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Oberer Rücken." ;
                           :hasDuration "2 Min" ;
                           :hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln.""" ;
                           rdfs:label "Brustwirbelsäulen-Dehnung"@de ,
                                      "Thoracic Extension Stretch"@en .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenMassageMitDerFaszienrolle
:BrustwirbelsaeulenMassageMitDerFaszienrolle rdf:type owl:NamedIndividual ,
                                                      :Relaxation ;
                                             :engagedBodyPart :Spine ,
                                                              :UpperBack ;
                                             :hasContraindication :SpineIssue ;
                                             :hasDifficultyLevel :Intermediate ;
                                             :improves :Mobility ,
                                                       :Relaxation ;
                                             :requiresEquipment :Faszienrolle ;
                                             :hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke." ;
                                             :hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus." ;
                                             :hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Oberer Rücken." ;
                                             :hasDuration "4 Min" ;
                                             :hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen.""" ;
                                             rdfs:label "Brustwirbelsäulen-Massage mit der Faszienrolle"@de ,
                                                        "Thoracic Foam Rolling"@en .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenRotation
:BrustwirbelsaeulenRotation rdf:type owl:NamedIndividual ,
                                     :Mobilisation ;
                            :engagedBodyPart :Core ,
                                             :LowerBack ,
                                             :Shoulders ,
                                             :Spine ,
                                             :SpineJoint ,
                                             :UpperBack ;
                            :hasContraindication :SpineIssue ;
                            :hasDifficultyLevel :Intermediate ;
                            :improves :Coordination ,
                                      :Flexibility ,
                                      :Mobility ;
                            :rehabilitates :SpineJoint ;
                            :requiresEquipment :None ;
                            :stretches :Core ,
                                       :UpperBack ;
                            :hasCommonMistake "Die Rotation erfolgt hauptsächlich aus dem unteren Rücken, das Becken dreht stark mit oder die Bewegung wird ruckartig ausgeführt." ;
                            :hasCorrectionGuidance "Das Becken stabil halten und die Bewegung bewusst aus der Brustwirbelsäule einleiten. Den Bewegungsumfang verkleinern, wenn die Lendenwirbelsäule ausweicht oder Schmerzen auftreten." ;
                            :hasDescription "Eine Mobilisationsübung für die Brustwirbelsäule und den oberen Rücken. Die kontrollierte Rotation kann die Beweglichkeit des Oberkörpers verbessern und Spannungen in der Schulterblatt- und Rückenregion reduzieren." ;
                            :hasDuration "3 Min" ;
                            :hasInstruction """1. Aufrecht sitzen oder in Seitenlage eine stabile Ausgangsposition einnehmen.
2. Die Wirbelsäule lang halten und die Schultern entspannen.
3. Die Arme vor dem Körper positionieren.
4. Einen Arm langsam nach hinten führen und den Oberkörper mitdrehen.
5. Das Becken möglichst ruhig halten.
6. Der Bewegung mit dem Blick folgen.
7. Die Endposition kurz halten.
8. Langsam in die Ausgangsposition zurückkehren und die andere Seite ausführen.""" ;
                            rdfs:comment "Mobilisationsübung für die Brustwirbelsäule mit sanften Drehbewegungen."@de ;
                            rdfs:label "Brustwirbelsäulen-Rotation"@de ,
                                       "ThoracicSpineRotation"@en .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenRotationImVierfuesslerstand
:BrustwirbelsaeulenRotationImVierfuesslerstand rdf:type owl:NamedIndividual ,
                                                        :Mobilisation ;
                                               :engagedBodyPart :Spine ,
                                                                :UpperBack ;
                                               :hasContraindication :SpineIssue ;
                                               :hasDifficultyLevel :Intermediate ;
                                               :improves :Flexibility ,
                                                         :Mobility ,
                                                         :Posture ;
                                               :requiresEquipment :None ;
                                               :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
                                               :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
                                               :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität." ;
                                               :hasDuration "2 Min" ;
                                               :hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren.""" ;
                                               rdfs:label "Brustwirbelsäulen-Rotation im Vierfüßlerstand"@de ,
                                                          "Quadruped Thoracic Rotation"@en .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenRotation_SpineIssue

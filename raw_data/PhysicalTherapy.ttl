###  http://purl.org/PhysicalTherapy#AllFourswithLegExtension
:AllFourswithLegExtension rdf:type owl:NamedIndividual ,
                                   :CoordinationMobility ,
                                   :Strength ;
                          :engagedBodyPart :Abs ,
                                           :Glutes ,
                                           :HipJoint ,
                                           :Knees ,
                                           :LowerBack ,
                                           :ShoulderJoint ,
                                           :SpineJoint ;
                          :hasContraindication :AcuteLowBackPain ,
                                               :KneeFracture ,
                                               :SpineIssue ,
                                               :WristFracture ;
                          :hasDifficultyLevel :Beginner ;
                          :improves :Balance ,
                                    :Posture ,
                                    :Stability ,
                                    :Strength ;
                          :rehabilitates :Glutes ,
                                         :Hip ,
                                         :HipJoint ,
                                         :LowerBack ,
                                         :SpineJoint ;
                          :requiresEquipment :None ;
                          :strengthens :Abs ,
                                       :Glutes ,
                                       :LowerBack ;
                          :hasCommonMistake "Das Becken kippt zur Seite, der untere Rücken geht ins Hohlkreuz oder das Bein wird zu hoch gehoben." ;
                          :hasCorrectionGuidance "Das Bein nur bis auf Hüfthöhe anheben und den Rücken neutral halten. Die Bewegung langsam und ohne Schwung ausführen." ;
                          :hasDescription "Stabilisationsübung für Rumpf, Gesäß und unteren Rücken im Vierfüßlerstand. Die Übung trainiert Kontrolle, Gleichgewicht und Beckenstabilität." ;
                          :hasInstruction """1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Bauch leicht anspannen.
4. Ein Bein langsam nach hinten ausstrecken.
5. Das Becken möglichst stabil halten.
6. Das Bein kontrolliert wieder absetzen.
7. Die Seite wechseln und wiederholen.""" .



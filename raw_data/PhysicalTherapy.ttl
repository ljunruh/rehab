                  :severity :MediumRisk ;
                  rdfs:comment "Hinweis auf Handgelenk-Probleme, die bei der Plank-Übung berücksichtigt werden sollten."@de ;
                  rdfs:label "Plank_WristIssue"@en ,
                             "Unterarmstütz: Handgelenkproblem"@de .



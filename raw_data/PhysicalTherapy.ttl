                           rdfs:comment "Hinweis auf Nacken-Probleme, die bei den Nackendehnungen berücksichtigt werden sollten."@de ;
                           rdfs:label "Nackendehnungen: Nackenproblem"@de ,
                                      "NeckStretches_NeckIssue"@en .



###  http://purl.org/PhysicalTherapy#Z-Sits
:Z-Sits rdf:type owl:NamedIndividual ,
                 :Stretching ;
        :engagedBodyPart :Glutes ,
                         :Hip ,
                         :HipJoint ,
                         :LowerBack ,
                         :Pelvic ;
        :hasContraindication :HipIssue ,
                             :KneeIssue ;
        :hasDifficultyLevel :Intermediate ;
        :improves :Flexibility ,
                  :Mobility ,
                  :Stability ;
        :rehabilitates :HipJoint ;
        :stretches :Glutes ,
                   :LowerBack ;
        :hasDuration "2 Min" ;
        :hasInstruction """1. Auf eine Matte oder ein gefaltetes Handtuch setzen, die Beine zunächst nach vorne ausstrecken.
2. Das vordere Bein im rechten Winkel nach vorne beugen, den Unterschenkel senkrecht zum Körper halten.
3. Das hintere Bein im rechten Winkel zur gegenüberliegenden Seite beugen, sodass beide Unterschenkel parallel zueinander stehen und die Beine zusammen ein Z bilden.
4. Den Oberkörper aufrecht halten, das Brustbein anheben und die Schultern entspannen.
5. Das Gewicht möglichst gleichmäßig auf beide Sitzknochen verteilen und den unteren Rücken nicht runden.
6. Die Position 30 bis 60 Sekunden halten und ruhig weiteratmen.
7. Die Beine langsam in die Ausgangsstellung zurückführen und die Seite wechseln.
8. Pro Seite 2 bis 3 Wiederholungen durchführen, bei eingeschränkter Beweglichkeit ein Kissen unter die Hüfte legen.""" ;
        rdfs:comment "Sitzposition mit zur Seite angewinkelten Beinen, die zur Mobilisation der Hüfte eingesetzt wird."@de ;
        rdfs:label "Z-Sitz"@de ,
                   "ZSits"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Z-Sits ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :HipIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of Z-Sits to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Z-Sits ;

###  http://purl.org/PhysicalTherapy#HamstringIssue
:HamstringIssue rdf:type owl:NamedIndividual ;
                :requiresImprovementOf :Hamstrings ;
                rdfs:comment "Verspannung oder Schmerz in der hinteren Oberschenkelmuskulatur."@de ;
                rdfs:label "HamstringIssue"@en ,
                           "Oberschenkelrückseiten-Beschwerden"@de .


###  http://purl.org/PhysicalTherapy#HamstringStrain
:HamstringStrain rdf:type owl:NamedIndividual ,
                          :ThighMuscleInjury ;
                 :excludesExercise :HamstringStretch ,
                                   :StandingForwardBend ;
                 :requiresImprovementOf :Hamstrings ,
                                        :Strength ;
                 rdfs:comment "Zerrung oder Riss der rückseitigen Oberschenkelmuskulatur, typisch beim Sprinten oder schnellen Stoppbewegungen."@de ;
                 rdfs:label "HamstringStrain"@en ,
                            "Oberschenkelrückseiten-Zerrung"@de .


###  http://purl.org/PhysicalTherapy#HamstringStretch
:HamstringStretch rdf:type owl:NamedIndividual ,
                           :Stretching ;
                  :engagedBodyPart :Hamstrings ;
                  :hasContraindication :HamstringIssue ,
                                       :LowerBackIssue ;
                  :hasDifficultyLevel :Beginner ;
                  :improves :Flexibility ,
                            :Mobility ;
                  :requiresEquipment :None ;
                  :stretches :Hamstrings ;
                  :hasDuration "2 Min" ;
                  :hasInstruction """1. Auf den Rücken legen, beide Beine ausstrecken.
2. Ein Handtuch oder einen Gurt um den Mittelfuß eines Beins legen.
3. Das Bein am Handtuch hochheben und das Knie langsam strecken, bis eine sanfte Dehnung an der Oberschenkelrückseite spürbar ist.
4. Das Knie dabei leicht gebeugt halten, falls die Dehnung zu intensiv wird.
5. Die Position 20 bis 30 Sekunden halten und ruhig weiteratmen.
6. Das Bein kontrolliert ablegen und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen.""" ;
                  rdfs:comment "Dehnübung für die rückseitige Oberschenkelmuskulatur."@de ;
                  rdfs:label "HamstringStretch"@en ,
                             "Oberschenkelrückseiten-Dehnung"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HamstringStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :HamstringIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of HamstringStretch to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HamstringStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :LowerBackIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of HamstringStretch to avoid strain or injury."
 ] .


###  http://purl.org/PhysicalTherapy#HamstringStretch_HamstringIssue
:HamstringStretch_HamstringIssue rdf:type owl:NamedIndividual ;
                                 :forCondition :HamstringIssue ;
                                 :isContraindicationFor :HamstringStretch ;
                                 :severity :MediumRisk ;
                                 rdfs:comment "Hinweis auf Oberschenkel-Probleme, die bei der Oberschenkel-Dehnung berücksichtigt werden sollten."@de ;
                                 rdfs:label "HamstringStretch_HamstringIssue"@en ,
                                            "Oberschenkelrückseiten-Dehnung: Oberschenkelrückseiten-Problem"@de .



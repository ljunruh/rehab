###  http://purl.org/PhysicalTherapy#GebetshaltungDehnung
:GebetshaltungDehnung rdf:type owl:NamedIndividual ,
                               :Stretching ;
                      :engagedBodyPart :Back ,
                                       :Spine ;
                      :hasContraindication :SpineIssue ;
                      :hasDifficultyLevel :Beginner ;
                      :improves :Flexibility ,
                                :Mobility ;
                      :requiresEquipment :None ;
                      :hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht." ;
                      :hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst." ;
                      :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken." ;
                      :hasDuration "2 Min" ;
                      :hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln.""" ;
                      rdfs:label "Gebetshaltung-Dehnung"@de ,
                                 "Prayer Stretch"@en .


###  http://purl.org/PhysicalTherapy#GewichtsverlagerungSeitlich
:GewichtsverlagerungSeitlich rdf:type owl:NamedIndividual ,
                                      :Coordination ;
                             :engagedBodyPart :AnkleJoint ,
                                              :Core ,
                                              :Hip ,
                                              :HipJoint ,
                                              :KneeJoint ;
                             :hasContraindication :GewichtsverlagerungSeitlich_BalanceIssue ;
                             :hasDifficultyLevel :Beginner ;
                             :improves :Balance ,
                                       :Coordination ,
                                       :Mobility ;
                             :requiresEquipment :None ;
                             :hasDuration "2 Min" ;
                             :hasInstruction """1. Aufrecht stehen, Füße etwas mehr als hüftbreit auseinander, Hände seitlich an den Hüften.
2. Den Blick nach vorne richten, Knie leicht gebeugt und Rumpf aufrecht halten.
3. Das Gewicht langsam auf das rechte Bein verlagern, bis ungefähr 80 Prozent des Gewichts auf der rechten Seite lastet.
4. Das rechte Knie dabei leicht beugen, ohne den Rumpf zur Seite zu neigen.
5. Die Endposition kurz halten, dann langsam zur Mitte zurückkehren.
6. Die Bewegung zur anderen Seite wiederholen.
7. Pro Seite 8 bis 10 Wiederholungen mit bewussten Pausen durchführen.""" ;
                             rdfs:comment "Übung, bei der das Körpergewicht langsam von einem Bein auf das andere verlagert wird."@de ;
                             rdfs:label "LateralWeightShift"@en ,
                                        "Seitliche Gewichtsverlagerung"@de .


###  http://purl.org/PhysicalTherapy#GewichtsverlagerungSeitlich_BalanceIssue
:GewichtsverlagerungSeitlich_BalanceIssue rdf:type owl:NamedIndividual ;
                                          :forCondition :BalanceIssue ;
                                          :severity :LowRisk ;
                                          rdfs:comment "Hinweis auf Gleichgewichts-Probleme, die bei der seitlichen Gewichtsverlagerung berücksichtigt werden sollten."@de ;
                                          rdfs:label "LateralWeightShift_BalanceIssue"@en ,
                                                     "Seitliche Gewichtsverlagerung: Gleichgewichtsproblem"@de .


###  http://purl.org/PhysicalTherapy#GleichgewichtInstabil
:GleichgewichtInstabil rdf:type owl:NamedIndividual ,
                                :Coordination ;
                       :engagedBodyPart :AnkleJoint ,
                                        :Ankles ,
                                        :Core ;
                       :hasContraindication :GleichgewichtInstabil_AnkleIssue ,
                                            :GleichgewichtInstabil_BalanceIssue ;
                       :hasDifficultyLevel :Intermediate ;
                       :improves :Balance ,
                                 :Coordination ,
                                 :Stability ;
                       :requiresEquipment :None ;
                       :hasDuration "2 Min" ;
                       :hasInstruction """1. Eine weiche, instabile Unterlage wie ein Balancekissen oder Schaumstoffpad auf eine rutschfeste Fläche legen.
2. Aufrecht neben einer stabilen Stütze wie einer Küchenzeile stehen und sich anfangs mit den Fingerspitzen festhalten.
3. Beide Füße hüftbreit auf die Unterlage stellen, das Gewicht gleichmäßig verteilen.
4. Rumpf aufrichten, Schultern entspannen, Blick geradeaus richten.
5. Die Position 30 Sekunden halten und das Gleichgewicht halten.
6. Kleine Gewichtsverlagerungen nach vorne, hinten und zur Seite ausprobieren, ohne den Stand zu verlieren.
7. Mit zunehmender Sicherheit den Fingerkontakt lösen, später optional ein Bein anheben.
8. Übung mit langen Pausen über zwei Minuten wiederholen.""" ;
                       rdfs:comment "Übung auf instabilem Untergrund, die Gleichgewicht und tiefe Stabilisationsmuskulatur anspricht."@de ;
                       rdfs:label "Gleichgewicht auf instabilem Untergrund"@de ,
                                  "UnstableBalance"@en .


###  http://purl.org/PhysicalTherapy#GleichgewichtInstabil_AnkleIssue
:GleichgewichtInstabil_AnkleIssue rdf:type owl:NamedIndividual ;
                                  :forCondition :AnkleIssue ;
                                  :severity :MediumRisk ;
                                  rdfs:comment "Hinweis auf Sprunggelenk-Probleme, die bei der Gleichgewichtsübung auf instabilem Untergrund berücksichtigt werden sollten."@de ;
                                  rdfs:label "Gleichgewicht auf instabilem Untergrund: Sprunggelenkproblem"@de ,
                                             "UnstableBalance_AnkleIssue"@en .


###  http://purl.org/PhysicalTherapy#GleichgewichtInstabil_BalanceIssue

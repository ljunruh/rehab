###  http://purl.org/PhysicalTherapy#ArmhebenImVierfuesslerstand
:ArmhebenImVierfuesslerstand rdf:type owl:NamedIndividual ,
                                      :Coordination ;
                             :engagedBodyPart :Core ,
                                              :Hip ,
                                              :LowerBack ,
                                              :Obliques ;
                             :hasContraindication :SpineIssue ;
                             :hasDifficultyLevel :Beginner ;
                             :improves :Coordination ,
                                       :Mobility ,
                                       :Stability ;
                             :requiresEquipment :None ;
                             :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Versuche stattdessen, ruhig und kontrolliert gegenzusteuern, um das Gleichgewicht zu halten." ;
                             :hasCorrectionGuidance "Führe die Bewegung langsam und kontrolliert aus. Fixiere dabei einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Unterstützung." ;
                             :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf." ;
                             :hasDuration "2 Min" ;
                             :hasInstruction """1. Gehe in den Vierfüßlerstand.
2. Spanne deinen Rumpf an und halte den Rücken stabil.
3. Strecke einen Arm, ein Bein oder beides langsam und kontrolliert aus.
4. Führe Arm und Bein zurück, ohne das Becken zur Seite zu drehen.""" ;
                             rdfs:comment "Eine Übung im Vierfüßlerstand zur Verbesserung der Rumpfstabilität, Körperkontrolle und Koordination durch das kontrollierte Strecken von Arm und Bein."@de ;
                             rdfs:label "Armheben im Vierfüßlerstand"@de ,
                                        "Quadruped Arm Reach"@en .


###  http://purl.org/PhysicalTherapy#Armkreisen
:Armkreisen rdf:type owl:NamedIndividual ,
                     :Coordination ;
            :engagedBodyPart :Chest ,
                             :Glutes ,
                             :RotatorCuffs ,
                             :ShoulderJoint ,
                             :Shoulders ,
                             :Trapezius ,
                             :UpperBack ;
            :hasContraindication :ShoulderIssue ;
            :hasDifficultyLevel :Intermediate ;
            :improves :Balance ,
                      :Coordination ,
                      :Mobility ;
            :rehabilitates :ShoulderJoint ,
                           :Shoulders ,
                           :UpperBack ;
            :requiresEquipment :None ;
            :hasCommonMistake "Die Schultern werden hochgezogen, die Bewegung wird zu schnell ausgeführt oder der Oberkörper weicht stark aus." ;
            :hasCorrectionGuidance "Die Schultern bewusst locker lassen und die Bewegung langsam kontrollieren. Den Bewegungsradius verkleinern, wenn Schmerzen oder Ausweichbewegungen auftreten." ;
            :hasDescription "Eine einfache Mobilisationsübung für Schultergelenke, Schultergürtel und oberen Rücken. Die Übung verbessert die Beweglichkeit der Schultern und bereitet die Muskulatur auf weitere Bewegungen vor." ;
            :hasDuration "2 Min" ;
            :hasInstruction """1. Aufrecht stehen oder sitzen.
2. Die Arme seitlich ausstrecken oder locker neben dem Körper halten.
3. Kleine kontrollierte Kreise mit den Armen ausführen.
4. Die Kreise langsam größer werden lassen.
5. Nach einigen Wiederholungen die Richtung wechseln.
6. Die Schultern entspannt halten und gleichmäßig atmen""" ;
            rdfs:comment "Einfache Mobilisationsübung für Schultergelenke, Schultergürtel und oberen Rücken."@de ;
            rdfs:label "ArmCircles"@en ,
                       "Armkreisen"@de .



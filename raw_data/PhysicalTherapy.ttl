                                         :severity :LowRisk ;
                                         rdfs:comment "Hinweis auf Schulter-Probleme, die bei der Schulter-Nacken-Entspannung berücksichtigt werden sollten."@de ;
                                         rdfs:label "Schulter-Nacken-Entspannung: Schulterproblem"@de ,
                                                    "ShoulderNeckRelaxation_ShoulderIssue"@en .


###  http://purl.org/PhysicalTherapy#SchulterabduktionMitStab
:SchulterabduktionMitStab rdf:type owl:NamedIndividual ,
                                   :Mobilisation ;
                          :engagedBodyPart :Shoulders ,
                                           :UpperBack ;
                          :hasContraindication :ShoulderIssue ;
                          :hasDifficultyLevel :Beginner ;
                          :improves :Flexibility ,
                                    :Mobility ,
                                    :Posture ;
                          :requiresEquipment :Stick ;
                          :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
                          :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
                          :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität." ;
                          :hasDuration "2 Min" ;
                          :hasInstruction """1. Stab mit beiden Händen halten.
2. Der gesunde Arm führt die Bewegung.
3. Arm langsam anheben.
4. Ohne Schmerz zurückführen.""" ;
                          rdfs:label "Schulterabduktion mit Stab"@de ,
                                     "Wand Assisted Abduction"@en .


###  http://purl.org/PhysicalTherapy#SchulterabduktionMitTheraband
:SchulterabduktionMitTheraband rdf:type owl:NamedIndividual ,
                                        :Strength ;
                               :engagedBodyPart :Shoulders ,
                                                :UpperBack ;
                               :hasContraindication :ShoulderIssue ;
                               :hasDifficultyLevel :Intermediate ;
                               :improves :Posture ,
                                         :Stability ,
                                         :Strength ;
                               :requiresEquipment :Theraband ;
                               :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
                               :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
                               :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern." ;
                               :hasDuration "4 Min" ;
                               :hasInstruction """1. Theraband sicher fixieren.
2. Schulter tief halten.
3. Arm kontrolliert nach vorn oder seitlich anheben.
4. Langsam absenken.""" ;
                               rdfs:label "Schulterabduktion mit Theraband"@de ,
                                          "Shoulder Abduction Band"@en .



###  http://purl.org/PhysicalTherapy#MountainClimber
:MountainClimber rdf:type owl:NamedIndividual ,
                          :Strength ;
                 :engagedBodyPart :Core ,
                                  :Glutes ,
                                  :Hip ,
                                  :Quadriceps ,
                                  :Shoulders ,
                                  :Triceps ;
                 :hasContraindication :ShoulderIssue ,
                                      :SpineIssue ,
                                      :WristIssue ;
                 :hasDifficultyLevel :Intermediate ;
                 :improves :Balance ,
                           :Coordination ,
                           :Mobility ,
                           :Strength ;
                 :rehabilitates :Back ,
                                :Spine ;
                 :requiresEquipment :None ;
                 :strengthens :Abs ,
                              :Chest ,
                              :FrontDeltoid ,
                              :Quadriceps ,
                              :Triceps ;
                 :hasDuration "2 Min" ;
                 :hasInstruction """1. In die Liegestützposition kommen, Hände unter den Schultern, Arme gestreckt.
2. Den Rumpf stabilisieren, sodass Schultern, Hüfte und Knie eine Linie bilden.
3. Ein Knie kontrolliert in Richtung Brust ziehen.
4. Das Bein zügig, aber kontrolliert wieder in die Ausgangsposition bringen und gleichzeitig das andere Knie nach vorne ziehen.
5. Die Beine in einem gleichmäßigen Rhythmus abwechseln, ohne dass das Becken stark nach oben oder unten schwingt.
6. Anfangs 20 Sekunden arbeiten, 20 Sekunden Pause, insgesamt drei Sätze.
7. Bei besserer Ausdauer auf 30 bis 45 Sekunden pro Satz steigern.""" ;
                 rdfs:comment "Dynamische Übung im Liegestütz, bei der die Beine abwechselnd zur Brust gezogen werden."@de ;
                 rdfs:label "Bergsteiger"@de ,
                            "MountainClimber"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :MountainClimber ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :ShoulderIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of MountainClimber to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;

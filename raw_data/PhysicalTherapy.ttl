###  http://purl.org/PhysicalTherapy#PigeonPose
:PigeonPose rdf:type owl:NamedIndividual ,
                     :Mobilisation ;
            :engagedBodyPart :Glutes ,
                             :Hip ,
                             :HipJoint ,
                             :Knees ,
                             :LowerBack ,
                             :Psoas ;
            :hasContraindication :HipIssue ,
                                 :KneeIssue ;
            :hasDifficultyLevel :Beginner ;
            :improves :Flexibility ,
                      :Mobility ,
                      :Relaxation ;
            :rehabilitates :HipJoint ;
            :requiresEquipment :None ;
            :stretches :Glutes ,
                       :LowerBack ,
                       :Psoas ;
            :hasCommonMistake "Das Becken kippt stark zur Seite, das vordere Knie wird unter Druck verdreht oder der Körper wird gewaltsam nach unten gedrückt." ;
            :hasCorrectionGuidance "Ein Kissen oder einen Block unter die Hüfte legen, wenn das Becken nicht stabil bleibt. Den Winkel des vorderen Beins verkleinern und die Position sofort verlassen, wenn Knieschmerzen auftreten." ;
            :hasDescription "Eine vereinfachte Hüftdehnung, die insbesondere Gesäß- und Hüftmuskulatur anspricht. Die Übung kann die Beweglichkeit der Hüfte verbessern und Spannungen in der Gesäßregion reduzieren." ;
            :hasDuration "2 Min" ;
            :hasInstruction """1. Im Vierfüßlerstand beginnen.
2. Ein Knie nach vorne in Richtung der gleichseitigen Hand führen.
3. Den Unterschenkel bequem vor dem Körper ablegen.
4. Das andere Bein nach hinten ausstrecken.
5. Das Becken möglichst gerade ausrichten.
6. Den Oberkörper aufrecht halten oder langsam nach vorne absenken.
7. Die Position im schmerzfreien Bereich halten und ruhig atmen.
8. Langsam lösen und die Seite wechseln.""" ;
            rdfs:comment "Dehnübung im Sitzen, die die äußere Hüftmuskulatur und den Piriformis-Muskel gezielt dehnt."@de ;
            rdfs:label "PigeonPose"@en ,
                       "Taube"@de .



###  http://purl.org/PhysicalTherapy#Triceps
:Triceps rdf:type owl:NamedIndividual ,
                  :Muscle ;
         :partOf :Arms ;
         rdfs:comment "Trizeps, der Streckmuskel an der Rückseite des Oberarms."@de ;
         rdfs:label "Triceps"@en ,
                    "Trizeps"@de .


###  http://purl.org/PhysicalTherapy#TricepsStretch
:TricepsStretch rdf:type owl:NamedIndividual ,
                         :Stretching ;
                :engagedBodyPart :Triceps ;
                :hasContraindication :ShoulderIssue ;
                :hasDifficultyLevel :Beginner ;
                :improves :Flexibility ,
                          :Mobility ;
                :requiresEquipment :None ;
                :stretches :Triceps ;
                :hasDuration "2 Min" ;
                :hasInstruction """1. Aufrecht stehen oder aufrecht auf einem Stuhl sitzen, die Füße hüftbreit.
2. Einen Arm seitlich am Körper hängen lassen, dann den Oberarm anheben und den Ellbogen beugen.
3. Die Hand des angehobenen Arms auf den oberen Rücken legen, zwischen die Schulterblätter.
4. Mit der anderen Hand sanft den angehobenen Ellbogen in Richtung Kopf ziehen.
5. Den Nacken lang lassen, die Schulter entspannt nach unten halten und nicht hochziehen.
6. Die Dehnung 20 bis 30 Sekunden halten und gleichmäßig weiteratmen.
7. Den Arm langsam lösen und die Seite wechseln.
8. Pro Seite 2 bis 3 Wiederholungen durchführen.""" ;
                rdfs:comment "Dehnübung für den Trizeps an der Rückseite des Oberarms."@de ;
                rdfs:label "TricepsStretch"@en ,
                           "Trizepsdehnung"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :TricepsStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :ShoulderIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of TricepsStretch to avoid strain or injury."
 ] .


###  http://purl.org/PhysicalTherapy#TricepsStretch_ShoulderIssue
:TricepsStretch_ShoulderIssue rdf:type owl:NamedIndividual ;
                              :forCondition :ShoulderIssue ;
                              :severity :LowRisk ;
                              rdfs:comment "Hinweis auf Schulter-Probleme, die bei der Trizeps-Dehnung berücksichtigt werden sollten."@de ;
                              rdfs:label "TricepsStretch_ShoulderIssue"@en ,
                                         "Trizepsdehnung: Schulterproblem"@de .


###  http://purl.org/PhysicalTherapy#TriggerpunktmassageDerGesaessmuskulatur
:TriggerpunktmassageDerGesaessmuskulatur rdf:type owl:NamedIndividual ,
                                                  :Relaxation ;
                                         :engagedBodyPart :Glutes ,
                                                          :Hip ;
                                         :hasContraindication :HipIssue ;
                                         :hasDifficultyLevel :Intermediate ;
                                         :improves :Mobility ,
                                                   :Relaxation ;
                                         :requiresEquipment :None ;
                                         :hasCommonMistake "Zu starker Druck oder ein Rollen direkt über Knochen und Gelenke." ;
                                         :hasCorrectionGuidance "Den Druck reduzieren, langsam arbeiten und empfindliche Strukturen wie Knochen und Gelenke gezielt aussparen." ;
                                         :hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Gesäß." ;
                                         :hasDuration "4 Min" ;
                                         :hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen.""" ;
                                         rdfs:label "Glute Trigger Point Release"@en ,
                                                    "Triggerpunktmassage der Gesäßmuskulatur"@de .


###  http://purl.org/PhysicalTherapy#TrizepsDehnung
:TrizepsDehnung rdf:type owl:NamedIndividual ,
                         :Stretching ;
                :engagedBodyPart :Arms ,
                                 :Shoulders ,
                                 :Triceps ;
                :hasContraindication :ShoulderIssue ;
                :hasDifficultyLevel :Beginner ;
                :improves :Flexibility ,
                          :Mobility ;
                :requiresEquipment :None ;
                :hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht." ;
                :hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst." ;
                :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Trizeps." ;
                :hasDuration "2 Min" ;
                :hasInstruction """1. Aufrecht stehen oder aufrecht auf einem Stuhl sitzen, die Füße hüftbreit.
2. Einen Arm seitlich am Körper hängen lassen, dann den Oberarm anheben und den Ellbogen beugen.
3. Die Hand des angehobenen Arms auf den oberen Rücken legen, zwischen die Schulterblätter.
4. Mit der anderen Hand sanft den angehobenen Ellbogen in Richtung Kopf ziehen.
5. Den Nacken lang lassen, die Schulter entspannt nach unten halten und nicht hochziehen.
6. Die Dehnung 20 bis 30 Sekunden halten und gleichmäßig weiteratmen.
7. Den Arm langsam lösen und die Seite wechseln.
8. Pro Seite 2 bis 3 Wiederholungen durchführen.""" ;
                rdfs:comment "Dehnübung für den Trizeps an der Rückseite des Oberarms."@de ;
                rdfs:label "Triceps Stretch"@en ,
                           "Trizeps-Dehnung"@de .



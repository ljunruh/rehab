###  http://purl.org/PhysicalTherapy#SingleLegBridge
:SingleLegBridge rdf:type owl:NamedIndividual ,
                          :Strength ;
                 :engagedBodyPart :Core ,
                                  :Glutes ,
                                  :Hamstrings ,
                                  :HipJoint ,
                                  :LowerBack ,
                                  :Pelvic ;
                 :hasContraindication :KneeIssue ,
                                      :LowerBackIssue ;
                 :hasDifficultyLevel :Intermediate ;
                 :improves :Balance ,
                           :Stability ,
                           :Strength ;
                 :rehabilitates :HipJoint ,
                                :LowerBack ;
                 :strengthens :Core ,
                              :Glutes ,
                              :Hamstrings ;
                 :hasDuration "2 Min" ;
                 :hasInstruction """1. Auf den Rücken legen, beide Knie anwinkeln und die Füße hüftbreit aufstellen.
2. Ein Knie zur Brust ziehen, sodass der Oberschenkel senkrecht steht und der Unterschenkel parallel zum Boden bleibt.
3. Die Bauchmuskulatur anspannen und das Becken in eine neutrale Position bringen.
4. Über die Ferse des stehenden Beins das Becken kontrolliert anheben, bis Schulter, Hüfte und Knie eine Linie bilden.
5. Das Gesäß am oberen Punkt kurz anspannen und die Hüfte waagerecht halten.
6. Die Hüfte langsam wieder absenken, ohne den unteren Rücken ins Hohlkreuz fallen zu lassen.
7. 10 bis 15 Wiederholungen pro Seite durchführen, dann die Seite wechseln.
8. Pro Seite 2 bis 3 Sätze absolvieren.""" ;
                 rdfs:comment "Variante der Brücke, bei der ein Bein angehoben wird, um Gesäß und hintere Oberschenkel einseitig zu kräftigen."@de ;
                 rdfs:label "Einbein-Brücke"@de ,
                            "SingleLegBridge"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :SingleLegBridge ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :KneeIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of SingleLegBridge to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :SingleLegBridge ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :LowerBackIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of SingleLegBridge to avoid strain or injury."
 ] .


###  http://purl.org/PhysicalTherapy#Sitting
:Sitting rdf:type owl:NamedIndividual ,
                  :SportActivity ;
         :Calorie 71.0 ;

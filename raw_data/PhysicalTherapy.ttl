:TherabandAussenrotation_ShoulderIssue rdf:type owl:NamedIndividual ;
                                       :forCondition :ShoulderIssue ;
                                       :severity :MediumRisk ;
                                       rdfs:comment "Hinweis auf Schulter-Probleme, die bei der Theraband-Außenrotation berücksichtigt werden sollten."@de ;
                                       rdfs:label "Außenrotation mit Theraband: Schulterproblem"@de ,
                                                  "TherabandExternalRotation_ShoulderIssue"@en .



###  http://purl.org/PhysicalTherapy#Bauch
:Bauch rdf:type owl:NamedIndividual ,
                :BodyPart ;
       :partOf :Core ;
       rdfs:comment "Der Bauch ist der vordere Teil des Rumpfes zwischen Brustkorb und Becken."@de ;
       rdfs:label "Bauch"@de ,
                  "Belly"@en .


###  http://purl.org/PhysicalTherapy#BauchatmungInBauchlage
:BauchatmungInBauchlage rdf:type owl:NamedIndividual ,
                                 :Relaxation ;
                        :engagedBodyPart :Back ,
                                         :Core ;
                        :hasContraindication :RespiratoryIssue ;
                        :hasDifficultyLevel :Beginner ;
                        :improves :Focus ,
                                  :Relaxation ;
                        :requiresEquipment :None ;
                        :hasCommonMistake "Vermeide eine schnelle und flache Atmung in den Brustkorb. Atme stattdessen bewusst und ruhig in den Bauch." ;
                        :hasCorrectionGuidance "Verlangsame bewusst das Tempo und lasse die Ausatmung etwas länger werden als die Einatmung." ;
                        :hasDescription "Bauchatmung in Bauchlage ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert." ;
                        :hasDuration "5 Min" ;
                        :hasInstruction """1. In Bauchlage legen.
2. Stirn auf den Händen ablegen.
3. In den Bauch und die Flanken atmen.
4. Langsam ausatmen.""" ;
                        rdfs:label "Bauchatmung in Bauchlage"@de ,
                                   "Crocodile Breathing"@en .


###  http://purl.org/PhysicalTherapy#BauchlageKobra
:BauchlageKobra rdf:type owl:NamedIndividual ,
                         :Strength ;
                :engagedBodyPart :Core ,
                                 :LowerBack ;
                :hasContraindication :SpineIssue ;
                :hasDifficultyLevel :Intermediate ;
                :improves :Posture ,
                          :Stability ,
                          :Strength ;
                :requiresEquipment :None ;
                :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
                :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
                :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf." ;
                :hasDuration "4 Min" ;
                :hasInstruction """1. In Bauchlage gehen.
2. Rumpf und Gesäß leicht anspannen.
3. Brustbein kontrolliert anheben.
4. Nacken neutral halten und absenken.""" ;
                rdfs:label "Bauchlage-Kobra"@de ,
                           "Prone Cobra"@en .



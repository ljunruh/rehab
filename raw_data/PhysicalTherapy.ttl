###  http://purl.org/PhysicalTherapy#GymnastikballRollout
:GymnastikballRollout rdf:type owl:NamedIndividual ,
                               :Coordination ;
                      :engagedBodyPart :Core ,
                                       :LowerBack ;
                      :hasContraindication :LowerBackIssue ;
                      :hasDifficultyLevel :Advanced ;
                      :improves :Balance ,
                                :Coordination ,
                                :Stability ;
                      :requiresEquipment :Ball ,
                                         :Erhöhung ;
                      :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten." ;
                      :hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze." ;
                      :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf." ;
                      :hasDuration "2–3 Min" ;
                      :hasInstruction """1. Stützposition einnehmen.
2. Bauch und Gesäß anspannen.
3. Körper in einer stabilen Linie halten.
4. Ruhig atmen und kontrolliert lösen.""" ;
                      rdfs:label "Gymnastikball-Rollout"@de ,
                                 "Stability Ball Rollout"@en .



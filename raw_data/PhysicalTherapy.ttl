###  http://purl.org/PhysicalTherapy#Chest
:Chest rdf:type owl:NamedIndividual ,
                :BodyPart ,
                :Muscle ;
       :partOf :Torso ;
       rdfs:comment "Brust als Körperregion, die den Brustkorb und die Brustmuskulatur umfasst."@de ;
       rdfs:label "Brust"@de ,
                  "Chest"@en .


###  http://purl.org/PhysicalTherapy#ChestDoorwayStretch
:ChestDoorwayStretch rdf:type owl:NamedIndividual ,
                              :Stretching ;
                     :engagedBodyPart :Chest ,
                                      :Shoulders ;
                     :hasContraindication :ShoulderIssue ;
                     :hasDifficultyLevel :Intermediate ;
                     :improves :Flexibility ,
                               :Mobility ,
                               :Posture ;
                     :rehabilitates :Shoulders ;
                     :requiresEquipment :Door ;
                     :stretches :Chest ,
                                :Shoulders ;
                     :hasCommonMistake "Achte darauf, dass du bei der Bewegungsausführung nicht ins Hohlkreuz gelangst. Du darfst dein Kinn nicht nach vorne Schieben. Die Schultern dürfen hierbei nicht hochgezpgen werden. Die 90 Grad der Ellbogen müssen eingehalten werden, weil sonst die Belastung verschoben wird." ;
                     :hasCorrectionGuidance "Lehne dich aus der Brust, nicht aus dem Rücken. Die Vorwärtsbewegung kommt aus dem Brustbein. Das Kinn bildet eine Linie mit dem Brustbein, du darfst kein Doppelkinn erzwingen. Beim langsamen Ausatmen kann sich das Brustbein besser senen und die Dehnung wird tiefer." ;
                     :hasDescription "Dehnübung, die mithilfe eines Türrahmens die Brustmuskulatur sowie die vordere Schulter dehnt. Die Übung öffnet die Körpervorderseite, wirkt die nach vorne gerollten Schultern entgegen und verbessert die Schulter- und Nackenmobilität." ;
                     :hasDuration "2 Min" ;
                     :hasInstruction """1. Stelle dich aufrecht in einen offenen Türrahmen, Füße schulterbreit.
2. Hebe beide Arme seitlich auf Schulterhöhe an und winke die Ellbogen im 90-Grad-Winkel ab, die Unterarme liegen flach am Türrahmen an, Handflächen zeigen nach vorne.
3. Ziehe die Schulterblätter bewusst nach unten und hinten (nicht hochziehen).
4. Mache einen kleinen Schritt mit einem Fuß nach vorne durch den Türrahmen.
5. Lehne den Brustkorb langsam nach vorne, bis du eine sanfte Dehnung quer über Brust und Vorderschultern spürst.
6. Halte den Hals neutral, das Kinn parallel zum Boden, Blick nach vorne.
7. Löse die Dehnung, indem du langsam zurücktrittst.""" ;
                     rdfs:comment "Dehnübung für Brust und vordere Schulter im Türrahmen."@de ;
                     rdfs:label "Brustdehnung im Türrahmen"@de ,
                                "ChestDoorwayStretch"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ChestDoorwayStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :ShoulderIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of ChestDoorwayStretch to avoid strain or injury."
 ] .



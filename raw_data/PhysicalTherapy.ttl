 ] .


###  http://purl.org/PhysicalTherapy#Zwerchfellatmung
:Zwerchfellatmung rdf:type owl:NamedIndividual ,
                           :Relaxation ;
                  :engagedBodyPart :Back ,
                                   :Core ;
                  :hasContraindication :RespiratoryIssue ;
                  :hasDifficultyLevel :Beginner ;
                  :improves :Focus ,
                            :Relaxation ;
                  :requiresEquipment :None ;
                  :hasCommonMistake "Vermeide eine schnelle und flache Atmung in den Brustkorb. Atme stattdessen bewusst und ruhig in den Bauch." ;
                  :hasCorrectionGuidance "Atme bewusst langsamer und versuche, etwas länger auszuatmen als einzuatmen." ;
                  :hasDescription "Zwerchfellatmung ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert." ;
                  :hasDuration "3 Min" ;
                  :hasInstruction """1. Lege oder setze dich bequem hin.
2. Lege eine Hand auf deinen Bauch.
3. Atme langsam durch die Nase ein und spüre, wie sich dein Bauch hebt.
4. Atme anschließend ruhig und langsam wieder aus.
.""" ;
                  rdfs:label "Diaphragmatic Breathing"@en ,
                             "Zwerchfellatmung"@de .



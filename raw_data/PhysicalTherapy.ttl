###  http://purl.org/PhysicalTherapy#StandingCalfStretch
:StandingCalfStretch rdf:type owl:NamedIndividual ,
                              :Stretching ;
                     :engagedBodyPart :Calves ;
                     :hasContraindication :AnkleIssue ;
                     :hasDifficultyLevel :Beginner ;
                     :improves :Flexibility ,
                               :Mobility ;
                     :requiresEquipment :Wall ;
                     :stretches :Calves ;
                     :hasDuration "2 Min" ;
                     :hasInstruction """1. Mit beiden Händen an einer Wand auf Schulterhöhe abstützen, Arme gestreckt.
2. Ein Bein nach hinten setzen, das Knie des hinteren Beins gestreckt halten.
3. Die Ferse des hinteren Fußes fest in den Boden drücken, die Zehen zeigen nach vorne.
4. Das vordere Knie langsam beugen und das Becken nach vorne schieben.
5. Die Dehnung in der Wade des hinteren Beins halten, ohne den Fuß nach außen zu drehen.
6. Die Position 30 Sekunden halten und ruhig weiteratmen.
7. Die Seite wechseln und pro Seite 2 bis 3 Wiederholungen durchführen.""" ;
                     rdfs:comment "Dehnübung für die Wadenmuskulatur im Stehen."@de ;
                     rdfs:label "StandingCalfStretch"@en ,
                                "Wadendehnung im Stehen"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :StandingCalfStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :AnkleIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of StandingCalfStretch to avoid strain or injury."
 ] .



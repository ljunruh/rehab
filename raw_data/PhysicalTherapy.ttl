                                    :StandingSideBend_Torso ,
                                    :StandingSideStretchInstruction ;
                  :improves :Balance ,
                            :Coordination ,
                            :Flexibility ,
                            :Focus ,
                            :Mobility ,
                            :Posture ,
                            :Relaxation ,
                            :Stability ;
                  :opens :Shoulders ;
                  :strengthens :Legs ;
                  :stretches :Obliques ;
                  rdfs:comment "Ardha Kati Chakrasana" ;

###  http://purl.org/PhysicalTherapy#YHeben
:YHeben rdf:type owl:NamedIndividual ,
                 :Strength ;
        :engagedBodyPart :Shoulders ,
                         :UpperBack ;
        :hasContraindication :ShoulderIssue ;
        :hasDifficultyLevel :Intermediate ;
        :improves :Posture ,
                  :Stability ,
                  :Strength ;
        :requiresEquipment :None ;
        :hasCommonMistake "Die Rumpfspannung verlieren und die Bewegung mit Schwung statt kontrolliert ausführen." ;
        :hasCorrectionGuidance "Das Tempo verlangsamen, die Wirbelsäule neutral ausrichten und die Belastung erst bei sauberer Technik steigern." ;
        :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern." ;
        :hasDuration "4 Min." ;
        :hasInstruction """1. In Bauchlage oder leichter Vorbeuge starten.
2. Schulterblätter stabilisieren.
3. Arme in der vorgegebenen Form anheben.
4. Langsam absenken.""" ;
        rdfs:comment "Eine Übung zur Kräftigung der Schulter- und oberen Rückenmuskulatur, bei der die Arme kontrolliert in einer Y-Position angehoben werden."@de ;
        rdfs:label "Y Raise"@en ,
                   "Y-Heben"@de .



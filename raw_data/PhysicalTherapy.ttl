@prefix : <http://purl.org/PhysicalTherapy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix YogaKG: <http://www.ease-crc.org/ont/yoga#> .
@base <http://purl.org/PhysicalTherapy> .

<http://purl.org/PhysicalTherapy> rdf:type owl:Ontology ;
                                   owl:versionIRI <http://purl.org/PhysicalTherapy/1.0> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/PhysicalTherapy#Calorie
:Calorie rdf:type owl:ObjectProperty ;
         rdfs:domain :SportActivity .


###  http://purl.org/PhysicalTherapy#MET
:MET rdf:type owl:ObjectProperty ;
     rdfs:domain :SportActivity .


###  http://purl.org/PhysicalTherapy#avoidsAsana
:avoidsAsana rdf:type owl:ObjectProperty ;
             rdfs:domain :Patient ;
             rdfs:range :Asana ;
             rdfs:comment "Yoga-Haltung, die von der Patientin oder dem Patienten gemieden wird."@de ;
             rdfs:label "avoidsAsana"@en .


###  http://purl.org/PhysicalTherapy#engagedBodyPart
:engagedBodyPart rdf:type owl:ObjectProperty ;
                 owl:inverseOf :isEngagedBy ;
                 rdfs:domain :Asana ,
                             :Exercise ;
                 rdfs:range :BodyPart ;
                 rdfs:comment "Körperteil, das bei einer Übung aktiv beansprucht wird."@de ;
                 rdfs:label "engagedBodyPart"@en .


###  http://purl.org/PhysicalTherapy#examinesJoint
:examinesJoint rdf:type owl:ObjectProperty ;
               owl:inverseOf :isExaminedBy ;
               rdfs:range :Joint ;
               rdfs:comment "Gelenk, das im Rahmen einer Bewegungsuntersuchung untersucht wird"@de ;
               rdfs:label "examinesJoint"@en .


###  http://purl.org/PhysicalTherapy#excludesExercise
:excludesExercise rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Injury ;
                  rdfs:range :Exercise ;
                  rdfs:comment "Schließt die Aufgaben aus, falls in diesem Bereich eine Verletzung gibt"@de ;
                  rdfs:label "excludesExercise"@en .


###  http://purl.org/PhysicalTherapy#forCondition
:forCondition rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasContraindication ;
              rdfs:domain :Contraindication ;
              rdfs:comment "Beschwerde oder körperliche Einschränkung, bei der dieses Ausschlusskriterium zu beachten ist."@de ;
              rdfs:label "forCondition"@en .


###  http://purl.org/PhysicalTherapy#hasBreathingGuidance
:hasBreathingGuidance rdf:type owl:ObjectProperty ;
                      rdfs:comment "Atemanleitung, die beim Ausführen der Yoga-Haltung beachtet werden soll."@de ;
                      rdfs:label "hasBreathingGuidance"@en .


###  http://purl.org/PhysicalTherapy#hasContraindication
:hasContraindication rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isContraindicationFor ;
                     rdfs:domain :Asana ,
                                 :Exercise ;
                     rdfs:range :Injury ;
                     rdfs:comment "Ausschlusskriterium, das bei der Ausführung der Übung beachtet werden muss."@de ;
                     rdfs:label "hasContraindication"@en .


###  http://purl.org/PhysicalTherapy#hasDifficultyLevel
:hasDifficultyLevel rdf:type owl:ObjectProperty ;
                    rdfs:domain :Exercise ;
                    rdfs:range :DifficultyLevel ,
                               :TrainingsLevel ;
                    rdfs:comment "Schwierigkeitsstufe der Übung."@de ;
                    rdfs:label "hasDifficultyLevel"@en .


###  http://purl.org/PhysicalTherapy#hasFocusOn
:hasFocusOn rdf:type owl:ObjectProperty ;
            owl:inverseOf :isFocusOf ;
            rdfs:domain :Asana ;
            rdfs:range :TrainingsEffect ;
            rdfs:comment "Trainingseffekt, auf den die Yoga-Haltung besonders abzielt."@de ;
            rdfs:label "hasFocusOn"@en .


###  http://purl.org/PhysicalTherapy#hasInjury
:hasInjury rdf:type owl:ObjectProperty ;
           owl:inverseOf :isInjuryOf ;
           rdfs:domain :Patient ;
           rdfs:range :Injury ;
           rdfs:comment "Verletzung, die bei der Patientin oder dem Patienten vorliegt."@de ;
           rdfs:label "hasInjury"@en .


###  http://purl.org/PhysicalTherapy#hasLimbAlignment
:hasLimbAlignment rdf:type owl:ObjectProperty ;
                  rdfs:domain :Asana ;
                  rdfs:range :LimbAlignment ;
                  rdfs:comment "Ausrichtung von Armen, Beinen oder Rumpf bei einer Yoga-Haltung."@de ;
                  rdfs:label "hasLimbAlignment"@en .


###  http://purl.org/PhysicalTherapy#hasTrainingEffect
:hasTrainingEffect rdf:type owl:ObjectProperty ;
                   rdfs:domain :Exercise ;
                   rdfs:range :TrainingsEffect ;
                   rdfs:comment "Trainingseffekt, den die Übung erzielt."@de ;
                   rdfs:label "hasTrainingEffect"@en .


###  http://purl.org/PhysicalTherapy#hasTrainingsLevel
:hasTrainingsLevel rdf:type owl:ObjectProperty ;
                   rdfs:domain :Patient ;
                   rdfs:range :TrainingsLevel ;
                   rdfs:comment "Trainingsstand der Patientin oder des Patienten."@de ;
                   rdfs:label "hasTrainingsLevel"@en .


###  http://purl.org/PhysicalTherapy#improves
:improves rdf:type owl:ObjectProperty ;
          owl:inverseOf :isImprovedBy ;
          rdfs:domain :Asana ,
                      :Exercise ;
          rdfs:range :TrainingsEffect ;
          rdfs:comment "Trainingseffekt, der durch die Übung verbessert wird."@de ;
          rdfs:label "improves"@en .


###  http://purl.org/PhysicalTherapy#includesAsana
:includesAsana rdf:type owl:ObjectProperty ;
               rdfs:range :Asana ;
               rdfs:comment "Yoga-Haltung, die in einer Trainingseinheit enthalten ist."@de ;
               rdfs:label "includesAsana"@en .


###  http://purl.org/PhysicalTherapy#isContraindicationFor
:isContraindicationFor rdf:type owl:ObjectProperty ;
                       rdfs:comment "Übung, bei der dieses Ausschlusskriterium beachtet werden muss."@de ;
                       rdfs:label "isContraindicationFor"@en .


###  http://purl.org/PhysicalTherapy#isEngagedBy
:isEngagedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :BodyPart ;
             rdfs:range :Asana ;
             rdfs:comment "Übung, die das Körperteil beansprucht."@de ;
             rdfs:label "isEngagedBy"@en .


###  http://purl.org/PhysicalTherapy#isExaminedBy
:isExaminedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Joint ;
              rdfs:comment "Untersuchung oder Test, mit dem das Gelenk geprüft wird."@de ;
              rdfs:label "isExaminedBy"@en .


###  http://purl.org/PhysicalTherapy#isFocusOf
:isFocusOf rdf:type owl:ObjectProperty ;
           rdfs:domain :TrainingsEffect ;
           rdfs:range :Asana ;
           rdfs:comment "Übung, die diesen Trainingseffekt gezielt fördert."@de ;
           rdfs:label "isFocusOf"@en .


###  http://purl.org/PhysicalTherapy#isImprovedBy
:isImprovedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :TrainingsEffect ;
              rdfs:range :Asana ;
              rdfs:comment "Übung, die diesen Trainingseffekt verbessert."@de ;
              rdfs:label "isImprovedBy"@en .


###  http://purl.org/PhysicalTherapy#isInjuryOf
:isInjuryOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Injury ;
            rdfs:comment "Patientin oder Patient, die oder der diese Verletzung hat."@de ;
            rdfs:label "isInjuryOf"@en .


###  http://purl.org/PhysicalTherapy#isRehabilitatedBy
:isRehabilitatedBy rdf:type owl:ObjectProperty ;
                   owl:inverseOf :rehabilitates ;
                   rdfs:domain :Exercise ;
                   rdfs:range :BodyPart ;
                   rdfs:comment "Übung, die das Körperteil gezielt wiederherstellt."@de ;
                   rdfs:label "isRehabilitatedBy"@en .


###  http://purl.org/PhysicalTherapy#limb
:limb rdf:type owl:ObjectProperty ;
      rdfs:domain :LimbAlignment ;
      rdfs:range :Limb ;
      rdfs:comment "Körperglied (Arm oder Bein), auf das sich die Ausrichtung bezieht."@de ;
      rdfs:label "limb"@en .


###  http://purl.org/PhysicalTherapy#opens
:opens rdf:type owl:ObjectProperty ;
       rdfs:domain :Asana ;
       rdfs:range :BodyPart ;
       rdfs:comment "Körperteil, das durch die Yoga-Haltung geöffnet und gedehnt wird."@de ;
       rdfs:label "opens"@en .


###  http://purl.org/PhysicalTherapy#partOf
:partOf rdf:type owl:ObjectProperty ,
                 owl:TransitiveProperty ;
        rdfs:domain :BodyPart ;
        rdfs:range :BodyPart ;
        rdfs:comment "Übergeordnetes Körperteil, dem dieses Körperteil angehört."@de ;
        rdfs:label "partOf"@en .


###  http://purl.org/PhysicalTherapy#recommendedForInjury
:recommendedForInjury rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Exercise ;
                      rdfs:range :Injury ;
                      rdfs:comment "Verletzung, bei der diese Übung empfohlen wird."@de ;
                      rdfs:label "recommendedForInjury"@en .


###  http://purl.org/PhysicalTherapy#recommendsDifficultyLevel
:recommendsDifficultyLevel rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           rdfs:comment "Schwierigkeitsstufe, die für den jeweiligen Trainingsstand empfohlen wird."@de ;
                           rdfs:label "recommendsDifficultyLevel"@en .


###  http://purl.org/PhysicalTherapy#rehabilitates
:rehabilitates rdf:type owl:ObjectProperty ;
               rdfs:domain :Exercise ;
               rdfs:range :BodyPart ;
               rdfs:comment "Verknüpft eine Übung mit dem Körperteil (BodyPart), den sie therapeutisch rehabilitiert"@de ;
               rdfs:label "rehabilitates"@en .


###  http://purl.org/PhysicalTherapy#requiresEquipment
:requiresEquipment rdf:type owl:ObjectProperty ;
                   rdfs:domain :Exercise ;
                   rdfs:range :Equipment ;
                   rdfs:comment "Hilfsmittel, das für die Ausführung der Übung benötigt wird."@de ;
                   rdfs:label "requiresEquipment"@en .


###  http://purl.org/PhysicalTherapy#requiresImprovementOf
:requiresImprovementOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :Injury ;
                       rdfs:range :BodyPart ;
                       rdfs:comment "Körperteil, das bei dieser Verletzung verbessert oder wiederhergestellt werden soll."@de ;
                       rdfs:label "requiresImprovementOf"@en .


###  http://purl.org/PhysicalTherapy#severity
:severity rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasContraindication ;
          rdfs:domain :Contraindication ;
          rdfs:range :SeverityLevel ;
          rdfs:comment "Schweregrad, mit dem das Ausschlusskriterium ausgeprägt ist."@de ;
          rdfs:label "severity"@en .


###  http://purl.org/PhysicalTherapy#strengthens
:strengthens rdf:type owl:ObjectProperty ;
             rdfs:domain :Asana ;
             rdfs:range :BodyPart ;
             rdfs:comment "Körperteil, das durch die Übung gekräftigt wird."@de ;
             rdfs:label "strengthens"@en .


###  http://purl.org/PhysicalTherapy#stretches
:stretches rdf:type owl:ObjectProperty ;
           rdfs:domain :Asana ;
           rdfs:range :BodyPart ;
           rdfs:comment "Körperteil, das durch die Übung gedehnt wird."@de ;
           rdfs:label "stretches"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/PhysicalTherapy#Calorie
:Calorie rdf:type owl:DatatypeProperty .


###  http://purl.org/PhysicalTherapy#MET
:MET rdf:type owl:DatatypeProperty .


###  http://purl.org/PhysicalTherapy#angle
:angle rdf:type owl:DatatypeProperty ;
       rdfs:domain :LimbAlignment ;
       rdfs:range xsd:decimal ;
       rdfs:comment "Winkel in Grad, der die Stellung eines Gelenks oder Körperteils bei einer Übung beschreibt."@de ;
       rdfs:label "angle"@en .


###  http://purl.org/PhysicalTherapy#date
:date rdf:type owl:DatatypeProperty ;
      rdfs:range xsd:dateTime ;
      rdfs:comment "Datum, an dem ein Ereignis stattgefunden hat oder geplant ist."@de ;
      rdfs:label "date"@en .


###  http://purl.org/PhysicalTherapy#duration
:duration rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:int ;
          rdfs:comment "Zeitliche Dauer einer Trainingseinheit oder eines anderen Ereignisses."@de ;
          rdfs:label "duration"@en .


###  http://purl.org/PhysicalTherapy#fitnessLevelScore
:fitnessLevelScore rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Patient ;
                   rdfs:isDefinedBy "The Fitness Level Score (FLS) is the calculated fitness level of an user based on the sport activites (MET's), number of sessions per week and the session duration." ;
                   rdfs:label "fitnessLevelScore"@en .


###  http://purl.org/PhysicalTherapy#hasAge
:hasAge rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:integer ;
        rdfs:label "hasAge"@en .


###  http://purl.org/PhysicalTherapy#hasBMI
:hasBMI rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:decimal ;
        rdfs:label "hasBMI"@en .


###  http://purl.org/PhysicalTherapy#hasCommonMistake
:hasCommonMistake rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Exercise ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Häufige Fehler, die bei der Ausführung einer Übung auftreten."@de ;
                  rdfs:label "hasCommonMistake"@en .


###  http://purl.org/PhysicalTherapy#hasCorrectionGuidance
:hasCorrectionGuidance rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Exercise ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Hinweise, wie typische Fehler bei einer Übung korrigiert werden können."@de ;
                       rdfs:label "hasCorrectionGuidance"@en .


###  http://purl.org/PhysicalTherapy#hasDailyLifeAdvice
:hasDailyLifeAdvice rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :Injury ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Empfehlungen, wie gesündere Bewegungsmuster in den Alltag eingebaut werden können."@de ;
                    rdfs:label "hasDailyLifeAdvice"@en .


###  http://purl.org/PhysicalTherapy#hasDateOfOnset
:hasDateOfOnset rdf:type owl:DatatypeProperty ;
                rdfs:domain :Injury ;
                rdfs:range xsd:date ;
                rdfs:label "hasDateOfOnset"@en .


###  http://purl.org/PhysicalTherapy#hasDescription
:hasDescription rdf:type owl:DatatypeProperty ;
                rdfs:domain :Exercise ;
                rdfs:range xsd:string ;
                rdfs:comment "Kurze Beschreibung einer Übung mit Ziel und Wirkung."@de ;
                rdfs:label "hasDescription"@en .


###  http://purl.org/PhysicalTherapy#hasDuration
:hasDuration rdf:type owl:DatatypeProperty ;
             rdfs:domain :Exercise ;
             rdfs:range xsd:string ;
             rdfs:comment "Empfohlene Dauer, wie lange eine Übung ausgeführt werden soll."@de ;
             rdfs:label "hasDuration"@en .


###  http://purl.org/PhysicalTherapy#hasGender
:hasGender rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:label "hasGender"@en .


###  http://purl.org/PhysicalTherapy#hasHealthBenefit
:hasHealthBenefit rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:string ;
                  rdfs:label "hasHealthBenefit"@en .


###  http://purl.org/PhysicalTherapy#hasHeight
:hasHeight rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:decimal ;
           rdfs:label "hasHeight"@en .


###  http://purl.org/PhysicalTherapy#hasInstruction
:hasInstruction rdf:type owl:DatatypeProperty ;
                rdfs:domain :Exercise ;
                rdfs:range xsd:string ;
                rdfs:comment "Schritt-für-Schritt-Anleitung zur Durchführung einer Übung."@de ;
                rdfs:label "hasInstruction"@en .


###  http://purl.org/PhysicalTherapy#hasLifestyle
:hasLifestyle rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              rdfs:label "hasLifestyle"@en .


###  http://purl.org/PhysicalTherapy#hasMETScore
:hasMETScore rdf:type owl:DatatypeProperty ;
             rdfs:domain :Patient ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Intensitätswert einer Aktivität, ausgedrückt in metabolischen Äquivalenten."@de ;
             rdfs:label "hasMETScore"@en .


###  http://purl.org/PhysicalTherapy#hasPreparationTime
:hasPreparationTime rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:integer ;
                    rdfs:label "hasPreparationTime"@en .


###  http://purl.org/PhysicalTherapy#hasRiskFactor
:hasRiskFactor rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "hasRiskFactor"@en .


###  http://purl.org/PhysicalTherapy#hasSeverityScore
:hasSeverityScore rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Injury ;
                  rdfs:range xsd:decimal ;
                  rdfs:label "hasSeverityScore"@en .


###  http://purl.org/PhysicalTherapy#hasVASvalue
:hasVASvalue rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:decimal ;
             rdfs:label "hasVASvalue"@en .


###  http://purl.org/PhysicalTherapy#hasVideoUrl
:hasVideoUrl rdf:type owl:DatatypeProperty ;
             rdfs:domain :Exercise ;
             rdfs:range xsd:string .


###  http://purl.org/PhysicalTherapy#hasWeight
:hasWeight rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:decimal ;
           rdfs:label "hasWeight"@en .


###  http://purl.org/PhysicalTherapy#painOnMotion
:painOnMotion rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:boolean ;
              rdfs:label "painOnMotion"@en .


###  http://purl.org/PhysicalTherapy#rangeOfMotion
:rangeOfMotion rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:decimal ;
               rdfs:label "rangeOfMotion"@en .


###  http://purl.org/PhysicalTherapy#severityScore
:severityScore rdf:type owl:DatatypeProperty ;
               rdfs:domain :SeverityLevel ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Zahlenwert, der die Schwere eines Gesundheitsproblems beschreibt. Werte über 1,0 stehen für hohes Risiko, um 0,5 für mittleres Risiko und ab 0,2 für geringes Risiko."@de ;
               rdfs:isDefinedBy "The severity score is used for measurement for condition risk intensity"@en ;
               rdfs:label "severityScore"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/PhysicalTherapy#AnkleFrac
:AnkleFrac rdf:type owl:Class ;
           rdfs:subClassOf :Fracture ;
           rdfs:comment "Fraktur im Bereich des oberen Sprunggelenkes (Innen- und/oder Außenknöchel), meist durch Umknicken oder Verdrehen des Fußes verursacht."@de ;
           rdfs:label "AnkleFrac"@en .


###  http://purl.org/PhysicalTherapy#AnkleJointInjury
:AnkleJointInjury rdf:type owl:Class ;
                  rdfs:subClassOf :JointInjury ;
                  rdfs:comment "Verletzung des Sprunggelenks, häufig Bänderdehnung oder Bänderriss durch Umknicken des Fußes."@de ;
                  rdfs:label "AnkleJointInjury"@en .


###  http://purl.org/PhysicalTherapy#AnkleMuscleInjury
:AnkleMuscleInjury rdf:type owl:Class ;
                   rdfs:subClassOf :MuscleInjury ;
                   rdfs:comment "Muskelverletzung im Bereich des Sprunggelenks, etwa eine Muskelzerrung oder ein Muskelfaserriss."@de ;
                   rdfs:label "AnkleMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#ArmMuscleInjury
:ArmMuscleInjury rdf:type owl:Class ;
                 rdfs:subClassOf :MuscleInjury ;
                 rdfs:comment "Verletzung eines Armmuskels, typischerweise als Muskelzerrung, Muskelfaserriss oder Muskelriss."@de ;
                 rdfs:label "ArmMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#Asana
:Asana rdf:type owl:Class ;
       rdfs:subClassOf :Yoga ;
       rdfs:comment "Körperstellungen im Yoga, die bewusst eingenommen und gehalten werden, um Beweglichkeit, Kraft und Körperbeherrschung zu fördern."@de ;
       rdfs:label "Asana"@en .


###  http://purl.org/PhysicalTherapy#BackMuscleInjury
:BackMuscleInjury rdf:type owl:Class ;
                  rdfs:subClassOf :MuscleInjury ;
                  rdfs:comment "Verletzung der Rückenmuskulatur, meist Muskelzerrung oder -riss durch Überlastung oder Fehlhaltung."@de ;
                  rdfs:label "BackMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#BackPain
:BackPain rdf:type owl:Class ;
          rdfs:subClassOf :Injury ;
          rdfs:comment "Schmerzen im Bereich des Rückens bzw. der Wirbelsäule, die von Knochen, Muskeln, Nerven oder anderen Strukturen des Rückens ausgehen können."@de ;
          rdfs:label "BackPain"@en .


###  http://purl.org/PhysicalTherapy#BodyPart
:BodyPart rdf:type owl:Class ;
          rdfs:comment "Körperteile"@de ;
          rdfs:label "BodyPart"@en ,
                     "Körperteil"@de .


###  http://purl.org/PhysicalTherapy#Cardio
:Cardio rdf:type owl:Class ;
        rdfs:subClassOf :Exercise ;
        rdfs:comment "Aerobe Übung, die Herzfrequenz und Atmung erhöht, um die kardiovaskuläre Ausdauer zu verbessern."@de ;
        rdfs:label "Cardio"@en ,
                   "Kardio"@de .


###  http://purl.org/PhysicalTherapy#CervicalSpinePain
:CervicalSpinePain rdf:type owl:Class ;
                   rdfs:subClassOf :SpinePain ;
                   rdfs:comment "Schmerzen im Bereich der Halswirbelsäule, oft verspannungsbedingt oder durch degenerative Veränderungen."@de ;
                   rdfs:label "CervicalSpinePain"@en .


###  http://purl.org/PhysicalTherapy#Contraindication
:Contraindication rdf:type owl:Class ;
                  rdfs:subClassOf :ExerciseProperties ;
                  rdfs:comment "Bedingungen oder Ausschlusskriterien, bei denen eine Übung nicht empfohlen wird."@de ;
                  rdfs:label "Contraindication"@en ,
                             "Kontraindikationen"@de .


###  http://purl.org/PhysicalTherapy#Coordination
:Coordination rdf:type owl:Class ;
              rdfs:subClassOf :Exercise .


###  http://purl.org/PhysicalTherapy#CoreMuscleInjury
:CoreMuscleInjury rdf:type owl:Class ;
                  rdfs:subClassOf :MuscleInjury ;
                  rdfs:comment "Verletzung der Rumpfmuskulatur (Bauch- und untere Rückenmuskeln), etwa durch Überlastung oder Trauma."@de ;
                  rdfs:label "CoreMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#DailyRoutine
:DailyRoutine rdf:type owl:Class ;
              rdfs:comment "Schonung im Alltag"@de ;
              rdfs:label "DailyRoutine"@en ,
                         "Schonung im Alltag"@de .


###  http://purl.org/PhysicalTherapy#DifficultyLevel
:DifficultyLevel rdf:type owl:Class ;
                 rdfs:subClassOf :ExerciseProperties ;
                 rdfs:comment "Einstufung des Schwierigkeitsgrads einer Übung, die den Grad der körperlichen, koordinativen und konditionellen Anforderungen beschreibt."@de ;
                 rdfs:label "DifficultyLevel"@en ,
                            "Schwierigkeitsgrad"@de .


###  http://purl.org/PhysicalTherapy#ElbowFrac
:ElbowFrac rdf:type owl:Class ;
           rdfs:subClassOf :Fracture ;
           rdfs:comment "Bruch eines oder mehrerer Knochen, die das Ellenbogengelenk bilden."@de ;
           rdfs:label "ElbowFrac"@en .


###  http://purl.org/PhysicalTherapy#ElbowJointInjury
:ElbowJointInjury rdf:type owl:Class ;
                  rdfs:subClassOf :JointInjury ;
                  rdfs:comment "Verletzung des Ellenbogengelenks, etwa Tennisarm oder Bänderverletzung durch Überlastung."@de ;
                  rdfs:label "ElbowJointInjury"@en .


###  http://purl.org/PhysicalTherapy#Equipment
:Equipment rdf:type owl:Class ;
           rdfs:subClassOf :ExerciseProperties ;
           rdfs:comment "Trainingsgeräte und Hilfsmittel, die in Physiotherapie und Rehabilitation eingesetzt werden, um Übungen zu erleichtern oder Belastungen gezielt zu dosieren."@de ;
           rdfs:label "Equipment"@de ,
                      "Equipment"@en .


###  http://purl.org/PhysicalTherapy#Exercise
:Exercise rdf:type owl:Class ;
          rdfs:subClassOf owl:Thing ;
          rdfs:comment "Repräsentiert eine physiotherapeutische, sportliche oder mobilisierende Übung."@de ;
          rdfs:label "Exercise"@en ,
                     "Übung"@de .


###  http://purl.org/PhysicalTherapy#ExerciseProperties
:ExerciseProperties rdf:type owl:Class ;
                    rdfs:subClassOf owl:Thing ;
                    rdfs:comment "Eigenschaften und Merkmale, die eine Übung charakterisieren, etwa Schwierigkeitsgrad, betroffene Körperregionen oder benötigte Ausrüstung."@de ;
                    rdfs:label "ExerciseProperties"@en ,
                               "Übungseigenschaften"@de .


###  http://purl.org/PhysicalTherapy#FootFrac
:FootFrac rdf:type owl:Class ;
          rdfs:subClassOf :Fracture ;
          rdfs:comment "Bruch eines oder mehrerer Mittelfußknochen, häufig durch direkte Gewalteinwirkung oder als Stress-/Ermüdungsfraktur."@de ;
          rdfs:label "FootFrac"@en .


###  http://purl.org/PhysicalTherapy#Fracture
:Fracture rdf:type owl:Class ;
          rdfs:subClassOf :Injury ;
          rdfs:comment "Knochenbruch als vollständige oder unvollständige Unterbrechung des Knochens, die durch direkte Gewalteinwirkung, Sturz oder wiederholte Überlastung entstehen kann."@de ;
          rdfs:label "Fracture"@en .


###  http://purl.org/PhysicalTherapy#HandFrac
:HandFrac rdf:type owl:Class ;
          rdfs:subClassOf :Fracture ;
          rdfs:comment "Bruch eines oder mehrerer Handknochen."@de ;
          rdfs:label "HandFrac"@en .


###  http://purl.org/PhysicalTherapy#HipFrac
:HipFrac rdf:type owl:Class ;
         rdfs:subClassOf :Fracture ;
         rdfs:comment "Bruch des Oberschenkelhalses, meist durch Sturz auf die Hüfte, häufig bei älteren Menschen mit Osteoporose."@de ;
         rdfs:label "HipFrac"@en .


###  http://purl.org/PhysicalTherapy#HipJointInjury
:HipJointInjury rdf:type owl:Class ;
                rdfs:subClassOf :JointInjury ;
                rdfs:comment "Verletzung oder degenerative Erkrankung des Hüftgelenks wie eine Hüftarthrose."@de ;
                rdfs:label "HipJointInjury"@en .


###  http://purl.org/PhysicalTherapy#HipMuscleInjury
:HipMuscleInjury rdf:type owl:Class ;
                 rdfs:subClassOf :MuscleInjury ;
                 rdfs:comment "Verletzung der Hüftmuskulatur, zum Beispiel Zerrung des Hüftbeugers oder der Adduktoren."@de ;
                 rdfs:label "HipMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#Injury
:Injury rdf:type owl:Class ;
        rdfs:comment "Konkrete Verletzung des Patienten (Spezialisierung von Condition)"@de ;
        rdfs:label "Injury"@en ,
                   "Verletzung"@de .


###  http://purl.org/PhysicalTherapy#Joint
:Joint rdf:type owl:Class ;
       rdfs:subClassOf :BodyPart ;
       rdfs:comment "Gelenk des menschlichen Körpers; Oberklasse aller spezifischen Gelenke"@de ;
       rdfs:label "Gelenk"@de ,
                  "Joint"@en .


###  http://purl.org/PhysicalTherapy#JointInjury
:JointInjury rdf:type owl:Class ;
             rdfs:subClassOf :Injury ;
             rdfs:comment "Verletzungen oder Beschwerden im Gelenk Bereich"@de ;
             rdfs:label "JointInjury"@en .


###  http://purl.org/PhysicalTherapy#KneeFrac
:KneeFrac rdf:type owl:Class ;
          rdfs:subClassOf :Fracture ;
          rdfs:comment "Knochenbruch im Bereich des Kniegelenks, etwa der Kniescheibe oder des Schienbeinkopfes."@de ;
          rdfs:label "KneeFrac"@en .


###  http://purl.org/PhysicalTherapy#KneeJointInjury
:KneeJointInjury rdf:type owl:Class ;
                 rdfs:subClassOf :JointInjury ;
                 rdfs:comment "Verletzung des Kniegelenks, etwa Meniskusriss, Kreuzbandriss oder Seitenbandverletzung durch Verdrehung oder Stoßbelastung."@de ;
                 rdfs:label "KneeJointInjury"@en .


###  http://purl.org/PhysicalTherapy#Limb
:Limb rdf:type owl:Class ;
      rdfs:subClassOf :BodyPart ;
      rdfs:comment "Repräsentiert die Gliedmaßen des menschlichen Körpers."@de ;
      rdfs:label "Glied"@de ,
                 "Limb"@en .


###  http://purl.org/PhysicalTherapy#LimbAlignment
:LimbAlignment rdf:type owl:Class ;
               rdfs:subClassOf :ExerciseProperties ;
               rdfs:comment "Beschreibung der räumlichen Ausrichtung von Gliedmaßen in Bezug auf den Körper oder auf benachbarte Gelenke."@de ;
               rdfs:label "Extremitätenausrichtung"@de ,
                          "LimbAlignment"@en .


###  http://purl.org/PhysicalTherapy#LowerBackPain
:LowerBackPain rdf:type owl:Class ;
               rdfs:subClassOf :BackPain .


###  http://purl.org/PhysicalTherapy#LowerLegMuscleInjury
:LowerLegMuscleInjury rdf:type owl:Class ;
                      rdfs:subClassOf :MuscleInjury ;
                      rdfs:comment "Verletzung der Unterschenkelmuskulatur, häufig als Wadenkrampf, Zerrung oder Muskelfaserriss."@de ;
                      rdfs:label "LowerLegMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#LumbarSpinePain
:LumbarSpinePain rdf:type owl:Class ;
                 rdfs:subClassOf :SpinePain ;
                 rdfs:comment "Schmerzen in der Lendenwirbelsäule, oft als Lumbalgie oder LWS-Syndrom bezeichnet."@de ;
                 rdfs:label "LumbarSpinePain"@en .


###  http://purl.org/PhysicalTherapy#Mobilisation
:Mobilisation rdf:type owl:Class ;
              rdfs:subClassOf :Exercise ;
              rdfs:comment "Mobilization"@en ,
                           "Übungen zur Verbesserung der Beweglichkeit und Dehnfähigkeit"@de ;
              rdfs:label "Mobilisation"@de .


###  http://purl.org/PhysicalTherapy#Muscle
:Muscle rdf:type owl:Class ;
        rdfs:subClassOf :BodyPart ;
        rdfs:comment "Repräsentiert die Muskeln des menschlichen Körpers."@de ;
        rdfs:label "Muscle"@en ,
                   "Muskel"@de .


###  http://purl.org/PhysicalTherapy#MuscleInjury
:MuscleInjury rdf:type owl:Class ;
              rdfs:subClassOf :Injury ;
              rdfs:comment "Verletzungen oder Beschwerden von Muskeln oder Muskelgruppen"@de ;
              rdfs:label "MuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#NeckMuscleInjury
:NeckMuscleInjury rdf:type owl:Class ;
                  rdfs:subClassOf :MuscleInjury ;
                  rdfs:comment "Verletzung oder Verspannung der Hals- und Nackenmuskulatur, oft durch Fehlhaltung oder Überlastung."@de ;
                  rdfs:label "NeckMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#Patient
:Patient rdf:type owl:Class ;
         rdfs:comment "Diese Klasse repräsentiert einen Reha-Patienten, der die Physiotherapie in Anspruch nimmt"@de ;
         rdfs:label "Patient"@de ,
                    "Patient"@en .


###  http://purl.org/PhysicalTherapy#RecipeOfTheWeek
:RecipeOfTheWeek rdf:type owl:Class ;
                 rdfs:comment "Rezept der Woche" ;
                 rdfs:label "Rezept der Woche"@de .


###  http://purl.org/PhysicalTherapy#Relaxation
:Relaxation rdf:type owl:Class ;
            rdfs:subClassOf :Exercise .


###  http://purl.org/PhysicalTherapy#SeverityLevel
:SeverityLevel rdf:type owl:Class ;
               rdfs:subClassOf :ExerciseProperties ;
               rdfs:comment "Stufe zur Einstufung der Schwere eines Risikos oder Zustands, etwa in abgestuften Klassen wie niedrig, mittel und hoch."@de ;
               rdfs:label "Risiko Level"@de ,
                          "SeverityLevel"@en .


###  http://purl.org/PhysicalTherapy#ShoulderFrac
:ShoulderFrac rdf:type owl:Class ;
              rdfs:subClassOf :Fracture ;
              rdfs:comment "Bruch des körpernahen Oberarmknochens nahe dem Schultergelenk (Humeruskopffraktur), oft durch Sturz auf die Schulter oder den ausgestreckten Arm."@de ;
              rdfs:label "ShoulderFrac"@en .


###  http://purl.org/PhysicalTherapy#ShoulderJointInjury
:ShoulderJointInjury rdf:type owl:Class ;
                     rdfs:subClassOf :JointInjury ;
                     rdfs:comment "Verletzung des Schultergelenks, häufig Impingement-Syndrom oder Riss der Rotatorenmanschette."@de ;
                     rdfs:label "ShoulderJointInjury"@en .


###  http://purl.org/PhysicalTherapy#ShoulderMuscleInjury
:ShoulderMuscleInjury rdf:type owl:Class ;
                      rdfs:subClassOf :MuscleInjury ;
                      rdfs:comment "Verletzung der Schultermuskulatur, zum Beispiel der Rotatorenmanschette."@de ;
                      rdfs:label "ShoulderMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#SpineFrac
:SpineFrac rdf:type owl:Class ;
           rdfs:subClassOf :Fracture ;
           rdfs:comment "Bruch eines oder mehrerer Wirbelkörper der Wirbelsäule, oft durch Unfall, Osteoporose oder Tumoren verursacht."@de ;
           rdfs:label "SpineFrac"@en .


###  http://purl.org/PhysicalTherapy#SpineJointInjury
:SpineJointInjury rdf:type owl:Class ;
                  rdfs:subClassOf :JointInjury ;
                  rdfs:comment "Verletzung oder degenerative Erkrankung der Wirbelgelenke (Facettengelenke), oft als Facettensyndrom bezeichnet."@de ;
                  rdfs:label "SpineJointInjury"@en .


###  http://purl.org/PhysicalTherapy#SpinePain
:SpinePain rdf:type owl:Class ;
           rdfs:subClassOf :BackPain ;
           rdfs:comment "Schmerzen im Bereich der Wirbelsäule, ausgehend von Knochen, Muskeln, Nerven oder Bandscheiben."@de ;
           rdfs:label "SpinePain"@en .


###  http://purl.org/PhysicalTherapy#SportActivity
:SportActivity rdf:type owl:Class ;
               rdfs:comment "This class is about all kind of sport activities" ;
               rdfs:label "SportActivity"@en ,
                          "Sportaktivität"@de .


###  http://purl.org/PhysicalTherapy#Strength
:Strength rdf:type owl:Class ;
          rdfs:subClassOf :Exercise .


###  http://purl.org/PhysicalTherapy#Stretching
:Stretching rdf:type owl:Class ;
            rdfs:subClassOf :Exercise .


###  http://purl.org/PhysicalTherapy#TendonInjury
:TendonInjury rdf:type owl:Class ;
              rdfs:subClassOf :Injury ;
              rdfs:comment "Verletzungen oder Überlastungsbeschwerden von Sehnen."@de ;
              rdfs:label "TendonInjury"@en .


###  http://purl.org/PhysicalTherapy#ThighMuscleInjury
:ThighMuscleInjury rdf:type owl:Class ;
                   rdfs:subClassOf :MuscleInjury ;
                   rdfs:comment "Verletzung der Oberschenkelmuskulatur, etwa Hamstring- oder Quadrizepszerrung."@de ;
                   rdfs:label "ThighMuscleInjury"@en .


###  http://purl.org/PhysicalTherapy#ThoracicSpinePain
:ThoracicSpinePain rdf:type owl:Class ;
                   rdfs:subClassOf :SpinePain ;
                   rdfs:comment "Schmerzen in der Brustwirbelsäule (thorakale Dorsalgie oder BWS-Syndrom)."@de ;
                   rdfs:label "ThoracicSpinePain"@en .


###  http://purl.org/PhysicalTherapy#TrainingsEffect
:TrainingsEffect rdf:type owl:Class ;
                 rdfs:subClassOf :ExerciseProperties ;
                 rdfs:comment "Ziele oder Effekte einer Übung so wie Mobilität, Kraft, Stabilität oder Entspannung."@de ;
                 rdfs:label "Trainingeffect"@en ,
                            "Trainingseffekt"@de .


###  http://purl.org/PhysicalTherapy#TrainingsLevel
:TrainingsLevel rdf:type owl:Class ;
                rdfs:subClassOf :Patient ;
                rdfs:comment "Einstufung des sportlichen Leistungsstands einer Person, üblicherweise in Stufen wie Anfänger, Fortgeschritten und Profi."@de ,
                             "TrainingLevel"@en ;
                rdfs:label "Traininglevel"@en ,
                           "Trainingslevel"@de .


###  http://purl.org/PhysicalTherapy#UpperBackPain
:UpperBackPain rdf:type owl:Class ;
               rdfs:subClassOf :BackPain ;
               rdfs:comment "Schmerzen im oberen Rücken, im Bereich der Brustwirbelsäule zwischen den Schulterblättern."@de ;
               rdfs:label "UpperBackPain"@en .


###  http://purl.org/PhysicalTherapy#WristFrac
:WristFrac rdf:type owl:Class ;
           rdfs:subClassOf :Fracture ;
           rdfs:comment "Bruch der Speiche (Radius) nahe am Handgelenk, die häufigste Fraktur beim Menschen."@de ;
           rdfs:label "WristFrac"@en .


###  http://purl.org/PhysicalTherapy#WristJointInjury
:WristJointInjury rdf:type owl:Class ;
                  rdfs:subClassOf :JointInjury ;
                  rdfs:comment "Verletzung des Handgelenks, zum Beispiel Bänderdehnung, Bänderriss oder Karpaltunnelsyndrom."@de ;
                  rdfs:label "WristJointInjury"@en .


###  http://purl.org/PhysicalTherapy#Yoga
:Yoga rdf:type owl:Class ;
      rdfs:subClassOf :Exercise .


#################################################################
#    Individuals
#################################################################

###  http://purl.org/PhysicalTherapy#ACLTear
:ACLTear rdf:type owl:NamedIndividual ,
                  :KneeJointInjury ;
         :excludesExercise :Einbeinstand ,
                           :FerseZehenGang ,
                           :GleichgewichtInstabil ,
                           :JumpingJacks ,
                           :MountainClimber ,
                           :SitzenStehen ,
                           :Squads ,
                           :Wandsitzen ;
         :requiresImprovementOf :KneeJoint ;
         rdfs:comment "Riss des vorderen Kreuzbandes im Knie, häufig durch abrupte Dreh- oder Stoppbewegungen beim Sport."@de ;
         rdfs:label "ACLTear"@en ,
                    "Riss des vorderen Kreuzbandes"@de .


###  http://purl.org/PhysicalTherapy#Abs
:Abs rdf:type owl:NamedIndividual ,
              :Muscle ;
     :isEngagedBy :Bruecke ,
                  :DeadBug ,
                  :LegRaise ,
                  :MountainClimber ,
                  :Plank ,
                  :PushUps ,
                  :SitzenStehen ,
                  :Squads ;
     :partOf :Core ;
     rdfs:comment "Bauchmuskulatur, die den Rumpf stabilisiert und die Körpermitte kräftigt."@de ;
     rdfs:label "Abs"@en ,
                "Bauchmuskulatur"@de .


###  http://purl.org/PhysicalTherapy#AchillesTendinitis
:AchillesTendinitis rdf:type owl:NamedIndividual ,
                             :TendonInjury ;
                    rdfs:comment "Reizung oder Entzündung der Achillessehne, meist durch Überlastung beim Laufen oder Springen."@de ;
                    rdfs:label "AchillesTendinitis"@en ,
                               "Achillessehnenentzündung"@de .


###  http://purl.org/PhysicalTherapy#AcuteLowBackPain
:AcuteLowBackPain rdf:type owl:NamedIndividual ,
                           :LowerBackPain ;
                  :excludesExercise :LegRaise ,
                                    :MountainClimber ;
                  :requiresImprovementOf :LowerBack ,
                                         :SpineJoint ;
                  rdfs:comment "Plötzlich auftretende Schmerzen im Bereich der Lendenwirbelsäule, oft durch eine falsche Bewegung ausgelöst."@de ;
                  rdfs:label "AcuteLowBackPain"@en ,
                             "Akute Kreuzschmerzen"@de .


###  http://purl.org/PhysicalTherapy#Adductors
:Adductors rdf:type owl:NamedIndividual ,
                    :Muscle ;
           :isEngagedBy :SitzenStehen ,
                        :Squads ;
           :partOf :Thighs ;
           rdfs:comment "Adduktoren, die Muskelgruppe an der Innenseite des Oberschenkels."@de ;
           rdfs:label "Adductors"@en ,
                      "Adduktoren"@de .


###  http://purl.org/PhysicalTherapy#Advanced
:Advanced rdf:type owl:NamedIndividual ,
                   :DifficultyLevel ,
                   :TrainingsLevel ;
          :recommendsDifficultyLevel :Beginner ,
                                     :Intermediate ;
          rdfs:comment "Fortgeschrittenenstufe: geeignet für Geübte mit guter Körperbeherrschung und Ausdauer."@de ;
          rdfs:label "Advanced"@en ,
                     "Fortgeschritten"@de .


###  http://purl.org/PhysicalTherapy#AerobicDance
:AerobicDance rdf:type owl:NamedIndividual ,
                       :SportActivity ;
              :Calorie 500.0 ;
              :MET 7.0 ;
              rdfs:label "Aerobic-Tanz"@de ,
                         "AerobicDance"@en .


###  http://purl.org/PhysicalTherapy#AerobicStepping
:AerobicStepping rdf:type owl:NamedIndividual ,
                          :SportActivity ;
                 :Calorie 607.0 ;
                 :MET 8.5 ;
                 rdfs:label "AerobicStepping"@en ,
                            "Step-Aerobic"@de .


###  http://purl.org/PhysicalTherapy#AgeGroup
:AgeGroup rdf:type owl:NamedIndividual ,
                   :Patient ;
          rdfs:comment "Gruppe von Patienten, die durch gemeinsame Merkmale wie Alter oder Fitnessstand zusammengefasst werden."@de ;
          rdfs:label "AgeGroup"@en ,
                     "Altersgruppe"@de .


###  http://purl.org/PhysicalTherapy#Airplane
:Airplane rdf:type owl:NamedIndividual ,
                   :Asana ;
          :engagedBodyPart :Core ,
                           :Glutes ,
                           :Hamstrings ,
                           :Hip ,
                           :Psoas ,
                           :Quadriceps ;
          :hasBreathingGuidance :AirplaneInstruction ;
          :hasContraindication :Airplane_BalanceIssue ,
                               :Airplane_CoreIssue ,
                               :Airplane_HipIssue ,
                               :Airplane_KneeIssue ;
          :hasDifficultyLevel :Intermediate ;
          :hasFocusOn :Balance ;
          :hasLimbAlignment :AirplaneInstruction ,
                            :Airplane_Left_Arm ,
                            :Airplane_Left_Leg ,
                            :Airplane_Right_Arm ,
                            :Airplane_Right_Leg ,
                            :Airplane_Torso ;
          :improves :Balance ,
                    :Coordination ,
                    :Flexibility ,
                    :Focus ,
                    :Mobility ,
                    :Posture ,
                    :Stability ,
                    :Strength ;
          :strengthens :Arms ,
                       :Core ,
                       :Hip ,
                       :Legs ,
                       :Shoulders ;
          :stretches :Calves ,
                     :Hamstrings ,
                     :Quadriceps ;
          rdfs:comment "Dekasana" ;
          rdfs:isDefinedBy "A balancing pose that helps strengthen the legs and core while improving focus." ;
          rdfs:label "Airplane"@en ,
                     "Flugzeug"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :engagedBodyPart ;
   owl:annotatedTarget :Core ;
   rdfs:comment "The core is actively involved during the execution of Airplane."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :Airplane_HipIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of Airplane to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :Airplane_KneeIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of Airplane to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasDifficultyLevel ;
   owl:annotatedTarget :Intermediate ;
   rdfs:comment "Indicates that the difficulty level of Airplane is categorized as intermediate."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasFocusOn ;
   owl:annotatedTarget :Balance ;
   rdfs:comment "Airplane targets improvement in balance."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasLimbAlignment ;
   owl:annotatedTarget :AirplaneInstruction ;
   rdfs:comment "Keep your standing leg strong and firm, engage your core to maintain balance, and try to keep your hips square to the floor."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasLimbAlignment ;
   owl:annotatedTarget :Airplane_Left_Arm ;
   rdfs:comment "Defines the specific positioning of the limb for Airplane."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasLimbAlignment ;
   owl:annotatedTarget :Airplane_Left_Leg ;
   rdfs:comment "Defines the specific positioning of the limb for Airplane."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasLimbAlignment ;
   owl:annotatedTarget :Airplane_Right_Arm ;

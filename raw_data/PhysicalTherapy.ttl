###  http://purl.org/PhysicalTherapy#SealStretch
:SealStretch rdf:type owl:NamedIndividual ,
                      :Stretching ;
             :engagedBodyPart :Abs ,
                              :Chest ,
                              :Core ,
                              :Hip ,
                              :HipJoint ,
                              :LowerBack ,
                              :Psoas ,
                              :ShoulderJoint ,
                              :Spine ,
                              :SpineJoint ;
             :hasContraindication :LowerBackIssue ,
                                  :SpineIssue ;
             :hasDifficultyLevel :Intermediate ;
             :improves :Flexibility ,
                       :Mobility ,
                       :Posture ;
             :rehabilitates :Abs ,
                            :LowerBack ,
                            :SpineJoint ;
             :stretches :Core ,
                        :Psoas ;
             :hasCommonMistake "Die Schultern werden hochgezogen, die Ellenbogen werden durchgedrückt oder die Bewegung wird trotz Rückenschmerzen erzwungen." ;
             :hasCorrectionGuidance "Die Arme nur so weit strecken, wie es angenehm ist. Schultern tief halten und bei Druck im unteren Rücken die Höhe reduzieren." ;
             :hasDescription "Mobilisations- und Dehnübung für die vordere Rumpfseite und die Wirbelsäulenstreckung. Die Übung wird häufig zur sanften Extension der Wirbelsäule genutzt." ;
             :hasDuration "2 Min" ;
             :hasInstruction """1. In Bauchlage starten.
2. Hände neben oder leicht vor den Schultern aufstützen.
3. Den Oberkörper langsam anheben.
4. Das Becken bleibt möglichst am Boden.
5. Schultern weg von den Ohren halten.
6. Die Position kurz halten und ruhig atmen.
7. Langsam wieder absenken.""" ;
             rdfs:comment "Dehnübung für Brust und vordere Schulter, die typische Sitzhaltungen ausgleicht."@de ;
             rdfs:label "Robben-Dehnung"@de ,
                        "SealStretch"@en .


###  http://purl.org/PhysicalTherapy#SegmentaleWirbelsaeulenbeugung
:SegmentaleWirbelsaeulenbeugung rdf:type owl:NamedIndividual ,
                                         :Mobilisation ;
                                :engagedBodyPart :Spine ,
                                                 :UpperBack ;
                                :hasContraindication :SpineIssue ;
                                :hasDifficultyLevel :Intermediate ;
                                :improves :Flexibility ,
                                          :Mobility ,
                                          :Posture ;
                                :requiresEquipment :None ;
                                :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
                                :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
                                :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität." ;
                                :hasDuration "2 Min" ;
                                :hasInstruction """1. Aufrecht stehen.
2. Kopf und Brustwirbelsäule Wirbel für Wirbel einrollen.
3. Kurz halten.
4. Langsam wieder aufrichten.""" ;
                                rdfs:label "Segmental Spinal Flexion"@en ,
                                           "Segmentale Wirbelsäulenbeugung"@de .


###  http://purl.org/PhysicalTherapy#SeitlicheRumpfdehnung
:SeitlicheRumpfdehnung rdf:type owl:NamedIndividual ,
                                :Stretching ;
                       :engagedBodyPart :Back ,
                                        :Spine ;
                       :hasContraindication :SpineIssue ;
                       :hasDifficultyLevel :Beginner ;
                       :improves :Flexibility ,
                                 :Mobility ;
                       :requiresEquipment :None ;
                       :hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht." ;
                       :hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst." ;
                       :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken." ;
                       :hasDuration "1 Min" ;
                       :hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln.""" ;
                       rdfs:label "Seitliche Rumpfdehnung"@de ,
                                  "Side Bend Stretch"@en .


###  http://purl.org/PhysicalTherapy#Seitstuetz
:Seitstuetz rdf:type owl:NamedIndividual ,
                     :Strength ;
            :engagedBodyPart :Core ,
                             :LowerBack ;
            :hasContraindication :WristIssue ;
            :hasDifficultyLevel :Intermediate ;
            :improves :Posture ,
                      :Stability ,
                      :Strength ;
            :requiresEquipment :None ;
            :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
            :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
            :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf." ;
            :hasDuration "4 Min" ;
            :hasInstruction """1. Stützposition einnehmen.
2. Bauch und Gesäß anspannen.
3. Körper in einer stabilen Linie halten.
4. Ruhig atmen und kontrolliert lösen.""" ;
            rdfs:label "Seitstütz"@de ,
                       "Side Plank"@en .


###  http://purl.org/PhysicalTherapy#SelbstmassageDerHinterenSchulter
:SelbstmassageDerHinterenSchulter rdf:type owl:NamedIndividual ,
                                           :Relaxation ;

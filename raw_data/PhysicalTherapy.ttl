###  http://purl.org/PhysicalTherapy#SprainedAnkle
:SprainedAnkle rdf:type owl:NamedIndividual ,
                        :AnkleJointInjury ;
               :excludesExercise :Einbeinstand ,
                                 :FerseZehenGang ,
                                 :GleichgewichtInstabil ,
                                 :JumpingJacks ,
                                 :MountainClimber ,
                                 :StandingCalfStretch ,
                                 :Tree ,
                                 :Wadendehnung ,
                                 :Warrior2 ;
               :requiresImprovementOf :AnkleJoint ,
                                      :Balance ,
                                      :Stability ;
               :hasDailyLifeAdvice "Das Sprunggelenk in der akuten Phase nicht unnötig belasten." ;
               rdfs:comment "Verstauchung des Sprunggelenks durch Überdehnung oder Riss der Bänder nach einem Umknicken."@de ;

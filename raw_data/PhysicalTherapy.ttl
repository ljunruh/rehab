###  http://purl.org/PhysicalTherapy#Beckenkippen
:Beckenkippen rdf:type owl:NamedIndividual ,
                       :Mobilisation ;
              :engagedBodyPart :Hip ,
                               :Pelvic ;
              :hasContraindication :HipIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Flexibility ,
                        :Mobility ,
                        :Posture ;
              :requiresEquipment :None ;
              :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
              :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
              :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Hüfte mit Schwerpunkt auf mobilität." ;
              :hasDuration "2 Min" ;
              :hasInstruction """1. Rückenlage oder Stand einnehmen.
2. Bauch leicht anspannen.
3. Becken vor- und zurückkippen.
4. Bewegung klein und kontrolliert ausführen.""" ;
              rdfs:label "Beckenkippen"@de ,
                         "Pelvic Tilt"@en .


###  http://purl.org/PhysicalTherapy#BeckenkontrollUebung
:BeckenkontrollUebung rdf:type owl:NamedIndividual ,
                               :Coordination ;
                      :engagedBodyPart :Hip ,
                                       :Pelvic ;
                      :hasContraindication :HipIssue ;
                      :hasDifficultyLevel :Beginner ;
                      :improves :Coordination ,
                                :Mobility ,
                                :Stability ;
                      :requiresEquipment :None ;
                      :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten." ;
                      :hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze." ;
                      :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Hüfte." ;
                      :hasDuration "2 Min" ;
                      :hasInstruction """1. Ausgangsposition sicher einnehmen.
2. Bewegung langsam und kontrolliert ausführen.
3. Ruhig atmen.
4. Bei Schmerzen abbrechen.""" ;
                      rdfs:label "Beckenkontroll-Übung"@de ,
                                 "Pelvic Control Drill"@en .


###  http://purl.org/PhysicalTherapy#Beckenuhr
:Beckenuhr rdf:type owl:NamedIndividual ,
                    :Mobilisation ;
           :engagedBodyPart :Hip ,
                            :Pelvic ;
           :hasContraindication :HipIssue ;
           :hasDifficultyLevel :Beginner ;
           :improves :Flexibility ,
                     :Mobility ,
                     :Posture ;
           :requiresEquipment :None ;
           :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
           :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
           :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Hüfte mit Schwerpunkt auf mobilität." ;
           :hasDuration "2 Min" ;
           :hasInstruction """1. In Rückenlage die Beine aufstellen.
2. Das Becken wie auf einem Zifferblatt bewegen.
3. Nacheinander 12, 3, 6 und 9 Uhr ansteuern.
4. Kreise verbinden.""" ;
           rdfs:label "Beckenuhr"@de ,
                      "Pelvic Clock"@en .



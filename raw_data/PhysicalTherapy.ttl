###  http://purl.org/PhysicalTherapy#HueftbeugeMitGerademRueckenGoodMorning
:HueftbeugeMitGerademRueckenGoodMorning rdf:type owl:NamedIndividual ,
                                                 :Strength ;
                                        :engagedBodyPart :Hip ,
                                                         :Pelvic ;
                                        :hasContraindication :HipIssue ;
                                        :hasDifficultyLevel :Intermediate ;
                                        :improves :Posture ,
                                                  :Stability ,
                                                  :Strength ;
                                        :requiresEquipment :None ;
                                        :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
                                        :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
                                        :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Hüfte." ;
                                        :hasDuration "3 Min" ;
                                        :hasInstruction """1. Hüftbreit stehen.
2. Rücken neutral halten.
3. Hüfte nach hinten schieben.
4. Über Gesäß und hintere Kette aufrichten.""" ;
                                        rdfs:label "Good Morning (Bodyweight)"@en ,
                                                   "Hüftbeuge mit geradem Rücken (Good Morning)"@de .


###  http://purl.org/PhysicalTherapy#HueftbeugerDehnung
:HueftbeugerDehnung rdf:type owl:NamedIndividual ,
                             :Stretching ;
                    :engagedBodyPart :Hip ,
                                     :HipJoint ,
                                     :Knees ,
                                     :LowerBack ,
                                     :Psoas ,
                                     :Quadriceps ;
                    :hasContraindication :HipIssue ,
                                         :KneeIssue ;
                    :hasDifficultyLevel :Beginner ;
                    :improves :Flexibility ,
                              :Mobility ,
                              :Posture ;
                    :rehabilitates :HipJoint ;
                    :requiresEquipment :None ;
                    :stretches :Psoas ,
                               :Quadriceps ;
                    :hasCommonMistake "Das Becken wird stark nach vorne geschoben, der untere Rücken bildet ein Hohlkreuz oder der Oberkörper kippt weit nach vorne." ;
                    :hasCorrectionGuidance "Das Becken leicht nach hinten kippen und die Bauchmuskulatur sanft anspannen. Den Oberkörper aufrecht halten und nur so weit nach vorne gehen, bis eine angenehme Dehnung spürbar ist." ;
                    :hasDescription "Eine Dehnübung für die Hüftbeugemuskulatur. Sie kann die Beweglichkeit der Hüfte unterstützen und Spannungsgefühle reduzieren, die beispielsweise durch langes Sitzen entstehen." ;
                    :hasDuration "2 Min" ;
                    :hasInstruction """1. In einen halben Kniestand kommen, wobei ein Knie am Boden liegt.
2. Das vordere Bein ungefähr im rechten Winkel aufstellen.
3. Den Oberkörper aufrecht halten.
4. Das Becken leicht nach hinten kippen.
5. Das Becken langsam nach vorne verlagern, ohne ein Hohlkreuz zu bilden.
6. Die Dehnung an der Vorderseite der Hüfte des hinteren Beins wahrnehmen.
7. Die Position ruhig halten und gleichmäßig atmen.
8. Anschließend die Seite wechseln.""" ;
                    rdfs:comment "Dehnübung für die Hüftbeugemuskulatur an der Vorderseite der Hüfte."@de ;
                    rdfs:label "HipFlexorStretch"@en ,
                               "Hüftbeuger-Dehnung"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HueftbeugerDehnung ;
   owl:annotatedProperty :engagedBodyPart ;
   owl:annotatedTarget :Hip ;
   rdfs:comment "The hip is actively involved during the execution of HueftbeugerDehnung."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HueftbeugerDehnung ;
   owl:annotatedProperty :hasDifficultyLevel ;
   owl:annotatedTarget :Beginner ;

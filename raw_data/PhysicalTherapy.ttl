###  http://purl.org/PhysicalTherapy#HighLunge
:HighLunge rdf:type owl:NamedIndividual ,
                    :Asana ;
           :engagedBodyPart :Arms ,
                            :Glutes ,
                            :Hamstrings ,
                            :Hip ,
                            :Knees ,
                            :LowerBack ,
                            :Quadriceps ,
                            :Shoulders ,
                            :UpperBack ;
           :hasBreathingGuidance :HighLungeInstruction ;
           :hasContraindication :HighLunge_BalanceIssue ,
                                :HighLunge_HipIssue ,
                                :HighLunge_KneeIssue ,
                                :HighLunge_LowerBackIssue ;
           :hasDifficultyLevel :Beginner ;
           :hasFocusOn :Balance ;
           :hasLimbAlignment :HighLungeInstruction ,
                             :HighLungePose_Left_Arm ,
                             :HighLungePose_Left_Leg ,
                             :HighLungePose_Right_Arm ,
                             :HighLungePose_Right_Leg ,
                             :HighLungePose_Torso ;
           :improves :Balance ,
                     :Coordination ,
                     :Flexibility ,
                     :Focus ,
                     :Mobility ,
                     :Posture ,
                     :Stability ,
                     :Strength ;
           :opens :Hip ;
           :strengthens :Back ,
                        :Legs ;
           :stretches :Quadriceps ;
           rdfs:comment "Ashta Chandrasana" ;
           rdfs:isDefinedBy "A transitional standing pose that builds strength and stability." ;

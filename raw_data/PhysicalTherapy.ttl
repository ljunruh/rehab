###  http://purl.org/PhysicalTherapy#ProgressiveMuskelentspannung
:ProgressiveMuskelentspannung rdf:type owl:NamedIndividual ,
                                       :Relaxation ;
                              :engagedBodyPart :Abs ,
                                               :Core ;
                              :hasContraindication :SpineIssue ;
                              :hasDifficultyLevel :Beginner ;
                              :improves :Flexibility ,
                                        :Relaxation ;
                              :requiresEquipment :None ;
                              :hasCommonMistake "Die Muskeln werden zu stark angespannt, der Atem wird angehalten oder einzelne Körperbereiche werden ruckartig belastet." ;
                              :hasCorrectionGuidance "Nur mit leichter bis mittlerer Kraft anspannen. Schmerzhafte oder verletzte Körperbereiche auslassen. Während der gesamten Übung gleichmäßig atmen und zwischen Anspannung und Entspannung ausreichend Zeit lassen." ;
                              :hasDescription "Eine Entspannungsmethode, bei der verschiedene Muskelgruppen nacheinander bewusst angespannt und anschließend wieder gelöst werden. Dadurch kann der Unterschied zwischen Muskelanspannung und Entspannung deutlicher wahrgenommen werden." ;
                              :hasDuration "5 Min" ;
                              :hasInstruction """1. Eine bequeme Sitz- oder Liegeposition einnehmen.
2. Die Augen bei Bedarf schließen und ruhig weiteratmen.
3. Mit den Füßen beginnen und die Muskulatur für ungefähr fünf Sekunden sanft anspannen.
4. Die Spannung vollständig lösen und die Entspannung für mehrere Sekunden wahrnehmen.
5. Danach nacheinander Waden, Oberschenkel, Gesäß, Bauch, Hände, Arme, Schultern und Gesicht anspannen und wieder entspannen.
6. Während des Anspannens weiteratmen und nicht pressen.
7. Nach der letzten Muskelgruppe einige Atemzüge ruhig liegen oder sitzen bleiben.
8. Den Körper langsam wieder bewegen und die Übung beenden.""" ;
                              rdfs:comment "Entspannungsverfahren, bei dem Muskelgruppen nacheinander bewusst angespannt und wieder gelöst werden."@de ;
                              rdfs:label "Progressive Muskelentspannung"@de ,
                                         "ProgressiveMuscleRelaxation"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ProgressiveMuskelentspannung ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :SpineIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of ProgressiveMuskelentspannung to avoid strain or injury."
 ] .



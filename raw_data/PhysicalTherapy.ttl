###  http://purl.org/PhysicalTherapy#Bruecke
:Bruecke rdf:type owl:NamedIndividual ,
                  :Strength ;
         :engagedBodyPart :Glutes ,
                          :Hamstrings ,
                          :Hip ,
                          :LowerBack ;
         :hasContraindication :Bruecke_LowerBackIssue ;
         :hasDifficultyLevel :Intermediate ;
         :improves :Posture ,
                   :Stability ,
                   :Strength ;
         :rehabilitates :Spine ;
         :requiresEquipment :None ;
         :strengthens :Abs ,
                      :Glutes ,
                      :LowerBack ;
         :hasCommonMistake "Am häufigsten werden die Hüfte zu hoch gestreckt, der untere Rücken durchgedrückt und die Füße vom Boden abgehoben, wodurch die Gesäßmuskeln ausfallen und die Lendenwirbelsäule belastet wird."@de ;
         :hasCorrectionGuidance "Füße hüftbreit lassen, Fersen in den Boden drücken, Rippen nach unten ziehen und die Bewegung bewusst aus dem Gesäß statt aus dem Rücken initiieren, bis Ohr, Schulter, Hüfte und Knie eine Linie bilden."@de ;
         :hasDescription "Die Brücke ist eine Rückenlage-Übung, bei der du die Hüfte durch Anspannen des Gesäßes anhebst und so Gesäß, Beinrückseite und Rumpf stabilisierend trainierst."@de ;
         :hasInstruction """1. Rückenlage, Knie angewinkelt, Füße hüftbreit und flach auf dem Boden.
2. Arme entspannt seitlich am Körper ablegen, Handflächen nach oben.
3. Core aktivieren und den unteren Rücken sanft in den Boden drücken.
4. Gesäß fest anspannen und die Hüfte kontrolliert nach oben schieben.
5. Am oberen Punkt bilden Schulter, Hüfte und Knie eine Linie, Pobacken oben richtig zusammendrücken.
6. Position kurz halten, dann die Hüfte langsam und kontrolliert wieder absenken."""@de ;
         rdfs:label "Bruecke (Bridging)" .


###  http://purl.org/PhysicalTherapy#Bruecke_LowerBackIssue
:Bruecke_LowerBackIssue rdf:type owl:NamedIndividual ,
                                 :Contraindication ;
                        :forCondition :LowerBackIssue ;
                        :severity :MediumRisk ;
                        rdfs:label "Bruecke_LowerBackIssue" .


###  http://purl.org/PhysicalTherapy#BrustwirbelsaeulenRotation
:BrustwirbelsaeulenRotation rdf:type owl:NamedIndividual ,
                                     :MobilisationStretching ;
                            :engagedBodyPart :Core ,
                                             :LowerBack ,
                                             :Shoulders ,
                                             :Spine ,
                                             :SpineJoint ,
                                             :UpperBack ;
                            :hasContraindication :BrustwirbelsaeulenRotation_SpineIssue ;
                            :hasDifficultyLevel :Intermediate ;
                            :improves :Coordination ,
                                      :Flexibility ,
                                      :Mobility ;
                            :rehabilitates :SpineJoint ;
                            :requiresEquipment :None ;
                            :stretches :Core ,
                                       :UpperBack ;
                            :hasCommonMistake "Die Rotation erfolgt hauptsächlich aus dem unteren Rücken, das Becken dreht stark mit oder die Bewegung wird ruckartig ausgeführt." ;
                            :hasCorrectionGuidance "Das Becken stabil halten und die Bewegung bewusst aus der Brustwirbelsäule einleiten. Den Bewegungsumfang verkleinern, wenn die Lendenwirbelsäule ausweicht oder Schmerzen auftreten." ;
                            :hasDescription "Eine Mobilisationsübung für die Brustwirbelsäule und den oberen Rücken. Die kontrollierte Rotation kann die Beweglichkeit des Oberkörpers verbessern und Spannungen in der Schulterblatt- und Rückenregion reduzieren." ;
                            :hasInstruction """1. Aufrecht sitzen oder in Seitenlage eine stabile Ausgangsposition einnehmen.
2. Die Wirbelsäule lang halten und die Schultern entspannen.
3. Die Arme vor dem Körper positionieren.
4. Einen Arm langsam nach hinten führen und den Oberkörper mitdrehen.
5. Das Becken möglichst ruhig halten.
6. Der Bewegung mit dem Blick folgen.
7. Die Endposition kurz halten.
8. Langsam in die Ausgangsposition zurückkehren und die andere Seite ausführen.""" ;
                            rdfs:label "BrustwirbelsaeulenRotation" .



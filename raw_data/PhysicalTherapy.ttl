###  http://purl.org/PhysicalTherapy#LatissimusMassageMitDerFaszienrolle
:LatissimusMassageMitDerFaszienrolle rdf:type owl:NamedIndividual ,
                                              :Relaxation ;
                                     :engagedBodyPart :Shoulders ,
                                                      :UpperBack ;
                                     :hasContraindication :ShoulderIssue ;
                                     :hasDifficultyLevel :Intermediate ;
                                     :improves :Mobility ,
                                               :Relaxation ;
                                     :requiresEquipment :Faszienrolle ;
                                     :hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke." ;
                                     :hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus." ;
                                     :hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Oberer Rücken." ;
                                     :hasDuration "4 Min" ;
                                     :hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen.""" ;
                                     rdfs:label "Latissimus Foam Rolling"@en ,
                                                "Latissimus-Massage mit der Faszienrolle"@de .



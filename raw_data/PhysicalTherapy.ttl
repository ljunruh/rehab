###  http://purl.org/PhysicalTherapy#EinarmigerFarmerSWalk
:EinarmigerFarmerSWalk rdf:type owl:NamedIndividual ,
                                :Coordination ;
                       :engagedBodyPart :Back ,
                                        :Core ,
                                        :Legs ,
                                        :Shoulders ;
                       :hasContraindication :BalanceIssue ;
                       :hasDifficultyLevel :Advanced ;
                       :improves :Balance ,
                                 :Coordination ,
                                 :Stability ;
                       :requiresEquipment :Dumble ;
                       :hasCommonMistake "Das Gleichgewicht durch hektische Ausgleichsbewegungen verlieren, statt ruhig gegenzusteuern." ;
                       :hasCorrectionGuidance "Die Bewegung verlangsamen, einen festen Punkt fixieren und bei Bedarf eine Wand oder einen Stuhl als Stütze nutzen." ;
                       :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf." ;
                       :hasDuration "3 Min" ;
                       :hasInstruction """1. Gewicht sicher aufnehmen.
2. Aufrecht stehen.
3. Mit stabilem Rumpf kontrolliert gehen.
4. Gewicht sicher absetzen.""" ;
                       rdfs:label "Einarmiger Farmer Laufen"@de ,
                                  "Single Arm Farmer Carry"@en .


###  http://purl.org/PhysicalTherapy#Einbeinstand
:Einbeinstand rdf:type owl:NamedIndividual ,
                       :Coordination ;
              :engagedBodyPart :AnkleJoint ,
                               :Ankles ,
                               :KneeJoint ,
                               :Knees ;
              :hasContraindication :AnkleIssue ,
                                   :BalanceIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Balance ,
                        :Coordination ,
                        :Focus ,
                        :Stability ;
              :requiresEquipment :None ;
              :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten." ;
              :hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze." ;
              :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Beine." ;
              :hasDuration "2 Min" ;
              :hasInstruction """1. Aufrecht mit hüftbreitem Stand auf einer stabilen, flachen Unterlage stehen.
2. Das Standbein leicht beugen, das Knie dabei weich halten und nicht durchdrücken.
3. Den Rumpf aufrichten, Schulterblätter nach unten ziehen, Blick auf einen festen Punkt vorne richten.
4. Das andere Bein langsam vom Boden abheben, das Knie leicht gebeugt.
5. Die Position 20 bis 30 Sekunden halten und dabei ruhig weiteratmen.
6. Das Bein kontrolliert wieder abstellen und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen, bei Bedarf anfangs mit Fingerkontakt an einer Stuhllehne oder Wand.""" ;
              rdfs:comment "Balanceübung, bei der auf einem Bein gestanden wird, um Stabilität und Beinkontrolle zu trainieren."@de ;
              rdfs:label "Einbeinstand"@de ,
                         "SingleLegStand"@en .



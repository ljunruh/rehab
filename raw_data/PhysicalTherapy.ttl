###  http://purl.org/PhysicalTherapy#WHeben
:WHeben rdf:type owl:NamedIndividual ,
                 :Strength ;
        :engagedBodyPart :Shoulders ,
                         :UpperBack ;
        :hasContraindication :ShoulderIssue ;
        :hasDifficultyLevel :Intermediate ;
        :improves :Posture ,
                  :Stability ,
                  :Strength ;
        :requiresEquipment :None ;
        :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
        :hasCorrectionGuidance "Führe die Bewegung langsamer aus und halte deine Wirbelsäule in einer neutralen Position. Steigere die Belastung erst, wenn du die Übung sauber und kontrolliert ausführen kannst." ;
        :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern." ;
        :hasDuration "4 Min" ;
        :hasInstruction """Lege dich auf den Bauch oder beuge deinen Oberkörper leicht nach vorne.

* Ziehe deine Schulterblätter sanft nach hinten und unten.
* Hebe deine Arme langsam in der vorgegebenen Position an.
* Senke die Arme anschließend kontrolliert wieder ab.""" ;
        rdfs:label "W Raise"@en ,
                   "W-Heben"@de .


###  http://purl.org/PhysicalTherapy#Wadendehnung
:Wadendehnung rdf:type owl:NamedIndividual ,
                       :Stretching ;
              :engagedBodyPart :AnkleJoint ,
                               :Ankles ,
                               :Calves ,
                               :Legs ;
              :hasContraindication :AnkleIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Flexibility ,
                        :Mobility ;
              :rehabilitates :AnkleJoint ;
              :requiresEquipment :Dumble ;
              :strengthens :Calves ;
              :hasCommonMistake "Die hintere Ferse hebt sich vom Boden ab, der Fuß dreht nach außen oder das hintere Knie wird unkontrolliert gebeugt." ;
              :hasCorrectionGuidance "Die Ferse bewusst in Richtung Boden drücken und den Fuß gerade ausrichten. Den Abstand zur Wand verkleinern, wenn die Ferse nicht unten bleibt oder die Dehnung zu intensiv ist." ;
              :hasDescription "Eine Dehnübung für die Wadenmuskulatur und den Bereich des Sprunggelenks. Sie kann die Beweglichkeit des Fußgelenks unterstützen und Spannungen in der Wade reduzieren." ;
              :hasDuration "2 Min" ;
              :hasInstruction """1. Vor eine Wand stellen und beide Hände an der Wand abstützen.
2. Ein Bein nach hinten setzen.
3. Die hintere Ferse am Boden lassen.
4. Die Fußspitze des hinteren Beins nach vorne ausrichten.
5. Das vordere Knie leicht beugen.
6. Das Becken langsam nach vorne verlagern.
7. Die Dehnung in der Wade des hinteren Beins halten.
8. Ruhig atmen und anschließend die Seite wechseln.""" ;
              rdfs:comment "Dehnübung für die Wadenmuskulatur, oft an einer Wand oder Stufe ausgeführt."@de ;
              rdfs:label "CalfStretch"@en ,
                         "Wadendehnung"@de .



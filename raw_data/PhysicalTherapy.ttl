###  http://purl.org/PhysicalTherapy#DeadBug
:DeadBug rdf:type owl:NamedIndividual ,
                  :Strength ;
         :engagedBodyPart :Abs ,
                          :Core ,
                          :Hip ,
                          :LowerBack ;
         :hasContraindication :AcuteLowBackPain ,
                              :DeadBug_LowerBackIssue ;
         :hasDifficultyLevel :Intermediate ;
         :improves :Balance ,
                   :Coordination ,
                   :Posture ,
                   :Stability ,
                   :Strength ;
         :rehabilitates :Core ,
                        :LowerBack ;
         :requiresEquipment :None ;
         :strengthens :Abs ,
                      :Obliques ;
         :hasCommonMistake "Arm oder Bein werden auf dem Boden abgelegt." ,
                           "Der Kopf wird angehoben und der Nacken unnötig angespannt." ,
                           "Der untere Rücken hebt sich vom Boden ab und bildet ein Hohlkreuz." ,
                           "Die Bauchspannung wird während der Bewegung verloren." ;
         :hasCorrectionGuidance "Bei Verlust der Rumpfspannung den Bewegungsumfang verkleinern." ,
                                "Den unteren Rücken während der gesamten Bewegung sanft gegen den Boden drücken." ,
                                "Die Bewegung langsam und kontrolliert ausführen." ,
                                "Kopf und Schultern entspannt auf dem Boden lassen." ,
                                "Nur so weit strecken, wie die neutrale Rückenposition gehalten werden kann." ;
         :hasDescription "Der Dead Bug aktiviert vor allem die tiefe Rumpfmuskulatur, insbesondere den Musculus transversus abdominis. Die Übung unterstützt die Stabilisierung von Wirbelsäule und Becken und trainiert die koordinierte Bewegung von Armen und Beinen bei kontrollierter Rumpfspannung." ;
         :hasInstruction """1. Auf den Rücken legen und beide Arme senkrecht zur Decke strecken.
2. Hüfte und Knie ungefähr im 90-Grad-Winkel beugen und die Füße vom Boden anheben.
3. Den unteren Rücken kontrolliert auf dem Boden halten und die Bauchmuskulatur anspannen.
4. Einen Arm langsam hinter den Kopf führen und gleichzeitig das gegenüberliegende Bein in Richtung Boden strecken.
5. Arm und Bein nicht ablegen, sondern einige Zentimeter über dem Boden halten.
6. Die Position für ein bis zwei Atemzüge halten.
7. Arm und Bein langsam in die Ausgangsposition zurückführen.
8. Die Bewegung mit dem anderen Arm und dem anderen Bein wiederholen.""" ;
         rdfs:label "Dead Bug" .


###  http://purl.org/PhysicalTherapy#DeadBug_LowerBackIssue
:DeadBug_LowerBackIssue rdf:type owl:NamedIndividual ,
                                 :Contraindication ;
                        :forCondition :LowerBackIssue ;
                        :severity :MediumRisk ;
                        rdfs:label "DeadBug_LowerBackIssue" .


###  http://purl.org/PhysicalTherapy#Deadlift
:Deadlift rdf:type owl:NamedIndividual ,
                   :Strength ;
          :engagedBodyPart :Abs ,
                           :Glutes ,
                           :Hamstrings ,
                           :HipJoint ,
                           :Knees ,
                           :LowerBack ,
                           :SpineJoint ;
          :hasContraindication :AcuteLowBackPain ,
                               :HipFracture ,
                               :LumbarDiscHerniation ,
                               :Sciatica ,
                               :SpineIssue ;
          :hasDifficultyLevel :Advanced ;
          :improves :Posture ,
                    :Stability ,
                    :Strength ;
          :rehabilitates :Glutes ,
                         :Hamstrings ,
                         :HipJoint ;
          :requiresEquipment :Dumble ;
          :strengthens :Abs ,
                       :Glutes ,
                       :Hamstrings ,
                       :LowerBack ;
          :hasCommonMistake "Der Rücken rundet sich, die Knie schieben zu weit nach vorne oder das Gewicht wird aus dem unteren Rücken gehoben." ;
          :hasCorrectionGuidance "Die Bewegung aus der Hüfte einleiten und die Wirbelsäule neutral halten. Mit wenig oder keinem Zusatzgewicht beginnen und den Bewegungsumfang reduzieren." ;
          :hasDescription "Kräftigungsübung für hintere Oberschenkelmuskulatur, Gesäß, Rückenstrecker und Rumpf. Der Fokus liegt auf der Hüftbeugebewegung und einer stabilen Wirbelsäule." ;
          :hasInstruction """1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken kontrolliert nach hinten schieben.
4. Den Rücken gerade halten.
5. Den Oberkörper nach vorne neigen, ohne den Rücken zu runden.
6. Über Gesäß und hintere Oberschenkel wieder aufrichten.
7. Die Bewegung langsam wiederholen.""" .



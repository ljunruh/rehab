###  http://purl.org/PhysicalTherapy#LegRaise
:LegRaise rdf:type owl:NamedIndividual ,
                   :Strength ;
          :engagedBodyPart :Abs ,
                           :Hip ,
                           :HipJoint ,
                           :LowerBack ,
                           :Quadriceps ,
                           :Spine ,
                           :SpineJoint ;
          :hasContraindication :HipIssue ,
                               :LowerBackIssue ,
                               :SpineIssue ;
          :hasDifficultyLevel :Intermediate ;
          :improves :Focus ,
                    :Stability ,
                    :Strength ;
          :rehabilitates :Abs ,
                         :HipJoint ;
          :requiresEquipment :None ;
          :strengthens :Abs ,
                       :Obliques ,
                       :Quadriceps ;
          :hasCommonMistake "Der untere Rücken hebt stark vom Boden ab, die Beine werden schwungvoll bewegt oder der Nacken verspannt." ;
          :hasCorrectionGuidance "Den Bewegungsumfang verkleinern oder nur ein Bein bewegen. Bauchspannung halten und die Bewegung langsam ausführen." ;
          :hasDescription "Kräftigungsübung für Bauchmuskulatur und Hüftbeuger. Die Übung trainiert die Kontrolle der Beckenposition und die Stabilität des unteren Rückens." ;
          :hasDuration "3 Min" ;
          :hasInstruction """1. Auf den Rücken legen.
2. Beine ausstrecken oder leicht beugen.
3. Den unteren Rücken kontrolliert Richtung Boden stabilisieren.
4. Ein Bein oder beide Beine langsam anheben.
5. Die Beine kontrolliert wieder absenken.
6. Nur so tief gehen, wie der Rücken stabil bleibt.
7. Gleichmäßig atmen.""" ;
          rdfs:comment "Übung im Liegen, bei der die Beine angehoben werden, um die vordere Rumpf- und Hüftmuskulatur zu kräftigen."@de ;
          rdfs:label "Beinheben"@de ,
                     "LegRaise"@en .



         rdfs:label "Sitting"@en ,
                    "Sitzen"@de .


###  http://purl.org/PhysicalTherapy#SitzenStehen
:SitzenStehen rdf:type owl:NamedIndividual ,
                       :Coordination ;
              :engagedBodyPart :Core ,
                               :Glutes ,
                               :KneeJoint ,
                               :Knees ,
                               :Quads ,
                               :Thighs ;
              :hasContraindication :KneeIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Balance ,
                        :Coordination ,
                        :Mobility ,
                        :Stability ,
                        :Strength ;
              :hasDuration "3 Min" ;
              :hasInstruction """1. Aufrecht auf einen stabilen Stuhl ohne Armlehne setzen, Füße hüftbreit und flach auf dem Boden.
2. Die Arme vor der Brust verschränken, um den Einsatz der Hände auszuschließen.
3. Den Oberkörper leicht nach vorne lehnen, die Füße fest in den Boden drücken.
4. Mit kontrolliertem Tempo aus dem Sitz aufstehen, bis die Beine vollständig gestreckt sind.
5. Kurz aufrecht stehen bleiben, dann langsam und gleichmäßig wieder hinsetzen.
6. Die Knie während der gesamten Bewegung in Richtung Fußspitzen halten.
7. 8 bis 12 Wiederholungen als ein Satz durchführen, insgesamt drei Sätze mit etwa einer Minute Pause.""" ;
              rdfs:comment "Übung, bei der aus dem Sitzen ohne Hilfe der Hände aufgestanden wird, um Bein- und Rumpfkraft zu trainieren."@de ;
              rdfs:label "Hinsetzen-Aufstehen"@de ,
                         "SitToStand"@en .



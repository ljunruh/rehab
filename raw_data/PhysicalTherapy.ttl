 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :hasLimbAlignment ;
   owl:annotatedTarget :Airplane_Torso ;
   rdfs:comment "Defines the specific positioning of the limb for Airplane."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :engagedBodyPart ;
   owl:annotatedTarget :Glutes ;
   rdfs:comment "The glutes is actively involved during the execution of Airplane."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Airplane ;
   owl:annotatedProperty :improves ;

###  http://purl.org/PhysicalTherapy#StandingPelvicTilts
:StandingPelvicTilts rdf:type owl:NamedIndividual ,
                              :Mobilisation ;
                     :engagedBodyPart :Abs ,
                                      :Glutes ,
                                      :HipJoint ,
                                      :LowerBack ,
                                      :SpineJoint ;
                     :hasContraindication :HipIssue ,
                                          :SpineIssue ;
                     :hasDifficultyLevel :Beginner ;
                     :improves :Mobility ,
                               :Posture ,
                               :Stability ;
                     :rehabilitates :HipJoint ,
                                    :LowerBack ,
                                    :SpineJoint ;
                     :requiresEquipment :None ;
                     :hasCommonMistake "Die Bewegung wird aus den Knien oder dem Oberkörper gemacht, statt aus dem Becken. Der Rücken wird stark überstreckt." ;
                     :hasCorrectionGuidance "Die Bewegung klein halten und bewusst aus dem Becken steuern. Bauch- und Gesäßmuskulatur leicht aktivieren." ;
                     :hasDescription "Kontrollübung für Beckenposition und unteren Rücken. Sie verbessert die Wahrnehmung von Beckenkippung und kann helfen, die Lendenwirbelsäule besser zu kontrollieren." ;
                     :hasDuration "2 Min" ;
                     :hasInstruction """1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken langsam nach vorne kippen.
4. Danach das Becken langsam nach hinten kippen.
5. Die Bewegung klein und kontrolliert ausführen.
6. Den Oberkörper möglichst ruhig halten.
7. Mehrere Wiederholungen langsam durchführen.""" ;
                     rdfs:comment "Sanfte Übung im Stehen, die das Becken kippt und die Lendenwirbelsäule mobilisiert."@de ;
                     rdfs:label "Beckenkippen im Stehen"@de ,
                                "StandingPelvicTilts"@en .



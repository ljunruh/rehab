###  http://purl.org/PhysicalTherapy#StandingBackbend
:StandingBackbend rdf:type owl:NamedIndividual ,
                           :Asana ;
                  :engagedBodyPart :Back ,
                                   :Chest ,
                                   :LowerBack ,
                                   :Neck ,
                                   :Psoas ,
                                   :UpperBack ;
                  :hasBreathingGuidance :StandingBackbendInstruction ;
                  :hasContraindication :StandingBackBend_LowerBackIssue ,
                                       :StandingBackBend_NeckIssue ,
                                       :StandingBackBend_ShoulderIssue ,
                                       :StandingBackBend_SpineIssue ;
                  :hasDifficultyLevel :Advanced ;
                  :hasFocusOn :Flexibility ;
                  :hasLimbAlignment :StandingBackbendInstruction ,
                                    :StandingBackbend_Left_Arm ,
                                    :StandingBackbend_Left_Leg ,
                                    :StandingBackbend_Right_Arm ,
                                    :StandingBackbend_Right_Leg ,
                                    :StandingBackbend_Torso ;
                  :improves :Balance ,
                            :Coordination ,
                            :Flexibility ,
                            :Focus ,
                            :Mobility ,
                            :Posture ,
                            :Relaxation ,
                            :Stability ;
                  :opens :Chest ,
                         :Shoulders ;
                  :rehabilitates :Shoulders ;
                  :strengthens :Back ;
                  :stretches :Back ,
                             :Core ,
                             :Hip ;
                  :hasCommonMistake "Das ruckartige Nach-hinten-Werfen des Kopfes mit Nackenkompression gilt es zu vermeiden, das Überstrecken nur im unteren Rücken (Hohlkreuz), das Hochziehen der Schultern, das Anwinkeln der Knie und ein schlaffer Bauch."@de ;
                  :hasCorrectionGuidance "Zur Korrektur das Kinn Richtung Mitte der Schlüsselbein ziehen, den Hinterkopf lang nach hinten führen, das Brustbein aktiv heben, das Becken nach vorn schieben und den Rumpf sowie die Beine durchgehend angespannt halten, sodass die Biegung gleichmäßig über die Brustwirbelsäule verteilt wird."@de ;
                  :hasDescription "Die Standing Back Bend ist eine stehende Rückbeuge, die Brust und Körpervorderseite öffnet, die Wirbelsäule mobilisiert und gleichzeitig Rumpf, Gesäß und Beine aktiviert."@de ;
                  :hasInstruction """1. Stell dich hüftbreit und aufrecht hin, die Hände an die Hüften oder den unteren Rücken.
2. Aktivier den Core, die Oberschenkel und das Gesäß, und strecke die Wirbelsäule nach oben.
3. Atme ein, heb das Brustbein an und zieh die Schultern bewusst nach unten und zurück.
4. Schieb das Becken leicht nach vorn und lehn dich dann kontrolliert aus der Brustwirbelsäule nach hinten.
5. Lass den Kopf nur locker folgen und halt den Nacken lang, statt ihn ruckartig nach hinten zu werfen.
6. Bleib für einige ruhige Atemzüge in der Position und halt Spannung im Bauch und in den Beinen.
7. Spann den Core an und kehr Wirbel für Wirbel langsam in den aufrechten Stand zurück."""@de ;
                  rdfs:comment "Tittibhasana B" ;
                  rdfs:isDefinedBy "A gentle backbend that helps improve spinal flexibility." ;
                  rdfs:label "StandingBackBend" .


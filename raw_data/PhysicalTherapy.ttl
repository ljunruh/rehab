###  http://purl.org/PhysicalTherapy#TrapezmuskelDehnung
:TrapezmuskelDehnung rdf:type owl:NamedIndividual ,
                              :Stretching ;
                     :engagedBodyPart :Neck ,
                                      :Shoulders ;
                     :hasContraindication :ShoulderIssue ;
                     :hasDifficultyLevel :Beginner ;
                     :improves :Flexibility ,
                               :Mobility ;
                     :requiresEquipment :None ;
                     :hasCommonMistake "Federn, die Luft anhalten oder bis in einen spürbaren Schmerz hinein dehnen." ;
                     :hasCorrectionGuidance "Ruhig weiteratmen und die Position nur bis zu einem deutlichen, aber angenehmen Ziehen halten." ;
                     :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Nacken." ;
                     :hasDuration "1 Min" ;
                     :hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln.""" ;
                     rdfs:label "Trapezmuskel-Dehnung"@de ,
                                "Upper Trapezius Stretch"@en .



###  http://purl.org/PhysicalTherapy#RotatorenmanschettenMassageMitBall
:RotatorenmanschettenMassageMitBall rdf:type owl:NamedIndividual ,
                                             :Relaxation ;
                                    :engagedBodyPart :Back ,
                                                     :Spine ;
                                    :hasContraindication :SpineIssue ;
                                    :hasDifficultyLevel :Advanced ;
                                    :improves :Mobility ,
                                              :Relaxation ;
                                    :requiresEquipment :Ball ,
                                                       :Erhöhung ;
                                    :hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke." ;
                                    :hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus." ;
                                    :hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Rücken." ;
                                    :hasDuration "3 Min" ;
                                    :hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen.""" ;
                                    rdfs:label "Rotator Cuff Ball Release"@en ,
                                               "Rotatorenmanschetten-Massage mit Ball"@de .


###  http://purl.org/PhysicalTherapy#RudernMitTheraband
:RudernMitTheraband rdf:type owl:NamedIndividual ,
                             :Strength ;
                    :engagedBodyPart :Back ,
                                     :Spine ;
                    :hasContraindication :SpineIssue ;
                    :hasDifficultyLevel :Beginner ;

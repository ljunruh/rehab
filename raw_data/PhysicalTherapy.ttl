###  http://purl.org/PhysicalTherapy#Kastenatmung4444Atmung
:Kastenatmung4444Atmung rdf:type owl:NamedIndividual ,
                                 :Relaxation ;
                        :engagedBodyPart :Back ,
                                         :Core ;
                        :hasContraindication :RespiratoryIssue ;
                        :hasDifficultyLevel :Beginner ;
                        :improves :Focus ,
                                  :Relaxation ;
                        :requiresEquipment :None ;
                        :hasCommonMistake "Zu schnell oder nur flach in den Brustkorb atmen, statt den Atem bewusst in den Bauch fließen zu lassen." ;
                        :hasCorrectionGuidance "Das Tempo bewusst verlangsamen und die Ausatmung etwas länger werden lassen als die Einatmung." ;
                        :hasDescription "Kastenatmung (4-4-4-4-Atmung) ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert." ;
                        :hasDuration "3 Min" ;
                        :hasInstruction """1. Aufrecht sitzen.
2. Vier Sekunden einatmen.
3. Vier Sekunden halten.
4. Vier Sekunden ausatmen.
5. Vier Sekunden pausieren.""" ;
                        rdfs:label "Box Breathing"@en ,
                                   "Kastenatmung (4-4-4-4-Atmung)"@de .


###  http://purl.org/PhysicalTherapy#Katze-Kuh-Übung
:Katze-Kuh-Übung rdf:type owl:NamedIndividual ,
                          :Mobilisation ;
                 :engagedBodyPart :Abs ,
                                  :Back ,
                                  :Chest ,
                                  :Core ,
                                  :LowerBack ,
                                  :Neck ,
                                  :NeckJoint ,
                                  :Spine ,
                                  :SpineJoint ,
                                  :UpperBack ;
                 :hasContraindication :WristIssue ;
                 :hasDifficultyLevel :Beginner ;
                 :improves :Coordination ,
                           :Flexibility ,
                           :Mobility ,
                           :Posture ,
                           :Relaxation ;
                 :rehabilitates :LowerBack ,
                                :NeckJoint ,
                                :SpineJoint ,
                                :UpperBack ;
                 :requiresEquipment :None ;
                 :stretches :Core ,
                            :LowerBack ,
                            :UpperBack ;
                 :hasCommonMistake "Die Bewegung wird zu schnell ausgeführt, der Nacken wird stark überstreckt oder die Ellenbogen werden gebeugt." ;
                 :hasCorrectionGuidance "Die Bewegung Wirbel für Wirbel ausführen und den Nacken als Verlängerung der Wirbelsäule halten. Die Arme gestreckt lassen und den Bewegungsumfang bei Beschwerden reduzieren." ;
                 :hasDescription "Eine dynamische Mobilisationsübung für die Wirbelsäule. Durch den kontrollierten Wechsel zwischen Rundrücken und sanfter Streckung werden Rücken, Nacken und Rumpf bewegt und die Wahrnehmung der Wirbelsäulenposition verbessert." ;
                 :hasDuration "2 Min" ;
                 :hasInstruction """1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Beim Ausatmen den Rücken langsam runden.
4. Das Kinn leicht zur Brust führen und den Bauchnabel nach innen ziehen.
5. Beim Einatmen das Becken kippen und die Wirbelsäule sanft nach unten bewegen.
6. Brustbein und Blick leicht nach vorne anheben.
7. Die Bewegung langsam und fließend wiederholen.
8. Nur im angenehmen Bewegungsbereich arbeiten.""" ;
                 rdfs:comment "Mobilisationsübung für die Wirbelsäule im Vierfüßlerstand, die abwechselnd den Rücken rund und hohl macht."@de ;
                 rdfs:label "CatCow"@en ,
                            "Katze-Kuh-Übung"@de .


###  http://purl.org/PhysicalTherapy#Kayaking
:Kayaking rdf:type owl:NamedIndividual ,
                   :SportActivity ;
          :Calorie 357.0 ;
          :MET 5.0 ;
          rdfs:label "Kajakfahren"@de ,
                     "Kayaking"@en .


###  http://purl.org/PhysicalTherapy#Kindpose
:Kindpose rdf:type owl:NamedIndividual ,
                   :Relaxation ;
          :engagedBodyPart :Abs ,
                           :Back ,
                           :Glutes ,
                           :Hip ,
                           :HipJoint ,
                           :Legs ,
                           :LowerBack ,
                           :Thighs ;
          :hasContraindication :HipIssue ,
                               :KneeIssue ,
                               :ShoulderIssue ;
          :hasDifficultyLevel :Beginner ;
          :improves :Flexibility ,
                    :Mobility ,
                    :Relaxation ;
          :rehabilitates :LowerBack ,
                         :Spine ,
                         :SpineJoint ;
          :requiresEquipment :None ;
          :hasCommonMistake "Das Becken wird gewaltsam zu den Fersen gedrückt, der Nacken bleibt angespannt oder die Knieposition verursacht Schmerzen." ;
          :hasCorrectionGuidance "Nur so weit zurückgehen, wie es angenehm möglich ist. Bei eingeschränkter Beweglichkeit ein Kissen unter Brust oder Gesäß legen. Die Knie weiter oder enger positionieren, bis Hüfte und Knie entspannt bleiben." ;
          :hasDescription "Eine ruhige Bodenposition zur Entspannung und sanften Mobilisation von Rücken und Hüfte. Der Oberkörper wird nach vorne abgesenkt, während das Becken in Richtung Fersen bewegt wird. Die Position kann mit einem Kissen oder Block angepasst werden." ;
          :hasDuration "2 Min" ;
          :hasInstruction """1. In den Vierfüßlerstand kommen.
2. Die Knie bequem auseinanderstellen und die großen Zehen zueinander führen.
3. Das Becken langsam in Richtung Fersen zurückschieben.
4. Den Oberkörper zwischen oder auf den Oberschenkeln ablegen.
5. Die Arme nach vorne ausstrecken oder entspannt neben dem Körper ablegen.
6. Die Stirn auf dem Boden, einem Kissen oder einem Block ablegen.
7. Ruhig und gleichmäßig atmen.
8. Die Position für mehrere Atemzüge halten und anschließend langsam verlassen.""" ;
          rdfs:comment "Ruhestellung im Sitzen mit nach vorne geneigtem Oberkörper, die Rücken und Hüfte sanft dehnt."@de ;
          rdfs:label "ChildPose"@en ,
                     "Kindhaltung"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Kindpose ;
   owl:annotatedProperty :engagedBodyPart ;
   owl:annotatedTarget :Hip ;
   rdfs:comment "The hip is actively involved during the execution of Kindpose."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Kindpose ;
   owl:annotatedProperty :engagedBodyPart ;
   owl:annotatedTarget :LowerBack ;
   rdfs:comment "The lower back is actively involved during the execution of Kindpose."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Kindpose ;

                          "Verstauchtes Sprunggelenk"@de .


###  http://purl.org/PhysicalTherapy#Squads
:Squads rdf:type owl:NamedIndividual ,
                 :Strength ;
        :engagedBodyPart :Glutes ,
                         :Hamstrings ,
                         :Hip ,
                         :Quadriceps ;
        :hasContraindication :HipIssue ,
                             :KneeIssue ,
                             :LowerBackIssue ;
        :hasDifficultyLevel :Beginner ;
        :improves :Balance ,
                  :Mobility ,
                  :Posture ,
                  :Stability ,
                  :Strength ;
        :requiresEquipment :None ;
        :strengthens :Abs ,
                     :Calves ,
                     :Glutes ,
                     :Hamstrings ,
                     :LowerBack ,
                     :Quadriceps ;
        :hasDuration "3 Min" ;
        :hasInstruction """1. Aufrecht hinstellen, Füße etwas mehr als hüftbreit, Zehen leicht nach außen gedreht.
2. Den Blick nach vorne richten und den Rumpf aufrichten.
3. Die Arme zur Stabilisation nach vorne strecken oder vor der Brust verschränken.
4. Langsam die Knie beugen und die Hüfte nach hinten schieben, als würde man sich auf einen Stuhl setzen.
5. Die Knie in Richtung Fußspitzen halten, den Rücken gerade lassen und nicht ins Hohlkreuz fallen.
6. Soweit absenken, wie eine kontrollierte, schmerzfreie Bewegung möglich ist, und kurz halten.
7. Über die Fersen kontrolliert wieder in den Stand aufrichten.
8. 12 bis 15 Wiederholungen pro Satz durchführen, insgesamt zwei bis drei Sätze.""" ;
        rdfs:comment "Kniebeuge, eine Grundübung zur Kräftigung von Oberschenkeln, Gesäß und Rumpf."@de ;
        rdfs:label "Kniebeugen"@de ,
                   "Squads"@en .


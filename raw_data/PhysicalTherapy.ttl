###  http://purl.org/PhysicalTherapy#Bruecke
:Bruecke rdf:type owl:NamedIndividual ,
                  :Strength ;
         :engagedBodyPart :Glutes ,
                          :Hamstrings ,
                          :Hip ,
                          :LowerBack ;
         :hasContraindication :Bruecke_LowerBackIssue ;
         :hasDifficultyLevel :Intermediate ;
         :improves :Posture ,
                   :Stability ,
                   :Strength ;
         :rehabilitates :Spine ;
         :requiresEquipment :None ;
         :strengthens :Abs ,
                      :Glutes ,
                      :LowerBack ;
         :hasCommonMistake "Am häufigsten werden die Hüfte zu hoch gestreckt, der untere Rücken durchgedrückt und die Füße vom Boden abgehoben, wodurch die Gesäßmuskeln ausfallen und die Lendenwirbelsäule belastet wird." ;
         :hasCorrectionGuidance "Füße hüftbreit lassen, Fersen in den Boden drücken, Rippen nach unten ziehen und die Bewegung bewusst aus dem Gesäß statt aus dem Rücken initiieren, bis Ohr, Schulter, Hüfte und Knie eine Linie bilden." ;
         :hasDescription "Die Brücke ist eine Rückenlage-Übung, bei der du die Hüfte durch Anspannen des Gesäßes anhebst und so Gesäß, Beinrückseite und Rumpf stabilisierend trainierst." ;
         :hasDuration "3 Min" ;
         :hasInstruction """1. Rückenlage, Knie angewinkelt, Füße hüftbreit und flach auf dem Boden.
2. Arme entspannt seitlich am Körper ablegen, Handflächen nach oben.
3. Core aktivieren und den unteren Rücken sanft in den Boden drücken.
4. Gesäß fest anspannen und die Hüfte kontrolliert nach oben schieben.
5. Am oberen Punkt bilden Schulter, Hüfte und Knie eine Linie, Pobacken oben richtig zusammendrücken.
6. Position kurz halten, dann die Hüfte langsam und kontrolliert wieder absenken.""" ;
         rdfs:comment "Übung im Liegen, bei der das Becken angehoben wird, um Gesäß, hintere Oberschenkel und Rumpf zu kräftigen."@de ;
         rdfs:label "Bridge"@en ,
                    "Brücke"@de .


###  http://purl.org/PhysicalTherapy#Bruecke_LowerBackIssue
:Bruecke_LowerBackIssue rdf:type owl:NamedIndividual ;
                        :forCondition :LowerBackIssue ;
                        :severity :MediumRisk ;
                        rdfs:comment "Hinweis auf Beschwerden im unteren Rücken, die bei der Brücke berücksichtigt werden sollten."@de ;
                        rdfs:label "Bridge_LowerBackIssue"@en ,
                                   "Brücke: Problem im unteren Rücken"@de .



###  http://purl.org/PhysicalTherapy#FerseZehenGang
:FerseZehenGang rdf:type owl:NamedIndividual ,
                         :Coordination ;
                :engagedBodyPart :AnkleJoint ,
                                 :Ankles ,
                                 :Calves ,
                                 :Legs ;
                :hasContraindication :AnkleIssue ,
                                     :BalanceIssue ;
                :hasDifficultyLevel :Beginner ;
                :improves :Coordination ,
                          :Flexibility ,
                          :Mobility ;
                :rehabilitates :AnkleJoint ;
                :requiresEquipment :None ;
                :hasDuration "2 Min" ;
                :hasInstruction """1. Aufrecht stehen und die Arme seitlich ausstrecken, um das Gleichgewicht zu erleichtern.
2. Den Blick nach vorne richten und den Rumpf stabil halten.
3. Einen Fuß direkt vor den anderen setzen, sodass die Ferse des vorderen Fußes die Zehen des hinteren berührt.
4. Langsam und bewusst vorwärts gehen, dabei die Füße in einer Linie halten.
5. Beim Wenden große Schritte machen, damit sich die Beine nicht kreuzen.
6. Die Übung idealerweise entlang einer Theke oder Wand durchführen, an der man sich bei Bedarf festhalten kann.
7. Ungefähr zwei Minuten in der Linie vor- und zurückgehen.""" ;
                rdfs:comment "Gangübung, bei der abwechselnd auf Fersen und Zehen gegangen wird, um Unterschenkel und Balance zu stärken."@de ;
                rdfs:label "Ferse-Zehen-Gang"@de ,
                           "HeelToeWalk"@en .


###  http://purl.org/PhysicalTherapy#FerseZehenGang_AnkleIssue
:FerseZehenGang_AnkleIssue rdf:type owl:NamedIndividual ;
                           :forCondition :AnkleIssue ;
                           :severity :MediumRisk ;
                           rdfs:comment "Hinweis auf Sprunggelenk-Probleme, die bei dem Ferse-Zehen-Gang berücksichtigt werden sollten."@de ;
                           rdfs:label "Ferse-Zehen-Gang: Sprunggelenkproblem"@de ,
                                      "HeelToeWalk_AnkleIssue"@en .


###  http://purl.org/PhysicalTherapy#FerseZehenGang_BalanceIssue
:FerseZehenGang_BalanceIssue rdf:type owl:NamedIndividual ;
                             :forCondition :BalanceIssue ;
                             :severity :HighRisk ;
                             rdfs:comment "Hinweis auf Gleichgewichts-Probleme, die bei dem Ferse-Zehen-Gang berücksichtigt werden sollten."@de ;
                             rdfs:label "Ferse-Zehen-Gang: Gleichgewichtsproblem"@de ,
                                        "HeelToeWalk_BalanceIssue"@en .


###  http://purl.org/PhysicalTherapy#FigureFourStretch
:FigureFourStretch rdf:type owl:NamedIndividual ,
                            :Stretching ;
                   :engagedBodyPart :Glutes ,
                                    :Hip ;
                   :hasContraindication :HipIssue ,
                                        :KneeIssue ;
                   :hasDifficultyLevel :Beginner ;
                   :improves :Flexibility ,
                             :Mobility ;
                   :requiresEquipment :None ;
                   :stretches :Glutes ,
                              :Hip ;
                   :hasDuration "2 Min" ;
                   :hasInstruction """1. Auf den Rücken legen, beide Knie anwinkeln und die Füße flach auf den Boden stellen.
2. Den äußeren Knöchel eines Fußes auf das gegenüberliegende Knie legen, sodass die Beine eine Vier bilden.
3. Die Hände hinter dem Oberschenkel des unten liegenden Beins verschränken.
4. Das untere Bein langsam in Richtung Brust ziehen, bis eine sanfte Dehnung in Gesäß und Hüfte spürbar ist.
5. Die Position 20 bis 30 Sekunden halten und gleichmäßig weiteratmen.
6. Langsam in die Ausgangsposition zurückkehren und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen.""" ;
                   rdfs:comment "Dehnübung im Liegen, bei der ein Fuß über das gegenseitige Knie gelegt wird, um die Hüftaußenrotatoren zu dehnen."@de ;
                   rdfs:label "FigureFourStretch"@en ,
                              "Vierer-Dehnung"@de .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :FigureFourStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :HipIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of FigureFourStretch to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :FigureFourStretch ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :KneeIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of FigureFourStretch to avoid strain or injury."
 ] .


###  http://purl.org/PhysicalTherapy#FigureFourStretch_KneeIssue
:FigureFourStretch_KneeIssue rdf:type owl:NamedIndividual ;
                             :forCondition :KneeIssue ;
                             :isContraindicationFor :FigureFourStretch ;
                             :severity :MediumRisk ;

###  http://purl.org/PhysicalTherapy#MonsterWalk
:MonsterWalk rdf:type owl:NamedIndividual ,
                      :Strength ;
             :engagedBodyPart :Core ,
                              :Glutes ,
                              :Hip ,
                              :HipJoint ,
                              :Legs ,
                              :Quadriceps ;
             :hasContraindication :HipIssue ,
                                  :KneeIssue ;
             :hasDifficultyLevel :Intermediate ;
             :improves :Balance ,
                       :Coordination ,
                       :Stability ,
                       :Strength ;
             :rehabilitates :HipJoint ;
             :requiresEquipment :Theraband ;
             :strengthens :Core ,
                          :Glutes ,
                          :Quadriceps ;
             :hasDuration "2 Min" ;
             :hasInstruction """1. Ein leichtes Theraband knapp über den Knien um beide Oberschenkel legen.
2. Aufrecht in Schrittstellung hinstellen, die Füße etwas weiter als hüftbreit auseinander.
3. Die Knie bewusst nach außen drücken, sodass das Band unter Spannung bleibt.
4. Die Hüfte leicht beugen und das Gesäß anspannen.
5. Mit kleinen, bewussten Schritten seitlich nach rechts gehen und dabei das Band gespannt halten.
6. Eine bestimmte Strecke in eine Richtung gehen, dann wenden und zur anderen Seite laufen.
7. Anschließend in Vor- und Rückwärtsrichtung mit kleinen Schritten wiederholen.
8. Pro Richtung 10 bis 20 Schritte ausführen und das Band nicht zu leicht wählen.""" ;
             rdfs:comment "Gangübung mit deutlich angehobenen Knien zur Kräftigung von Hüfte und Oberschenkeln."@de ;
             rdfs:label "Monster-Walk"@de ,
                        "MonsterWalk"@en .

[ rdf:type owl:Axiom ;

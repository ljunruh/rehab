###  http://purl.org/PhysicalTherapy#Standing_sleeper_stretch
:Standing_sleeper_stretch rdf:type owl:NamedIndividual ,
                                   :Stretching ;
                          :engagedBodyPart :RearDeltoids ,
                                           :RotatorCuffs ,
                                           :ShoulderJoint ,
                                           :Shoulders ,
                                           :UpperBack ;
                          :hasContraindication :ShoulderIssue ;
                          :hasDifficultyLevel :Beginner ;
                          :improves :Flexibility ,
                                    :Mobility ,
                                    :Stability ;
                          :rehabilitates :RotatorCuffs ,
                                         :ShoulderJoint ;
                          :requiresEquipment :Wall ;
                          :stretches :RearDeltoids ,
                                     :RotatorCuffs ;
                          :hasCommonMistake "Zu viel Druck wird auf die Schulter gegeben, der Oberkörper dreht mit oder die Bewegung verursacht stechende Schmerzen." ;
                          :hasCorrectionGuidance "Nur leichten Druck verwenden und die Schulter stabil halten. Die Dehnung muss sanft bleiben. Bei Schmerz den Winkel oder Bewegungsumfang reduzieren." ;
                          :hasDescription "Dehnübung für die hintere Schulterkapsel und die Innenrotation der Schulter. Sie kann die Beweglichkeit der Schulter verbessern, sollte aber sehr kontrolliert ausgeführt werden." ;
                          :hasDuration "2 Min" ;
                          :hasInstruction """1. Seitlich an eine Wand stellen.
2. Den betroffenen Arm auf Schulterhöhe an die Wand bringen.
3. Den Ellenbogen etwa 90 Grad beugen.
4. Den Unterarm langsam nach unten führen.
5. Eine sanfte Dehnung in der hinteren Schulter spüren.
6. Die Position kurz halten.
7. Langsam lösen.""" ;
                          rdfs:comment "Dehnübung im Liegen, die die Innenrotation der Schulter sanft verbessert."@de ;
                          rdfs:label "Sleeper-Stretch im Stehen"@de ,
                                     "StandingSleeperStretch"@en .



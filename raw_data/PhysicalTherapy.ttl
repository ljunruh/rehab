###  http://purl.org/PhysicalTherapy#FacePullMitTheraband
:FacePullMitTheraband rdf:type owl:NamedIndividual ,
                               :Strength ;
                      :engagedBodyPart :Shoulders ,
                                       :UpperBack ;
                      :hasContraindication :ShoulderIssue ;
                      :hasDifficultyLevel :Intermediate ;
                      :improves :Posture ,
                                :Stability ,
                                :Strength ;
                      :requiresEquipment :Theraband ;
                      :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
                      :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
                      :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern." ;
                      :hasDuration "4 Min" ;
                      :hasInstruction """1. Theraband sicher befestigen.
2. Rumpf aufrecht halten.
3. Band kontrolliert zum Körper ziehen.
4. Schulterblätter zusammenführen und langsam lösen.""" ;
                      rdfs:label "Face Pull"@en ,
                                 "Face Pull mit Theraband"@de .


###  http://purl.org/PhysicalTherapy#FadenDurchDieNadel
:FadenDurchDieNadel rdf:type owl:NamedIndividual ,
                             :Mobilisation ;
                    :engagedBodyPart :Spine ,
                                     :UpperBack ;
                    :hasContraindication :SpineIssue ;
                    :hasDifficultyLevel :Intermediate ;
                    :improves :Flexibility ,
                              :Mobility ,
                              :Posture ;
                    :requiresEquipment :None ;
                    :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
                    :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
                    :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität." ;
                    :hasDuration "2 Min" ;
                    :hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren.""" ;
                    rdfs:label "Faden-durch-die-Nadel"@de ,
                               "Thread the Needle"@en .



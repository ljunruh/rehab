###  http://purl.org/PhysicalTherapy#ShoulderInternalExternalRotation
:ShoulderInternalExternalRotation rdf:type owl:NamedIndividual ,
                                           :CoordinationMobility ,
                                           :MobilisationStretching ;
                                  :engagedBodyPart :FrontDeltoid ,
                                                   :RearDeltoids ,
                                                   :RotatorCuffs ,
                                                   :ShoulderJoint ,
                                                   :Shoulders ,
                                                   :UpperBack ;
                                  :hasContraindication :ClavicleFracture ,
                                                       :ShoulderIssue ;
                                  :hasDifficultyLevel :Beginner ;
                                  :improves :Coordination ,
                                            :Mobility ,
                                            :Stability ;
                                  :rehabilitates :RotatorCuffs ,
                                                 :ShoulderJoint ,
                                                 :Shoulders ;
                                  :requiresEquipment :Theraband ;
                                  :strengthens :RotatorCuffs ;
                                  :hasCommonMistake "Der Oberkörper dreht mit, der Ellenbogen wandert nach außen oder die Bewegung wird ruckartig ausgeführt." ;
                                  :hasCorrectionGuidance "Den Ellenbogen nah am Körper halten und die Bewegung nur aus dem Schultergelenk ausführen. Den Bewegungsumfang reduzieren, wenn Ausweichbewegungen entstehen." ;
                                  :hasDescription "Mobilisations- und Kontrollübung für Innen- und Außenrotation der Schulter. Die Übung verbessert die Bewegungswahrnehmung und unterstützt die funktionelle Schulterbeweglichkeit." ;
                                  :hasInstruction """1. Aufrecht stehen oder sitzen.
2. Den Ellenbogen am Körper halten und etwa 90 Grad beugen.
3. Den Unterarm langsam nach außen rotieren.
4. Anschließend kontrolliert nach innen rotieren.
5. Die Bewegung langsam und schmerzfrei ausführen.
6. Die Schulter während der Bewegung stabil halten""" .



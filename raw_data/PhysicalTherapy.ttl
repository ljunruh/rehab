###  http://purl.org/PhysicalTherapy#TherabandAussenrotation
:TherabandAussenrotation rdf:type owl:NamedIndividual ,
                                  :Strength ;
                         :engagedBodyPart :RearDeltoids ,
                                          :RotatorCuffs ,
                                          :ShoulderJoint ,
                                          :Shoulders ,
                                          :Trapezius ;
                         :hasContraindication :ClavicleFracture ;
                         :hasDifficultyLevel :Beginner ;
                         :improves :Mobility ,
                                   :Stability ,
                                   :Strength ;
                         :rehabilitates :RotatorCuffs ,
                                        :ShoulderJoint ,
                                        :Shoulders ;
                         :requiresEquipment :Theraband ;
                         :strengthens :RearDeltoids ,
                                      :RotatorCuffs ;
                         :hasCommonMistake "Der Ellenbogen entfernt sich vom Körper, das Handgelenk knickt ab oder der Oberkörper dreht mit." ;
                         :hasCorrectionGuidance "Den Ellenbogen nah am Körper halten, eventuell ein kleines Handtuch zwischen Ellenbogen und Oberkörper klemmen. Nur so weit nach außen rotieren, wie die Schulter stabil bleibt." ;
                         :hasDescription "Kräftigungsübung für die Außenrotatoren der Schulter und die Rotatorenmanschette. Sie unterstützt die Schulterstabilität und kann bei kontrolliertem Training die Haltung des Schultergelenks verbessern." ;
                         :hasInstruction """1. Aufrecht stehen oder sitzen.
2. Das Theraband mit beiden Händen halten.
3. Die Ellenbogen nah am Körper halten und etwa 90 Grad beugen.
4. Einen Unterarm langsam nach außen drehen.
5. Das Handgelenk stabil halten.
6. Langsam in die Ausgangsposition zurückkehren.
7. Die Bewegung kontrolliert wiederholen.""" ;
                         rdfs:label "Theraband-Aussenrotation" .



:ChestDoorwayStretch_ShoulderIssue rdf:type owl:NamedIndividual ;
                                   :forCondition :ShoulderIssue ;
                                   :isContraindicationFor :ChestDoorwayStretch ;
                                   :severity :MediumRisk ;
                                   rdfs:comment "Hinweis auf Schulter-Probleme, die bei ChestDoorwayStretch berücksichtigt werden sollten."@de ;
                                   rdfs:label "Brustdehnung im Türrahmen: Schulterproblem"@de ,
                                              "ChestDoorwayStretch_ShoulderIssue"@en .



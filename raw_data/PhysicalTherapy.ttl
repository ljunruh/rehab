###  http://purl.org/PhysicalTherapy#JumpingJacks
:JumpingJacks rdf:type owl:NamedIndividual ,
                       :Cardio ;
              :engagedBodyPart :Calves ,
                               :Core ,
                               :Glutes ,
                               :Hip ,
                               :Quadriceps ,
                               :Shoulders ;
              :hasContraindication :AnkleIssue ,
                                   :KneeIssue ,
                                   :SpineIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Balance ,
                        :Coordination ,
                        :Mobility ,
                        :Strength ;
              :requiresEquipment :None ;
              :hasDuration "2 Min" ;
              :hasInstruction """1. Aufrecht stehen, Füße zusammen, Arme seitlich am Körper.
2. Mit beiden Füßen gleichzeitig etwas mehr als hüftbreit springen und die Arme in einem Bogen über den Kopf führen.
3. Weich auf den Fußballen landen, die Knie dabei leicht gebeugt halten.
4. Mit einem weiteren Sprung in die Ausgangsposition zurückkehren und die Arme senken.
5. Die Knie während der gesamten Bewegung über den Fußspitzen ausrichten und den Rumpf stabil halten.
6. Anfangs 20 bis 30 Sekunden in gemäßigtem Tempo durchführen, dann 30 bis 60 Sekunden steigern.
7. Zwei bis drei Sätze mit jeweils 20 bis 30 Sekunden Pause absolvieren.""" ;
              rdfs:comment "Hampelmann, eine klassische Aufwärmübung, die den gesamten Kreislauf aktiviert."@de ;
              rdfs:label "Hampelmann"@de ,
                         "JumpingJacks"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :JumpingJacks ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :AnkleIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of JumpingJacks to avoid strain or injury."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :JumpingJacks ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :KneeIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of JumpingJacks to avoid strain or injury."
 ] .


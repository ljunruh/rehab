 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HueftbeugerDehnung ;
   owl:annotatedProperty :improves ;
   owl:annotatedTarget :Flexibility ;
   rdfs:comment "Regular practice of HueftbeugerDehnung is known to enhance Flexibility."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :HueftbeugerDehnung ;
   owl:annotatedProperty :improves ;
   owl:annotatedTarget :Mobility ;
   rdfs:comment "Regular practice of HueftbeugerDehnung is known to enhance Mobility."
 ] .



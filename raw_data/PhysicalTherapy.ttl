###  http://purl.org/PhysicalTherapy#SealStretch
:SealStretch rdf:type owl:NamedIndividual ,
                      :MobilisationStretching ,
                      :Stretching ;
             :engagedBodyPart :Abs ,
                              :Chest ,
                              :Core ,
                              :Hip ,
                              :HipJoint ,
                              :LowerBack ,
                              :Psoas ,
                              :ShoulderJoint ,
                              :Spine ,
                              :SpineJoint ;
             :hasContraindication :AcuteLowBackPain ,
                                  :LumbarDiscHerniation ,
                                  :SpineIssue ;
             :hasDifficultyLevel :Intermediate ;
             :improves :Flexibility ,
                       :Mobility ,
                       :Posture ;
             :rehabilitates :Abs ,
                            :LowerBack ,
                            :SpineJoint ;
             :stretches :Core ,
                        :Psoas ;
             :hasCommonMistake "Die Schultern werden hochgezogen, die Ellenbogen werden durchgedrückt oder die Bewegung wird trotz Rückenschmerzen erzwungen." ;
             :hasCorrectionGuidance "Die Arme nur so weit strecken, wie es angenehm ist. Schultern tief halten und bei Druck im unteren Rücken die Höhe reduzieren." ;
             :hasDescription "Mobilisations- und Dehnübung für die vordere Rumpfseite und die Wirbelsäulenstreckung. Die Übung wird häufig zur sanften Extension der Wirbelsäule genutzt." ;
             :hasInstruction """1. In Bauchlage starten.
2. Hände neben oder leicht vor den Schultern aufstützen.
3. Den Oberkörper langsam anheben.
4. Das Becken bleibt möglichst am Boden.
5. Schultern weg von den Ohren halten.
6. Die Position kurz halten und ruhig atmen.
7. Langsam wieder absenken.""" ;
             rdfs:label "Seal Stretch"@en .



###  http://purl.org/PhysicalTherapy#DiagonalesArmUndBeinhebenImVierfuesslerstand
:DiagonalesArmUndBeinhebenImVierfuesslerstand rdf:type owl:NamedIndividual ,
                                                       :Coordination ;
                                              :engagedBodyPart :Core ,
                                                               :LowerBack ;
                                              :hasContraindication :BalanceIssue ;
                                              :hasDifficultyLevel :Intermediate ;
                                              :improves :Coordination ,
                                                        :Mobility ,
                                                        :Stability ;
                                              :requiresEquipment :None ;
                                              :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten." ;
                                              :hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze." ;
                                              :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf." ;
                                              :hasDuration "3 Min" ;
                                              :hasInstruction """1. In den Vierfüßlerstand kommen.
2. Rumpf stabilisieren.
3. Arm und/oder Bein kontrolliert strecken.
4. Ohne Beckenrotation zurückführen.""" ;
                                              rdfs:label "Diagonales Arm- und Beinheben im Vierfüßlerstand"@de ,
                                                         "Quadruped Arm-Leg Reach"@en .



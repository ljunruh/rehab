:Armkreisen_ShoulderIssue rdf:type owl:NamedIndividual ;
                          :forCondition :ShoulderIssue ;
                          :severity :LowRisk ;
                          rdfs:comment "Hinweis auf Schulter-Probleme, die bei den Armkreisen berücksichtigt werden sollten."@de ;
                          rdfs:label "ArmCircles_ShoulderIssue"@en ,
                                     "Armkreisen: Schulterproblem"@de .


###  http://purl.org/PhysicalTherapy#Arms
:Arms rdf:type owl:NamedIndividual ,
               :BodyPart ;
      rdfs:comment "Arme als Körperregion, die Oberarme, Unterarme und Hände einschließt."@de ;
      rdfs:label "Arme"@de ,
                 "Arms"@en .


###  http://purl.org/PhysicalTherapy#AssistedShoulderRotation
:AssistedShoulderRotation rdf:type owl:NamedIndividual ,
                                   :Coordination ,
                                   :Mobilisation ;
                          :engagedBodyPart :Arms ,
                                           :RotatorCuffs ,
                                           :ShoulderJoint ,
                                           :Shoulders ,
                                           :UpperBack ;
                          :hasContraindication :ShoulderIssue ;
                          :hasDifficultyLevel :Beginner ;
                          :improves :Coordination ,
                                    :Flexibility ,
                                    :Mobility ;
                          :rehabilitates :RotatorCuffs ,
                                         :ShoulderJoint ;
                          :requiresEquipment :Stick ;
                          :hasCommonMistake "Die Bewegung wird zu stark gezogen, der Ellenbogen entfernt sich vom Körper oder der Oberkörper dreht mit." ;
                          :hasCorrectionGuidance "Den Ellenbogen stabil am Körper halten und nur sanften Druck verwenden. Der Bewegungsbereich soll schmerzfrei bleiben." ;
                          :hasDescription "Sanfte Mobilisationsübung für die Schulterrotation mit Unterstützung durch die andere Hand, einen Stab oder ein Hilfsmittel. Sie verbessert die kontrollierte Beweglichkeit der Schulter." ;
                          :hasDuration "2 Min" ;
                          :hasInstruction """1. Aufrecht sitzen oder stehen.
2. Den Ellenbogen des zu bewegenden Arms nah am Körper halten.
3. Einen Stab oder die andere Hand zur Unterstützung verwenden.
4. Den Unterarm langsam in die gewünschte Rotationsrichtung bewegen.
5. Die Bewegung nur passiv oder leicht aktiv unterstützen.
6. Kurz halten und langsam zurückführen.
7. Mehrmals kontrolliert wiederholen.""" ;
                          rdfs:comment "Sanfte Mobilisationsübung für die Schulterrotation mit Unterstützung durch die andere Hand oder einen Stab."@de ;
                          rdfs:label "AssistedShoulderRotation"@en ,
                                     "Assistierte Schulterrotation"@de .


###  http://purl.org/PhysicalTherapy#Atemuebung478
:Atemuebung478 rdf:type owl:NamedIndividual ,
                        :Relaxation ;
               :engagedBodyPart :Chest ,
                                :Core ;
               :hasContraindication :RespiratoryIssue ;
               :hasDifficultyLevel :Beginner ;
               :improves :Focus ,
                         :Relaxation ;
               :requiresEquipment :None ;
               :hasCommonMistake "Die Luft wird mit Kraft angehalten, die Schultern werden beim Einatmen hochgezogen oder die Atemphasen werden zu schnell ausgeführt." ;
               :hasCorrectionGuidance "Nur so tief einatmen und so lange pausieren, wie es angenehm möglich ist. Schultern und Gesicht entspannt lassen. Bei Schwierigkeiten kann zunächst ein kürzerer Rhythmus verwendet werden." ;
               :hasDescription "Eine kontrollierte Atemübung zur Entspannung und zur bewussten Verlangsamung der Atmung. Die Übung lenkt die Aufmerksamkeit auf einen gleichmäßigen Atemrhythmus und kann im Sitzen oder Liegen durchgeführt werden." ;
               :hasDuration "3 Min" ,
                            "5 Min" ;
               :hasInstruction """1. Eine bequeme Sitz- oder Liegeposition einnehmen und die Schultern entspannen.
2. Ruhig durch die Nase einatmen und dabei bis vier zählen.
3. Den Atem ohne starkes Pressen halten und bis sieben zählen.
4. Langsam durch den Mund ausatmen und dabei bis acht zählen.
5. Kurz normal weiteratmen.
6. Den Ablauf drei- bis viermal wiederholen.""" ;
               rdfs:comment "Kontrollierte Atemübung zur Entspannung und bewussten Verlangsamung der Atmung."@de ;
               rdfs:label "Atemübung (4-7-8)"@de ,
                          "BreathingExercise478"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Atemuebung478 ;
   owl:annotatedProperty :hasContraindication ;
   owl:annotatedTarget :RespiratoryIssue ;
   rdfs:comment "This Contraindication should be considered for practitioners of Atemuebung478 to avoid strain or injury."
 ] .



:Ananas-Ingwer-Regenerations-Smoothie rdf:type owl:NamedIndividual ,
                                               :RecipeOfTheWeek ;
                                      :hasHealthBenefit "Ananas enthält das Enzym Bromelain, welches Abschwellungen fördert und die Heilung von Gewebe und Gelenken nach Verletzungen beschleunigt."@de ;
                                      :hasInstruction "150g frische Ananas, 1 cm frischen Ingwer, 1/2 Banane und 150ml Wasser im Hochleistungsmixer cremig pürieren." ;
                                      :hasPreparationTime 5 ;
                                      rdfs:label "Ananas-Ingwer-Regenerations-Smoothie"@de ,
                                                 "Pineapple Ginger Recovery Smoothie"@en .



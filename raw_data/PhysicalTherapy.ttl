###  http://purl.org/PhysicalTherapy#Muschel
:Muschel rdf:type owl:NamedIndividual ,
                  :Strength ;
         :engagedBodyPart :Glutes ,
                          :Hip ,
                          :HipJoint ;
         :hasContraindication :HipIssue ;
         :hasDifficultyLevel :Beginner ;
         :improves :Balance ,
                   :Stability ,
                   :Strength ;
         :requiresEquipment :None ,
                            :Theraband ;
         :strengthens :Glutes ;
         :hasDuration "2 Min" ;
         :hasInstruction """1. In Seitenlage auf eine Matte legen, Hüfte und Knie ungefähr 45 Grad angewinkelt.
2. Die Füße übereinander halten, der untere Arm stützt den Kopf.
3. Den oberen Arm locker vor die Brust legen und die obere Hand an der Hüfte positionieren.
4. Die Beckenstellung kontrollieren: Hüfte und Schultern bleiben senkrecht übereinander.
5. Das obere Knie langsam und kontrolliert anheben, die Füße bleiben dabei zusammen.
6. Das Knie am oberen Punkt kurz halten, dann langsam wieder absenken.
7. 10 bis 15 Wiederholungen pro Seite durchführen und die Seite wechseln.
8. Optional ein Theraband knapp über den Knien anbringen, um die Intensität zu steigern.""" ;
         rdfs:comment "Übung in Seitenlage, bei der das obere Knie wie eine Muschel geöffnet wird, um die Hüftaußenrotatoren zu kräftigen."@de ;
         rdfs:label "ClamShell"@en ,
                    "Muschel"@de .


###  http://purl.org/PhysicalTherapy#Muschel_HipIssue
:Muschel_HipIssue rdf:type owl:NamedIndividual ;
                  :forCondition :HipIssue ;
                  :severity :LowRisk ;
                  rdfs:comment "Hinweis auf Hüft-Probleme, die bei Muschel berücksichtigt werden sollten."@de ;
                  rdfs:label "ClamShell_HipIssue"@en ,
                             "Muschel: Hüftproblem"@de .


###  http://purl.org/PhysicalTherapy#Nackendehnungen
:Nackendehnungen rdf:type owl:NamedIndividual ,
                          :Stretching ;
                 :engagedBodyPart :Neck ,
                                  :NeckJoint ;
                 :hasContraindication :NeckIssue ;
                 :hasDifficultyLevel :Beginner ;
                 :improves :Flexibility ,
                           :Mobility ,
                           :Posture ;
                 :hasCommonMistake "Der Kopf wird mit der Hand stark nach unten gezogen, die Schulter wird angehoben oder die Bewegung erfolgt ruckartig." ;
                 :hasCorrectionGuidance "Nur mit dem Eigengewicht des Kopfes arbeiten und die Schultern entspannt halten. Keine kreisenden Vollbewegungen erzwingen. Bei Schwindel, Taubheit oder ausstrahlendem Schmerz sofort abbrechen." ;
                 :hasDescription "Eine sanfte Dehnübung für die seitliche und hintere Nackenmuskulatur. Sie kann Spannungsgefühle reduzieren, die beispielsweise durch langes Sitzen oder eine statische Bildschirmhaltung entstehen." ;
                 :hasDuration "2 Min" ;
                 :hasInstruction """1. Aufrecht sitzen oder stehen.
2. Die Schultern locker nach unten sinken lassen.
3. Den Kopf langsam zu einer Seite neigen.
4. Das gegenüberliegende Ohr bewegt sich dabei von der Schulter weg.
5. Die Position für mehrere ruhige Atemzüge halten.
Langsam zur Mitte zurückkehren.
6. Die Übung auf der anderen Seite wiederholen.
7. Optional den Kopf leicht nach vorne neigen, um die hintere Nackenregion zu dehnen.""" ;
                 rdfs:comment "Sanfte Dehnübungen für die Hals- und Nackenmuskulatur zur Lockerung von Verspannungen."@de ;
                 rdfs:label "Nackendehnungen"@de ,
                            "NeckStretches"@en .



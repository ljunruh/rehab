###  http://purl.org/PhysicalTherapy#ScapulaRetraktion
:ScapulaRetraktion rdf:type owl:NamedIndividual ,
                            :CoordinationMobility ,
                            :Strength ;
                   :engagedBodyPart :RearDeltoids ,
                                    :RotatorCuffs ,
                                    :ShoulderJoint ,
                                    :Shoulders ,
                                    :Spine ,
                                    :SpineJoint ,
                                    :Trapezius ,
                                    :UpperBack ;
                   :hasContraindication :ClavicleFracture ;
                   :hasDifficultyLevel :Intermediate ;
                   :improves :Posture ,
                             :Stability ,
                             :Strength ;
                   :rehabilitates :ShoulderJoint ,
                                  :Shoulders ,
                                  :Trapezius ,
                                  :UpperBack ;
                   :requiresEquipment :None ;
                   :strengthens :Lats ,
                                :RearDeltoids ,
                                :RotatorCuffs ,
                                :Shoulders ,
                                :Trapezius ;
                   :hasCommonMistake "Die Bewegung wird ruckartig ausgeführt." ,
                                     "Die Schultern werden zu den Ohren gezogen." ,
                                     "Es entsteht ein starkes Hohlkreuz." ;
                   :hasCorrectionGuidance "Den Brustkorb nicht übermäßig nach vorne schieben." ,
                                          "Die Bewegung langsam und nur im schmerzfreien Bereich ausführen." ,
                                          "Nacken lang und Schultern entspannt halten." ;
                   :hasDescription "Kräftigt die Muskulatur des oberen Rückens und der Schulterregion und kann helfen, Verspannungen durch langes Sitzen oder Bildschirmarbeit zu reduzieren." ;
                   :hasInstruction """1. Aufrecht stehen und die Ellenbogen im 90-Grad-Winkel halten.
2. Schultern und Ellenbogen langsam nach hinten bewegen.
3. Schulterblätter kontrolliert zusammenziehen.
4. Kurz halten.
5. Langsam in die Ausgangsposition zurückkehren.\"""" ;
                   rdfs:comment "rdfs:comment → \"Übung zur Kräftigung und Stabilisierung der Schulterblattmuskulatur.\"@de"@de ;
                   rdfs:label "Scapula-Retraktion"@de .


###  http://purl.org/PhysicalTherapy#ScapulaRetraktion_ShoulderIssue
:ScapulaRetraktion_ShoulderIssue rdf:type owl:NamedIndividual ,
                                          :Contraindication ;
                                 :forCondition :ShoulderIssue ;
                                 :severity :MediumRisk ;
                                 rdfs:label "ScapulaRetraktion_ShoulderIssue" .


###  http://purl.org/PhysicalTherapy#SchulterNackenEntspannung
:SchulterNackenEntspannung rdf:type owl:NamedIndividual ,
                                    :Entspannung ;
                           :engagedBodyPart :Neck ,
                                            :NeckJoint ,
                                            :ShoulderJoint ,
                                            :Shoulders ;
                           :hasContraindication :SchulterNackenEntspannung_NeckIssue ,
                                                :SchulterNackenEntspannung_ShoulderIssue ;
                           :hasDifficultyLevel :Beginner ;
                           :improves :Flexibility ,
                                     :Mobility ,
                                     :Posture ,
                                     :Relaxation ;
                           :rehabilitates :Shoulders ;
                           :requiresEquipment :None ;
                           :hasCommonMistake "Die Schultern werden hochgezogen gehalten, der Kopf wird mit der Hand stark zur Seite gezogen oder die Bewegungen werden schnell und ruckartig ausgeführt." ;
                           :hasCorrectionGuidance "Den Nacken lang halten und die Schultern bewusst nach unten entspannen. Nur einen kleinen Bewegungsumfang verwenden, wenn Spannung oder Beschwerden auftreten. Keine kreisenden Vollbewegungen des Kopfes erzwingen." ;
                           :hasDescription "Eine sanfte Bewegungsfolge zur Lockerung der Schulter- und Nackenregion. Sie eignet sich besonders nach längerem Sitzen oder Bildschirmarbeit und verbindet bewusste Atmung mit langsamen Schulter- und Kopfbewegungen." ;
                           :hasInstruction """1. Aufrecht sitzen oder stehen und die Arme locker neben dem Körper halten.
2. Die Schultern langsam zu den Ohren anheben.
3. Beim Ausatmen die Schultern bewusst nach unten sinken lassen.
4. Die Schultern langsam nach hinten kreisen.
5. Den Kopf anschließend vorsichtig zu einer Seite neigen, ohne die Schulter anzuheben.
6. Die Position für zwei bis drei ruhige Atemzüge halten.
7. Zur Mitte zurückkehren und die andere Seite ausführen.
8. Zum Abschluss den Kopf langsam nach rechts und links drehen.
9. Alle Bewegungen im schmerzfreien Bereich ausführen.""" ;
                           rdfs:label "Schulter-Nacken-Entspannung" .


###  http://purl.org/PhysicalTherapy#SchulterNackenEntspannung_NeckIssue
:SchulterNackenEntspannung_NeckIssue rdf:type owl:NamedIndividual ,
                                              :Contraindication ;
                                     :forCondition :NeckIssue ;
                                     :severity :LowRisk ;
                                     rdfs:label "SchulterNackenEntspannung_NeckIssue" .



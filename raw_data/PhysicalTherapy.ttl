###  http://purl.org/PhysicalTherapy#PiriformisStretch
:PiriformisStretch rdf:type owl:NamedIndividual ,
                            :Stretching ;
                   :engagedBodyPart :Glutes ,
                                    :Hip ,
                                    :HipJoint ,
                                    :LowerBack ,
                                    :SpineJoint ;
                   :hasContraindication :HipIssue ,
                                        :LowerBackIssue ;
                   :hasDifficultyLevel :Beginner ;
                   :improves :Flexibility ,
                             :Mobility ,
                             :Relaxation ;
                   :rehabilitates :Glutes ,
                                  :HipJoint ,
                                  :LowerBack ;
                   :requiresEquipment :None ;
                   :stretches :Glutes ,
                              :Hip ;
                   :hasCommonMistake "Das Knie wird stark nach unten gedrückt, der Nacken verspannt oder die Dehnung wird trotz Schmerzen erzwungen." ;
                   :hasCorrectionGuidance "Die Dehnung sanft halten und nicht am Knie ziehen. Kopf und Schultern entspannt ablegen und nur im angenehmen Bereich arbeiten." ;
                   :hasDescription "Dehnübung für die tiefe Gesäßmuskulatur, insbesondere den Piriformis. Sie kann Spannungen im Gesäßbereich reduzieren und die Hüftbeweglichkeit unterstützen." ;
                   :hasDuration "2 Min" ;
                   :hasInstruction """1. Auf den Rücken legen.
2. Ein Bein anwinkeln.
3. Den Knöchel des anderen Beins auf den Oberschenkel legen.
4. Das untere Bein langsam zum Körper ziehen.
5. Die Dehnung im Gesäß wahrnehmen.
6. Die Position ruhig halten.
7. Langsam lösen und die Seite wechseln.""" ;
                   rdfs:comment "Dehnübung für den Piriformis-Muskel in der tiefen Hüftmuskulatur."@de ;
                   rdfs:label "Piriformis-Dehnung"@de ,
                              "PiriformisStretch"@en .


###  http://purl.org/PhysicalTherapy#PiriformisStretch_KneeIssue
:PiriformisStretch_KneeIssue rdf:type owl:NamedIndividual ;
                             :forCondition :KneeIssue ;
                             :isContraindicationFor :PiriformisStretch ;
                             :severity :LowRisk ;
                             rdfs:comment "Hinweis auf Knie-Probleme, die bei der Piriformis-Dehnung berücksichtigt werden sollten."@de ;
                             rdfs:label "Piriformis-Dehnung: Knieschmerzen"@de ,
                                        "PiriformisStretch_KneeIssue"@en .


###  http://purl.org/PhysicalTherapy#Plank
:Plank rdf:type owl:NamedIndividual ,
                :Strength ;
       :engagedBodyPart :Abs ,
                        :Chest ,
                        :Core ,
                        :Glutes ,
                        :HipJoint ,
                        :LowerBack ,
                        :ShoulderJoint ,
                        :Shoulders ,
                        :SpineJoint ,
                        :UpperBack ;
       :hasContraindication :LowerBackIssue ,
                            :ShoulderIssue ,
                            :SpineIssue ,
                            :WristIssue ;
       :hasDifficultyLevel :Advanced ;
       :improves :Balance ,
                 :Posture ,
                 :Stability ,
                 :Strength ;
       :rehabilitates :Abs ,
                      :LowerBack ,
                      :Spine ,
                      :SpineJoint ;
       :requiresEquipment :None ;
       :strengthens :Abs ,
                    :FrontDeltoid ,
                    :LowerBack ,
                    :Obliques ,
                    :Shoulders ;
       :hasCommonMistake "Das Becken sinkt ab, das Gesäß wird zu hoch gehalten oder der Nacken wird überstreckt." ;
       :hasCorrectionGuidance "Bauchspannung aktivieren und den Blick zum Boden richten. Die Übung abbrechen oder verkürzen, wenn die Körperlinie nicht mehr gehalten werden kann." ;
       :hasDescription "Statische Kräftigungsübung für Rumpf, Bauchmuskulatur, Schultern und Hüfte. Sie verbessert die Körperstabilität und die Kontrolle der Wirbelsäulenposition." ;
       :hasDuration "3 Min" ;
       :hasInstruction """1. In den Unterarmstütz kommen.
2. Ellenbogen unter den Schultern positionieren.
3. Beine nach hinten ausstrecken.
4. Bauch und Gesäß leicht anspannen.
5. Den Körper in einer geraden Linie halten.
6. Ruhig weiteratmen.
7. Die Position nur so lange halten, wie die Kontrolle erhalten bleibt.""" ;
       :hasVideoUrl "https://revia.mausnetz.com/video/plank.mp4" ;
       rdfs:comment "Statische Halteübung in Bauchlage auf Unterarmen und Zehen, die den gesamten Rumpf kräftigt."@de ;
       rdfs:label "Plank"@en ,
                  "Unterarmstütz"@de .


###  http://purl.org/PhysicalTherapy#Plank_WristIssue
:Plank_WristIssue rdf:type owl:NamedIndividual ;
                  :forCondition :WristIssue ;

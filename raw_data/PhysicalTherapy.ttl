###  http://purl.org/PhysicalTherapy#KneeOsteoarthritis
:KneeOsteoarthritis rdf:type owl:NamedIndividual ,
                             :KneeJointInjury ;
                    :excludesExercise :Deadlift ,
                                      :JumpingJacks ,
                                      :Squads ;
                    :requiresImprovementOf :Hamstrings ,
                                           :KneeJoint ,
                                           :Knees ,
                                           :Quadriceps ;
                    rdfs:comment "Verschleiß des Knorpels im Kniegelenk, der mit zunehmendem Alter Schmerzen und Steifigkeit verursacht."@de ;
                    rdfs:label "KneeOsteoarthritis"@en ,
                               "Kniearthrose"@de .


###  http://purl.org/PhysicalTherapy#Knees
:Knees rdf:type owl:NamedIndividual ,
                :BodyPart ;
       rdfs:comment "Knie als Körperregion, die das Kniegelenk und die umliegenden Strukturen einschließt."@de ;
       rdfs:label "Knees"@en ,
                  "Knie"@de .


###  http://purl.org/PhysicalTherapy#KnieZurBrustDehnung
:KnieZurBrustDehnung rdf:type owl:NamedIndividual ;
                     :engagedBodyPart :Back ,
                                      :Spine ;
                     :hasContraindication :SpineIssue ;
                     :hasDifficultyLevel :Beginner ;
                     :improves :Flexibility ,
                               :Mobility ;
                     :requiresEquipment :None ;
                     :hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht." ;
                     :hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst." ;
                     :hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken." ;
                     :hasDuration "2 Min" ;
                     :hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln.""" ;
                     rdfs:label "Knee to Chest Stretch"@en ,
                                "Knie-zur-Brust-Dehnung"@de .


###  http://purl.org/PhysicalTherapy#KniegelenkMobilisation
:KniegelenkMobilisation rdf:type owl:NamedIndividual ,
                                 :Mobilisation ;
                        :engagedBodyPart :Hamstrings ,
                                         :KneeJoint ,
                                         :Knees ,
                                         :Legs ,
                                         :Quadriceps ;
                        :hasContraindication :KneeIssue ;
                        :hasDifficultyLevel :Beginner ;
                        :improves :Coordination ,
                                  :Flexibility ,
                                  :Mobility ;
                        :rehabilitates :KneeJoint ;
                        :requiresEquipment :Towel ;
                        :hasCommonMistake "Die Ferse wird zu schnell bewegt, das Knie kippt seitlich weg oder die Bewegung wird trotz zunehmender Schmerzen erzwungen." ;
                        :hasCorrectionGuidance "Die Bewegung langsam ausführen und das Knie währenddessen nach oben ausrichten. Nur im schmerzfreien Bewegungsbereich arbeiten. Bei Bedarf den Bewegungsumfang verkleinern." ;
                        :hasDescription "Eine sanfte Mobilisationsübung für das Kniegelenk. Durch das kontrollierte Heranziehen und Wegschieben der Ferse wird die Kniebeugung und Kniestreckung im schmerzfreien Bewegungsbereich trainiert. Das Handtuch reduziert die Reibung auf dem Boden." ;
                        :hasDuration "2 Min" ;
                        :hasInstruction """1. Auf den Rücken legen und beide Beine ausstrecken.
2. Ein Handtuch unter die Ferse des zu trainierenden Beins legen.
3. Die Ferse langsam in Richtung Gesäß ziehen und dabei das Knie beugen.
4. Nur so weit beugen, wie die Bewegung angenehm und schmerzfrei bleibt.
5. Die Position kurz halten.
6. Die Ferse langsam wieder nach vorne schieben und das Bein kontrolliert strecken.
7. Die Bewegung ruhig und gleichmäßig wiederholen.""" ;
                        rdfs:comment "Sanfte Mobilisationsübung zur Verbesserung der Beweglichkeit des Kniegelenks."@de ;
                        rdfs:label "KneeJointMobilisation"@en ,
                                   "Kniegelenk-Mobilisation"@de .


###  http://purl.org/PhysicalTherapy#KniegelenkMobilisation_KneeIssue
:KniegelenkMobilisation_KneeIssue rdf:type owl:NamedIndividual ;
                                  :forCondition :KneeIssue ;
                                  :severity :MediumRisk ;
                                  rdfs:comment "Hinweis auf Knie-Probleme, die bei der Kniegelenk-Mobilisation berücksichtigt werden sollten."@de ;
                                  rdfs:label "KneeJointMobilisation_KneeIssue"@en ,
                                             "Kniegelenk-Mobilisation: Knieschmerzen"@de .


###  http://purl.org/PhysicalTherapy#KubanischeRotation
:KubanischeRotation rdf:type owl:NamedIndividual ,
                             :Strength ;
                    :engagedBodyPart :Shoulders ,
                                     :UpperBack ;
                    :hasContraindication :ShoulderIssue ;
                    :hasDifficultyLevel :Advanced ;
                    :improves :Posture ,
                              :Stability ,
                              :Strength ;
                    :requiresEquipment :None ;
                    :hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert." ;
                    :hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst." ;
                    :hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern." ;
                    :hasDuration "3 Min" ;
                    :hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren.""" ;
                    rdfs:label "Cuban Rotation"@en ,
                               "Kubanische Rotation"@de .



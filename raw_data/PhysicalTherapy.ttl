###  http://purl.org/PhysicalTherapy#PushUps
:PushUps rdf:type owl:NamedIndividual ,
                  :Strength ;
         :engagedBodyPart :Abs ,
                          :Chest ,
                          :Core ,
                          :ShoulderJoint ,
                          :Shoulders ,
                          :SpineJoint ,
                          :Triceps ,
                          :WristJoint ;
         :hasContraindication :AnkleIssue ,
                              :ShoulderIssue ,
                              :WristIssue ;
         :hasDifficultyLevel :Advanced ;
         :improves :Coordination ,
                   :Posture ,
                   :Stability ,
                   :Strength ;
         :rehabilitates :Chest ,
                        :ShoulderJoint ,
                        :Shoulders ,
                        :Triceps ;
         :requiresEquipment :None ;
         :strengthens :Abs ,
                      :Chest ,
                      :FrontDeltoid ,
                      :Triceps ;
         :hasCommonMistake "Das Becken hängt durch, die Ellenbogen gehen zu weit nach außen oder der Kopf wird nach vorne geschoben." ;
         :hasCorrectionGuidance "Rumpf aktiv stabilisieren und die Bewegung langsam ausführen. Bei zu hoher Belastung auf Knie-Liegestütze oder Wall Push Ups ausweichen." ;
         :hasDescription "Kräftigungsübung für Brust, Schultern, Trizeps und Rumpf. Klassische Liegestütze erfordern gute Körperspannung und Schulterkontrolle." ;
         :hasDuration "4 Min" ;
         :hasInstruction """1. In die Liegestützposition kommen.
2. Hände etwas breiter als schulterbreit platzieren.
3. Beine nach hinten ausstrecken und den Körper gerade halten.
4. Den Oberkörper kontrolliert absenken.
5. Ellenbogen leicht schräg nach hinten führen.
6. Den Körper wieder nach oben drücken.
7. Die Bewegung kontrolliert wiederholen.""" ;
         rdfs:comment "Klassische Liegestützübung, die Brust, Schulter und Arme kräftigt."@de ;
         rdfs:label "Liegestütz"@de ,
                    "PushUps"@en .



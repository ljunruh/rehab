###  http://purl.org/PhysicalTherapy#EnBlocBedExit
:EnBlocBedExit rdf:type owl:NamedIndividual ,
                        :DailyRoutine ;
               :hasDailyLifeAdvice "Beim Aufstehen aus dem Bett zunächst auf die Seite rollen, dabei Schultern und Becken gleichzeitig drehen, dann die Beine über die Bettkante schieben und sich mit dem Arm abstützen, um Verdrehungen der Wirbelsäule zu vermeiden." ;
               rdfs:comment "Aufstehen aus dem Bett"@de ;
               rdfs:label "Aufstehen aus dem Bett"@de ,
                          "Aufstehen aus dem Bett en bloc"@de ,
                          "EnBlocBedExit"@en .


###  http://purl.org/PhysicalTherapy#EntspannungInDerKindhaltung
:EntspannungInDerKindhaltung rdf:type owl:NamedIndividual ,
                                      :Relaxation ;
                             :engagedBodyPart :Back ,
                                              :Hip ,
                                              :Shoulders ;
                             :hasContraindication :SpineIssue ;
                             :hasDifficultyLevel :Beginner ;
                             :improves :Mobility ,
                                       :Relaxation ;
                             :requiresEquipment :None ;
                             :hasCommonMistake "Vermeide es, die Schultern hochzuziehen oder die Luft anzuhalten. Lasse stattdessen bewusst los." ;
                             :hasCorrectionGuidance "Atme bewusst in die Position hinein und lasse die Schultern aktiv nach unten sinken." ;
                             :hasDescription "Entspannung in der Kindhaltung ist eine entspannende Ruheposition zur bewussten Wahrnehmung von Körper und Atmung im Bereich Rücken, Schultern, Hüfte." ;
                             :hasDuration "2 Min" ;
                             :hasInstruction """1. In den Kniestand kommen.
2. Gesäß Richtung Fersen absenken.
3. Arme nach vorn ablegen.
4. Ruhig atmen.""" ;
                             rdfs:label "Child's Pose Relaxation"@en ,
                                        "Entspannung in der Kindhaltung"@de .


###  http://purl.org/PhysicalTherapy#EntspannungslageInRueckenlage
:EntspannungslageInRueckenlage rdf:type owl:NamedIndividual ,
                                        :Relaxation ;
                               :engagedBodyPart :Back ,

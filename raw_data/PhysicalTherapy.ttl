      rdfs:label "Wall"@en ,
                 "Wand"@de .


###  http://purl.org/PhysicalTherapy#WallPushUps
:WallPushUps rdf:type owl:NamedIndividual ,
                      :Strength ;
             :engagedBodyPart :Abs ,
                              :Chest ,
                              :ShoulderJoint ,
                              :Shoulders ,
                              :SpineJoint ,
                              :Triceps ,
                              :WristJoint ,
                              :Wrists ;
             :hasContraindication :AnkleIssue ,
                                  :ShoulderIssue ,
                                  :WristIssue ;
             :hasDifficultyLevel :Beginner ;
             :improves :Stability ,
                       :Strength ;
             :rehabilitates :Chest ,
                            :ShoulderJoint ,
                            :Shoulders ,
                            :Triceps ;
             :requiresEquipment :Wall ;
             :strengthens :Abs ,
                          :Chest ,
                          :Shoulders ,
                          :Triceps ;
             :hasCommonMistake "Der Rücken hängt durch, die Schultern werden hochgezogen oder die Ellenbogen gehen stark nach außen." ;
             :hasCorrectionGuidance "Bauch leicht anspannen und den Körper in einer Linie halten. Die Schultern tief halten und die Ellenbogen leicht schräg nach hinten führen." ;
             :hasDescription "Eine vereinfachte Liegestützvariante an der Wand. Die Übung kräftigt Brust, Schultern, Arme und Rumpf mit reduzierter Belastung im Vergleich zu klassischen Liegestützen." ;
             :hasDuration "3 Min" ;
             :hasInstruction """1. Vor eine Wand stellen.
2. Die Hände etwa schulterbreit an die Wand setzen.
3. Die Füße etwas von der Wand entfernen.
4. Den Körper gerade halten.
5. Die Ellenbogen langsam beugen und den Oberkörper zur Wand führen.
6. Kontrolliert zurückdrücken.
7. Die Bewegung ruhig wiederholen.""" ;
             rdfs:comment "Variante des Liegestützes an der Wand, die Brust und Arme sanft kräftigt."@de ;
             rdfs:label "WallPushUps"@en ,
                        "Wandliegestütz"@de .


###  http://purl.org/PhysicalTherapy#Wandengel
:Wandengel rdf:type owl:NamedIndividual ,
                    :Mobilisation ;
           :engagedBodyPart :Shoulders ,
                            :UpperBack ;
           :hasContraindication :ShoulderIssue ;
           :hasDifficultyLevel :Intermediate ;
           :improves :Flexibility ,
                     :Mobility ,
                     :Posture ;
           :requiresEquipment :Wall ;
           :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen langsam und kontrolliert aus." ;
           :hasCorrectionGuidance "Verkleinere den Bewegungsradius und führe die Bewegung langsamer aus. Halte deinen Rumpf dabei ruhig und stabil." ;
           :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität." ;
           :hasDuration "2 Min" ;
           :hasInstruction """1. Lehne deinen Rücken oder deine Unterarme an die Wand.
2. Spanne deinen Rumpf an und halte ihn stabil.
3. Lass deine Arme langsam an der Wand nach oben gleiten.
4. Senke die Arme anschließend kontrolliert wieder ab.""" ;
           rdfs:label "Wall Angels"@en ,
                      "Wandengel"@de .


###  http://purl.org/PhysicalTherapy#WandgleitenMitArmabheben
:WandgleitenMitArmabheben rdf:type owl:NamedIndividual ,
                                   :Coordination ;
                          :engagedBodyPart :Back ,
                                           :Spine ;
                          :hasContraindication :SpineIssue ;
                          :hasDifficultyLevel :Intermediate ;
                          :improves :Coordination ,
                                    :Mobility ,
                                    :Stability ;
                          :requiresEquipment :Wall ;
                          :hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten." ;
                          :hasCorrectionGuidance "Führe die Bewegung langsam und kontrolliert aus. Fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl zur Unterstützung." ;
                          :hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rücken." ;
                          :hasDuration "3 Min" ;
                          :hasInstruction """1. Lehne deinen Rücken oder deine Unterarme an die Wand.
2. Spanne deinen Rumpf an und halte ihn stabil.
3. Lass deine Arme langsam und kontrolliert an der Wand nach oben gleiten.
4. Senke die Arme anschließend kontrolliert wieder ab.""" ;
                          rdfs:label "Wall Slide with Lift Off"@en ,
                                     "Wandgleiten mit Armabheben"@de .


###  http://purl.org/PhysicalTherapy#Wandschieben
:Wandschieben rdf:type owl:NamedIndividual ,
                       :Mobilisation ;
              :engagedBodyPart :Back ,
                               :Spine ;
              :hasContraindication :SpineIssue ;
              :hasDifficultyLevel :Beginner ;
              :improves :Flexibility ,
                        :Mobility ,
                        :Posture ;
              :requiresEquipment :Wall ;
              :hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus." ;
              :hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil." ;
              :hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Rücken mit Schwerpunkt auf mobilität." ;
              :hasDuration "2 Min" ;
              :hasInstruction """1. Rücken oder Unterarme an die Wand bringen.
2. Rumpf stabil halten.
3. Arme langsam nach oben gleiten lassen.
4. Kontrolliert absenken.""" ;
              rdfs:comment "Eine Übung zur Kräftigung und Stabilisierung der Schulter-, Arm- und Rumpfmuskulatur durch kontrolliertes Drücken gegen eine Wand."@de ;
              rdfs:label "Wall Slides"@en ,
                         "Wandschieben"@de .


###  http://purl.org/PhysicalTherapy#Wandsitzen
:Wandsitzen rdf:type owl:NamedIndividual ,
                     :Strength ;
            :engagedBodyPart :Glutes ,
                             :KneeJoint ,
                             :Quadriceps ;
            :hasContraindication :KneeIssue ;
            :hasDifficultyLevel :Beginner ;
            :improves :Stability ,
                      :Strength ;
            :requiresEquipment :Wall ;
            :strengthens :Calves ,
                         :Glutes ,
                         :Hamstrings ,
                         :Quadriceps ;
            :hasDuration "2 Min" ;
            :hasInstruction """1. Mit dem Rücken an eine Wand stellen, die Füße etwa schulterbreit auseinander und einen halben Schritt von der Wand entfernt.
2. Den Rücken langsam an der Wand nach unten gleiten lassen, bis die Oberschenkel ungefähr parallel zum Boden sind.
3. Die Knie ungefähr im rechten Winkel beugen, die Füße bleiben fest am Boden.
4. Den Rücken vollständig an die Wand pressen, den Rumpf aufrichten und die Schultern entspannen.
5. Die Arme locker seitlich an die Wand legen oder auf den Oberschenkeln ablegen.
6. Die Position 20 bis 40 Sekunden halten und ruhig weiteratmen.
7. Mit der Ferse gegen den Boden drücken, um die Oberschenkelmuskulatur zu aktivieren.
8. Den Rücken an der Wand nach oben schieben, um die Position zu beenden.
9. Zwei bis drei Sätze absolvieren und die Haltezeit langsam steigern.""" ;
            rdfs:comment "Statische Halteübung an der Wand mit angewinkelten Beinen, die Oberschenkel kräftigt."@de ;
            rdfs:label "WallSit"@en ,
                       "Wandsitzen"@de .


###  http://purl.org/PhysicalTherapy#Wandsitzen_KneeIssue
:Wandsitzen_KneeIssue rdf:type owl:NamedIndividual ;
                      :forCondition :KneeIssue ;
                      :severity :HighRisk ;
                      rdfs:comment "Hinweis auf Knie-Probleme, die bei dem Wandsitzen berücksichtigt werden sollten."@de ;
                      rdfs:label "WallSit_KneeIssue"@en ,
                                 "Wandsitzen: Knieschmerzen"@de .



@prefix di: <http://reha-app.org/dummy-id/> .
@prefix dv: <http://reha-app.org/dummy-vocab#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

di:dummy_uebung_1 a dv:Activity ;
    rdfs:label "dummy uebung a"@de ;
    dv:involvesBodyPart di:dummy_rechter_arm .

di:dummy_verletzung_schulter a dv:Injury ;
    rdfs:label "schulter-einschränkung"@de ;
    dv:affectsBodyPart di:dummy_rechter_arm .

di:dummy_rechter_arm a dv:BodyPart ;
    rdfs:label "rechter arm"@de .


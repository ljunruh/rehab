pt:hasCondition a owl:ObjectProperty ;
    rdfs:label "hasCondition"^^xsd:string ;
    rdfs:comment "Verknüpft eine Patientenakte mit einer bestehenden Kondition/Diagnose"^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Condition .

pt:hasTrainingsGoal a owl:ObjectProperty ;
    rdfs:label "hasTrainingsGoal"^^xsd:string ;
    rdfs:comment "Desired trainings effect of the session"^^xsd:string ;
    rdfs:domain pt:Session ;
    rdfs:range pt:TrainingsEffect .

pt:isAnswerOf a owl:ObjectProperty ;
    rdfs:label "isAnswerOf"^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Answer .

pt:isAnsweredBy a owl:ObjectProperty ;
    rdfs:label "isAnsweredBy"^^xsd:string ;
    rdfs:domain pt:CompetencyQuestion ;
    rdfs:range pt:Answer .

pt:isContraindicationFor a owl:ObjectProperty ;
    rdfs:label "isContraindicationFor"^^xsd:string ;
    rdfs:comment "Describes the inverse realtionship of hasContraindication object property"^^xsd:string .

pt:isEngagedBy a owl:ObjectProperty ;
    rdfs:label "isEngagedBy"^^xsd:string ;
    rdfs:comment "Describes the inverse realtionship of engagedBodyPart object property"^^xsd:string ;

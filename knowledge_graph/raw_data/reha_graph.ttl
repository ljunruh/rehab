    rdfs:range pt:Asana .

pt:isExaminedBy a owl:ObjectProperty ;
    rdfs:label "isExaminedBy"^^xsd:string ;
    rdfs:domain pt:Joint ;
    rdfs:range pt:MovementExplorationAnswer .

pt:isFocusOf a owl:ObjectProperty ;
    rdfs:label "isFocusOf"^^xsd:string ;
    rdfs:comment "Describes the inverse realtionship of hasFocusOn object property"^^xsd:string ;
    rdfs:domain pt:TrainingsEffect ;
    rdfs:range pt:Asana .

pt:isFulfilledBy a owl:ObjectProperty ;
    rdfs:label "isFulfilledBy"^^xsd:string ;
    rdfs:domain pt:Goal ;
    rdfs:range pt:Exercise .

pt:isImprovedBy a owl:ObjectProperty ;
    rdfs:label "isImprovedBy"^^xsd:string ;
    rdfs:comment "Describes the inverse realtionship of improves object property"^^xsd:string ;
    rdfs:domain pt:TrainingsEffect ;
    rdfs:range pt:Asana .

pt:isInjuryOf a owl:ObjectProperty ;
    rdfs:label "isInjuryOf"^^xsd:string ;
    rdfs:domain pt:Injury ;
    rdfs:range pt:PhysiotherapyRecord .

pt:isRecordOf a owl:ObjectProperty ;
    rdfs:label "isRecordOf"^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Patient .

pt:isRecoveryGoalOf a owl:ObjectProperty ;
    rdfs:label "isRecoveryGoalOf"^^xsd:string ;
    rdfs:domain pt:Goal ;
    rdfs:range pt:PhysiotherapyRecord .

pt:isRehabilitatedBy a owl:ObjectProperty ;
    rdfs:label "isRehabilitatedBy"^^xsd:string ;
    rdfs:domain pt:Exercise ;
    rdfs:range pt:BodyPart .

pt:performedBy a owl:ObjectProperty ;
    rdfs:label "performedBy"^^xsd:string ;
    rdfs:comment "Patient who did the session"^^xsd:string ;
    rdfs:domain pt:Session ;
    rdfs:range pt:Patient .

pt:CompetencyQuestion a owl:Class ;
    rdfs:label "CompetencyQuestion"^^xsd:string ;
    rdfs:comment "Klinische Fragestellung, auf die eine Answer eine Antwort liefert (CQ+Answer-Pattern)"^^xsd:string ;
    rdfs:subClassOf owl:Thing .

pt:Floor a owl:Class ;
    rdfs:label "Boden"^^xsd:string ;
    rdfs:subClassOf pt:Position .

pt:Horizontally a pt:Direction,

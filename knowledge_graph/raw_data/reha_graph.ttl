pt:Asana a owl:Class ;
    rdfs:label "Asana"^^xsd:string ;
    rdfs:comment "Asanas refer to the physical postures or poses practiced in yoga. Derived from the Sanskrit word \"āsana,\" which means \"seat\" or \"posture,\" asanas are designed to align, stretch, strengthen, and balance the body while also fostering focus and relaxation of the mind. Traditionally, asanas were practiced to prepare the body for long periods of meditation, making the body supple and free of discomfort."^^xsd:string ;
    rdfs:subClassOf pt:Yoga .


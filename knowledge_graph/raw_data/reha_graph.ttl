    rdfs:label "Horizontally"^^xsd:string .

pt:Injury a owl:Class ;
    rdfs:label "Injury"^^xsd:string ;
    rdfs:comment "Konkrete Verletzung des Patienten (Spezialisierung von Condition)"^^xsd:string ;
    rdfs:subClassOf pt:Condition .


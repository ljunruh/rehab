    rdfs:comment "improving an trainings effect while performing an asana"^^xsd:string ;
    rdfs:domain pt:Asana ;
    rdfs:range pt:TrainingsEffect ;
    owl:inverseOf pt:isImprovedBy .

pt:engagedBodyPart a owl:ObjectProperty ;

pt:angle a owl:DatatypeProperty ;
    rdfs:label "Angle"^^xsd:string ;
    rdfs:comment "Limb angle in degrees"^^xsd:string ;
    rdfs:domain pt:LimbAlignment ;
    rdfs:range xsd:decimal .

pt:answersQuestion a owl:ObjectProperty ;
    rdfs:label "answersQuestion"^^xsd:string ;
    rdfs:comment "Verknüpft eine Answer mit der CompetencyQuestion, die sie beantwortet"^^xsd:string ;
    rdfs:domain pt:Answer ;
    rdfs:range pt:CompetencyQuestion ;
    owl:inverseOf pt:isAnsweredBy .

pt:avoidsAsana a owl:ObjectProperty ;
    rdfs:label "avoidsAsana"^^xsd:string ;
    rdfs:comment "Avoided Asana from a user"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:Asana .

pt:date a owl:DatatypeProperty ;
    rdfs:label "Date"^^xsd:string ;
    rdfs:comment "Date of the session"^^xsd:string ;
    rdfs:domain pt:Session ;
    rdfs:range rdf:langString .

pt:duration a owl:DatatypeProperty ;
    rdfs:label "Duration"^^xsd:string ;
    rdfs:comment "Duration of the session in minutes"^^xsd:string ;
    rdfs:domain pt:Session ;
    rdfs:range xsd:int .

pt:examinesJoint a owl:ObjectProperty ;
    rdfs:label "examinesJoint"^^xsd:string ;
    rdfs:comment "Gelenk, das im Rahmen einer Bewegungsuntersuchung untersucht wird"^^xsd:string ;
    rdfs:domain pt:MovementExplorationAnswer ;
    rdfs:range pt:Joint ;
    owl:inverseOf pt:isExaminedBy .

pt:fitnessLevelScore a owl:DatatypeProperty ;
    rdfs:label "FitnessLevelScore"^^xsd:string ;
    rdfs:comment "Calculated fitness level of an user"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:isDefinedBy "The Fitness Level Score (FLS) is the calculated fitness level of an user based on the sport activites (MET's), number of sessions per week and the session duration."^^xsd:string .

pt:fulfillsPurpose a owl:ObjectProperty ;
    rdfs:label "fulfillsPurpose"^^xsd:string ;
    rdfs:comment "Verknüpft eine Übung mit dem Rehabilitationsziel (Goal), das sie therapeutisch erfüllt"^^xsd:string ;
    rdfs:domain pt:Exercise ;
    rdfs:range pt:Goal ;
    owl:inverseOf pt:isFulfilledBy .

pt:hasAge a owl:DatatypeProperty ;
    rdfs:label "hasAge"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:integer .

pt:hasAnswer a owl:ObjectProperty ;
    rdfs:label "hasAnswer"^^xsd:string ;
    rdfs:comment "Verknüpft eine Patientenakte mit einer ihrer Antworten (CQ+Answer-Pattern)"^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Answer ;
    owl:inverseOf pt:isAnswerOf .

pt:hasBMI a owl:DatatypeProperty ;
    rdfs:label "hasBMI"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:decimal .

pt:hasGender a owl:DatatypeProperty ;
    rdfs:label "hasGender"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:string .

pt:hasHeight a owl:DatatypeProperty ;
    rdfs:label "hasHeight"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:decimal .

pt:hasInjury a owl:ObjectProperty ;
    rdfs:label "hasInjury"^^xsd:string ;
    rdfs:comment "Verknüpft eine Patientenakte mit einer Verletzung. Sub-Property von hasCondition."^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Injury ;
    rdfs:subPropertyOf pt:hasCondition ;
    owl:inverseOf pt:isInjuryOf .

pt:hasLifestyle a owl:DatatypeProperty ;
    rdfs:label "hasLifestyle"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:string .

pt:hasMETScore a owl:DatatypeProperty ;
    rdfs:label "hasMETScore"^^xsd:string ;
    rdfs:domain pt:SkillsetAnswer ;
    rdfs:range xsd:decimal .

pt:hasMovementType a owl:ObjectProperty ;
    rdfs:label "hasMovementType"^^xsd:string ;
    rdfs:comment "Art der Bewegung in einer Bewegungsuntersuchung (Flexion, Extension, …)"^^xsd:string ;
    rdfs:domain pt:MovementExplorationAnswer ;
    rdfs:range pt:MovementType .

pt:hasName a owl:ObjectProperty ;
    rdfs:label "hasName"^^xsd:string ;
    rdfs:comment "Name of the User"^^xsd:string ;
    rdfs:domain pt:Patient .

pt:hasRecord a owl:ObjectProperty ;
    rdfs:label "hasRecord"^^xsd:string ;
    rdfs:comment "Verknüpft einen Patienten mit seiner Physiotherapie-Akte"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:PhysiotherapyRecord ;
    owl:inverseOf pt:isRecordOf .

pt:hasRecoveryGoal a owl:ObjectProperty ;
    rdfs:label "hasRecoveryGoal"^^xsd:string ;
    rdfs:comment "Verknüpft eine Patientenakte mit einem Rehabilitationsziel (Goal)"^^xsd:string ;
    rdfs:domain pt:PhysiotherapyRecord ;
    rdfs:range pt:Goal ;
    owl:inverseOf pt:isRecoveryGoalOf .

pt:hasRiskFactor a owl:DatatypeProperty ;
    rdfs:label "hasRiskFactor"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:string .

pt:hasTrainingsLevel a owl:ObjectProperty ;
    rdfs:label "hasTrainingsLevel"^^xsd:string ;
    rdfs:comment "Sport level of an User (Beginner, Intermediate or Advanced)"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:TrainingsLevel .

pt:hasVASvalue a owl:DatatypeProperty ;
    rdfs:label "hasVASvalue"^^xsd:string ;
    rdfs:comment "Schmerzintensität auf der Visuellen Analogskala (0.0–10.0)"^^xsd:string ;
    rdfs:domain pt:PainLevelAnswer ;
    rdfs:range xsd:decimal .

pt:hasWeight a owl:DatatypeProperty ;
    rdfs:label "hasWeight"^^xsd:string ;
    rdfs:domain pt:DemographicsAnswer ;
    rdfs:range xsd:decimal .

pt:painOnMotion a owl:DatatypeProperty ;
    rdfs:label "painOnMotion"^^xsd:string ;
    rdfs:domain pt:MovementExplorationAnswer ;
    rdfs:range xsd:boolean .

pt:practicesActivity a owl:ObjectProperty ;
    rdfs:label "practicesActivity"^^xsd:string ;
    rdfs:comment "Activity that an user is doing"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:SportActivity .

pt:prefersBodyArea a owl:ObjectProperty ;
    rdfs:label "prefersBodyArea"^^xsd:string ;
    rdfs:comment "Prefferred body area for training of an user"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:BodyPart .

pt:prefersEffect a owl:ObjectProperty ;
    rdfs:label "prefersEffect"^^xsd:string ;
    rdfs:comment "Preferred trainings effect of an user"^^xsd:string ;
    rdfs:domain pt:Patient ;
    rdfs:range pt:TrainingsEffect .

pt:rangeOfMotion a owl:DatatypeProperty ;
    rdfs:label "rangeOfMotion"^^xsd:string ;
    rdfs:domain pt:MovementExplorationAnswer ;
    rdfs:range xsd:decimal .

pt:rehabilitates a owl:ObjectProperty ;
    rdfs:label "rehabilitates"^^xsd:string ;
    rdfs:comment "Verknüpft eine Übung mit dem Körperteil (BodyPart), den sie therapeutisch rehabilitiert"^^xsd:string ;
    rdfs:domain pt:Exercise ;
    rdfs:range pt:BodyPart ;
    owl:inverseOf pt:isRehabilitatedBy .

pt:severityScore a owl:DatatypeProperty ;
    rdfs:label "SeverityScore"^^xsd:string ;
    rdfs:comment "1.0 >= high risk, 0.5 >= medium risk, 0.2 >= low risk"^^xsd:string ;
    rdfs:domain pt:SeverityLevel ;
    rdfs:isDefinedBy "The severity score is used for measurement for condition risk intensity"^^xsd:string ;
    rdfs:range xsd:decimal .

pt:test a owl:NamedIndividual .

pt:trainsMuscle a owl:ObjectProperty .


pt:Squats a owl:Class ;
    rdfs:subClassOf pt:Strength .

pt:StandingOnCushion a owl:Class ;
    rdfs:label "Stehend auf Kissen"^^xsd:string ;
    rdfs:subClassOf pt:Standing .


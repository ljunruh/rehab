rdfs:label a owl:AnnotationProperty .

pt:AnyPosition a owl:Class ;
    rdfs:label "Beliebig"^^xsd:string ;
    rdfs:subClassOf pt:Position .

pt:Calorie a owl:DatatypeProperty ;
    rdfs:label "Calorie"^^xsd:string ;
    rdfs:comment "In this case we measure burned calories per 60 min for a person with a weight of 150 lbs (68kg)"^^xsd:string ;
    rdfs:domain pt:SportActivity ;
    rdfs:isDefinedBy "A calorie is a unit of energy. In the context of nutrition and human physiology, a calorie refers to the amount of energy that food provides to the body. When consumed, this energy is used by the body to perform essential functions such as breathing, circulating blood, and physical activities."^^xsd:string ;
    rdfs:range pt:Calorie .

pt:Cardio a owl:Class ;
    rdfs:subClassOf pt:Exercise .

pt:ChairSitting a owl:Class ;
    rdfs:label "Sitzen auf Stuhl"^^xsd:string ;
    rdfs:subClassOf pt:Sitting .

pt:HikingHills a pt:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "HikingHills"^^xsd:string ;
    pt:Calorie 536.0 ;
    pt:MET 7.5 .

pt:Kneeling a owl:Class ;
    rdfs:label "Kniestand"^^xsd:string ;
    rdfs:subClassOf pt:Position .

pt:MET a owl:DatatypeProperty ;
    rdfs:label "MET"^^xsd:string ;
    rdfs:comment """1 MET: Sitting quietly (resting energy expenditure).
2 METs: Twice the energy expended at rest (e.g., slow walking).
5 METs: Five times the resting energy expenditure (e.g., moderate jogging)."""^^xsd:string ;
    rdfs:domain pt:SportActivity ;
    rdfs:isDefinedBy "Metabolic Equivalent of Task (MET) is a unit used to estimate the amount of energy expenditure for various physical activities relative to the energy used at rest. 1 MET is defined as the energy cost of sitting quietly and is equivalent to approximately 1 kcal per kilogram of body weight per hour for an average adult. Essentially, it's the baseline rate of energy expenditure when the body is at rest. MET values are used in exercise science to quantify the intensity of activities."^^xsd:string ;
    rdfs:range pt:MET .

pt:MountainClimbing a pt:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "MountainClimbing"^^xsd:string ;
    pt:Calorie 571.0 ;
    pt:MET 8.0 .

pt:MovementType a owl:Class ;
    rdfs:label "MovementType"^^xsd:string ;
    rdfs:comment "Art der Bewegung (Flexion, Extension, Abduktion, Adduktion, Rotation)"^^xsd:string ;
    rdfs:subClassOf pt:ExerciseProperties .

pt:PainLevelAnswer a owl:Class ;
    rdfs:label "PainLevelAnswer"^^xsd:string ;
    rdfs:comment "Schmerzintensität des Patienten, gemessen als VAS-Wert (0.0–10.0)"^^xsd:string ;
    rdfs:subClassOf pt:Answer .

pt:PlayingPiano a pt:SportActivity,

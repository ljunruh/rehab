    rdfs:comment "Specific body part that gets engaged while perfoming yoga pose"^^xsd:string ;
    rdfs:domain pt:Asana,
        pt:Exercise ;
    rdfs:range pt:BodyPart ;
    owl:inverseOf pt:isEngagedBy .

[] a owl:Axiom ;
    rdfs:comment "The core is actively involved during the execution of Airplane."^^xsd:string ;
    owl:annotatedProperty pt:engagedBodyPart ;
    owl:annotatedSource pt:Airplane ;
    owl:annotatedTarget pt:Core .

[] a owl:Axiom ;
    rdfs:comment "This Contraindication should be considered for practitioners of Airplane to avoid strain or injury."^^xsd:string ;
    owl:annotatedProperty pt:hasContraindication ;
    owl:annotatedSource pt:Airplane ;
    owl:annotatedTarget pt:Airplane_HipIssue .


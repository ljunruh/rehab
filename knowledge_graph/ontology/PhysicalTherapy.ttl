    rdfs:label "Achillessehnenentzündung"@de,
        "AchillesTendinitis"@en ;
    rdfs:comment "Reizung oder Entzündung der Achillessehne, meist durch Überlastung beim Laufen oder Springen."@de .

ns1:Adductors a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Adduktoren"@de,
        "Adductors"@en ;
    ns1:isEngagedBy ns1:SitzenStehen,
        ns1:Squads ;
    ns1:partOf ns1:Thighs ;
    rdfs:comment "Adduktoren, die Muskelgruppe an der Innenseite des Oberschenkels."@de .

ns1:AerobicDance a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Aerobic-Tanz"@de,
        "AerobicDance"@en ;

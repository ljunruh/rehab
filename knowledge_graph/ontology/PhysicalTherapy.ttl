ns1:Tischgleiten a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Tischgleiten"@de,
        "Table Slides"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Vor einen Tisch setzen.
2. Hände auf ein Tuch legen.
3. Hände nach vorn gleiten lassen.
4. Ohne Schulterhochziehen zurückkehren."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:Trampoline a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Trampolin"@de,
        "Trampoline"@en ;
    ns1:Calorie 250.0 ;
    ns1:MET 3.5 .

ns1:TrapezmuskelDehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Trapezmuskel-Dehnung"@de,
        "Upper Trapezius Stretch"@en ;
    ns1:engagedBodyPart ns1:Neck,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Federn, die Luft anhalten oder bis in einen spürbaren Schmerz hinein dehnen."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Ruhig weiteratmen und die Position nur bis zu einem deutlichen, aber angenehmen Ziehen halten."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Nacken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "1 Min"^^xsd:string ;
    ns1:hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None .

ns1:TricepsStretch_ShoulderIssue a owl:NamedIndividual ;
    rdfs:label "Trizepsdehnung: Schulterproblem"@de,
        "TricepsStretch_ShoulderIssue"@en ;
    ns1:forCondition ns1:ShoulderIssue ;
    ns1:severity ns1:LowRisk ;
    rdfs:comment "Hinweis auf Schulter-Probleme, die bei der Trizeps-Dehnung berücksichtigt werden sollten."@de .

ns1:TriggerpunktmassageDerGesaessmuskulatur a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Triggerpunktmassage der Gesäßmuskulatur"@de,
        "Glute Trigger Point Release"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip ;
    ns1:hasCommonMistake "Zu starker Druck oder ein Rollen direkt über Knochen und Gelenke."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue ;
    ns1:hasCorrectionGuidance "Den Druck reduzieren, langsam arbeiten und empfindliche Strukturen wie Knochen und Gelenke gezielt aussparen."^^xsd:string ;
    ns1:hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Gesäß."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:TrizepsDehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Trizeps-Dehnung"@de,
        "Triceps Stretch"@en ;
    ns1:engagedBodyPart ns1:Arms,
        ns1:Shoulders,
        ns1:Triceps ;
    ns1:hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Trizeps."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder aufrecht auf einem Stuhl sitzen, die Füße hüftbreit.
2. Einen Arm seitlich am Körper hängen lassen, dann den Oberarm anheben und den Ellbogen beugen.
3. Die Hand des angehobenen Arms auf den oberen Rücken legen, zwischen die Schulterblätter.
4. Mit der anderen Hand sanft den angehobenen Ellbogen in Richtung Kopf ziehen.
5. Den Nacken lang lassen, die Schulter entspannt nach unten halten und nicht hochziehen.
6. Die Dehnung 20 bis 30 Sekunden halten und gleichmäßig weiteratmen.
7. Den Arm langsam lösen und die Seite wechseln.
8. Pro Seite 2 bis 3 Wiederholungen durchführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Dehnübung für den Trizeps an der Rückseite des Oberarms."@de .

ns1:TurkishGetUp a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Turkish Get-up"@de,
        "Turkish Get-up"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core,
        ns1:Legs,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Das Gleichgewicht durch hektische Ausgleichsbewegungen verlieren, statt ruhig gegenzusteuern."^^xsd:string ;
    ns1:hasContraindication ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung verlangsamen, einen festen Punkt fixieren und bei Bedarf eine Wand oder einen Stuhl als Stütze nutzen."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Rückenlage mit Gewicht starten.
2. Arm senkrecht stabil halten.
3. Die Aufstehphasen kontrolliert nacheinander ausführen.
4. In umgekehrter Reihenfolge zurückkehren."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:Dumble .

ns1:UmgekehrterUnterarmstuetz a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Umgekehrter Unterarmstütz"@de,
        "Reverse Plank"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Die Rumpfspannung verlieren und die Bewegung mit Schwung statt kontrolliert ausführen."^^xsd:string ;
    ns1:hasContraindication ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Das Tempo verlangsamen, die Wirbelsäule neutral ausrichten und die Belastung erst bei sauberer Technik steigern."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Stützposition einnehmen.
2. Bauch und Gesäß anspannen.
3. Körper in einer stabilen Linie halten.
4. Ruhig atmen und kontrolliert lösen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None .


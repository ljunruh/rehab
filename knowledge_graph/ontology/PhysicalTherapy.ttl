    ns1:requiresEquipment ns1:Theraband .

ns1:Sciatica a ns1:SpinePain,
        owl:NamedIndividual ;
    rdfs:label "Ischias"@de,
        "Sciatica"@en ;
    ns1:excludesExercise ns1:HamstringStretch,
        ns1:LegRaise ;
    ns1:requiresImprovementOf ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack ;
    rdfs:comment "Schmerz entlang des Ischiasnervs vom unteren Rücken bis ins Bein, oft durch eine Nervenreizung verursacht."@de .

ns1:SealStretch a ns1:MobilisationStretching,
        ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Robben-Dehnung"@de,
        "SealStretch"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Chest,
        ns1:Core,
        ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:Psoas,
        ns1:ShoulderJoint,
        ns1:Spine,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Die Schultern werden hochgezogen, die Ellenbogen werden durchgedrückt oder die Bewegung wird trotz Rückenschmerzen erzwungen."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue,
        ns1:LowerBackIssue,
        ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Die Arme nur so weit strecken, wie es angenehm ist. Schultern tief halten und bei Druck im unteren Rücken die Höhe reduzieren."^^xsd:string ;
    ns1:hasDescription "Mobilisations- und Dehnübung für die vordere Rumpfseite und die Wirbelsäulenstreckung. Die Übung wird häufig zur sanften Extension der Wirbelsäule genutzt."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Bauchlage starten.
2. Hände neben oder leicht vor den Schultern aufstützen.
3. Den Oberkörper langsam anheben.
4. Das Becken bleibt möglichst am Boden.
5. Schultern weg von den Ohren halten.
6. Die Position kurz halten und ruhig atmen.
7. Langsam wieder absenken."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:rehabilitates ns1:Abs,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:stretches ns1:Core,
        ns1:Psoas ;
    rdfs:comment "Dehnübung für Brust und vordere Schulter, die typische Sitzhaltungen ausgleicht."@de .

ns1:SegmentaleWirbelsaeulenbeugung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Segmentale Wirbelsäulenbeugung"@de,
        "Segmental Spinal Flexion"@en ;
    ns1:engagedBodyPart ns1:Spine,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen.
2. Kopf und Brustwirbelsäule Wirbel für Wirbel einrollen.
3. Kurz halten.
4. Langsam wieder aufrichten."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:SeitlicheRumpfdehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Seitliche Rumpfdehnung"@de,
        "Side Bend Stretch"@en ;
    ns1:engagedBodyPart ns1:Back,

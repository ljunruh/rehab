    rdfs:comment "Eine Übung zur Kräftigung der Schulter- und oberen Rückenmuskulatur, bei der die Arme kontrolliert in einer Y-Position angehoben werden."@de .

ns1:ZSits rdfs:label "ZSits"@en .

ns1:Zwerchfellatmung a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Zwerchfellatmung"@de,
        "Diaphragmatic Breathing"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core ;
    ns1:hasCommonMistake "Vermeide eine schnelle und flache Atmung in den Brustkorb. Atme stattdessen bewusst und ruhig in den Bauch."^^xsd:string ;
    ns1:hasContraindication ns1:RespiratoryIssue ;
    ns1:hasCorrectionGuidance "Atme bewusst langsamer und versuche, etwas länger auszuatmen als einzuatmen."^^xsd:string ;
    ns1:hasDescription "Zwerchfellatmung ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Lege oder setze dich bequem hin.
2. Lege eine Hand auf deinen Bauch.
3. Atme langsam durch die Nase ein und spüre, wie sich dein Bauch hebt.
4. Atme anschließend ruhig und langsam wieder aus.
."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:angle a owl:DatatypeProperty ;
    rdfs:label "angle"@en ;
    rdfs:comment "Winkel in Grad, der die Stellung eines Gelenks oder Körperteils bei einer Übung beschreibt."@de ;
    rdfs:domain ns1:LimbAlignment ;
    rdfs:range xsd:decimal .

ns1:avoidsAsana a owl:ObjectProperty ;
    rdfs:label "avoidsAsana"@en ;
    rdfs:comment "Yoga-Haltung, die von der Patientin oder dem Patienten gemieden wird."@de ;
    rdfs:domain ns1:Patient ;
    rdfs:range ns1:Asana .

ns1:date a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "Datum, an dem ein Ereignis stattgefunden hat oder geplant ist."@de ;
    rdfs:range xsd:dateTime .

ns1:duration a owl:DatatypeProperty ;
    rdfs:label "duration"@en ;
    rdfs:comment "Zeitliche Dauer einer Trainingseinheit oder eines anderen Ereignisses."@de ;
    rdfs:range xsd:int .

ns1:examinesJoint a owl:ObjectProperty ;
    rdfs:label "examinesJoint"@en ;
    rdfs:comment "Gelenk, das im Rahmen einer Bewegungsuntersuchung untersucht wird"@de ;
    rdfs:range ns1:Joint ;
    owl:inverseOf ns1:isExaminedBy .

ns1:excludesExercise a owl:ObjectProperty ;
    rdfs:label "excludesExercise"@en ;
    rdfs:comment "Schließt die Aufgaben aus, falls in diesem Bereich eine Verletzung gibt"@de ;
    rdfs:domain ns1:Injury ;
    rdfs:range ns1:Exercise ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:fitnessLevelScore a owl:DatatypeProperty ;
    rdfs:label "fitnessLevelScore"@en ;
    rdfs:domain ns1:Patient ;
    rdfs:isDefinedBy "The Fitness Level Score (FLS) is the calculated fitness level of an user based on the sport activites (MET's), number of sessions per week and the session duration."^^xsd:string .

ns1:hasAge a owl:DatatypeProperty ;
    rdfs:label "hasAge"@en ;
    rdfs:range xsd:integer .

ns1:hasBMI a owl:DatatypeProperty ;
    rdfs:label "hasBMI"@en ;
    rdfs:range xsd:decimal .

ns1:hasCommonMistake a owl:DatatypeProperty ;
    rdfs:label "hasCommonMistake"@en ;
    rdfs:comment "Häufige Fehler, die bei der Ausführung einer Übung auftreten."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range xsd:string .

ns1:hasCorrectionGuidance a owl:DatatypeProperty ;
    rdfs:label "hasCorrectionGuidance"@en ;
    rdfs:comment "Hinweise, wie typische Fehler bei einer Übung korrigiert werden können."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range xsd:string .

ns1:hasDailyLifeAdvice a owl:DatatypeProperty ;
    rdfs:label "hasDailyLifeAdvice"@en ;
    rdfs:comment "Empfehlungen, wie gesündere Bewegungsmuster in den Alltag eingebaut werden können."@de ;
    rdfs:domain ns1:Injury ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ns1:hasDateOfOnset a owl:DatatypeProperty ;
    rdfs:label "hasDateOfOnset"@en ;
    rdfs:domain ns1:Injury ;
    rdfs:range xsd:date .

ns1:hasDescription a owl:DatatypeProperty ;
    rdfs:label "hasDescription"@en ;
    rdfs:comment "Kurze Beschreibung einer Übung mit Ziel und Wirkung."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range xsd:string .

ns1:hasDuration a owl:DatatypeProperty ;
    rdfs:label "hasDuration"@en ;
    rdfs:comment "Empfohlene Dauer, wie lange eine Übung ausgeführt werden soll."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range xsd:string .

ns1:hasGender a owl:DatatypeProperty ;
    rdfs:label "hasGender"@en ;
    rdfs:range xsd:string .

ns1:hasHeight a owl:DatatypeProperty ;
    rdfs:label "hasHeight"@en ;
    rdfs:range xsd:decimal .

ns1:hasInjury a owl:ObjectProperty ;
    rdfs:label "hasInjury"@en ;
    rdfs:comment "Verletzung, die bei der Patientin oder dem Patienten vorliegt."@de ;
    rdfs:domain ns1:Patient ;
    rdfs:range ns1:Injury ;
    owl:inverseOf ns1:isInjuryOf .

ns1:hasInstruction a owl:DatatypeProperty ;
    rdfs:label "hasInstruction"@en ;
    rdfs:comment "Schritt-für-Schritt-Anleitung zur Durchführung einer Übung."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range xsd:string .

ns1:hasLifestyle a owl:DatatypeProperty ;
    rdfs:label "hasLifestyle"@en ;
    rdfs:range xsd:string .

ns1:hasMETScore a owl:DatatypeProperty ;
    rdfs:label "hasMETScore"@en ;
    rdfs:comment "Intensitätswert einer Aktivität, ausgedrückt in metabolischen Äquivalenten."@de ;
    rdfs:domain ns1:Patient ;
    rdfs:range xsd:decimal .

ns1:hasRiskFactor a owl:DatatypeProperty ;
    rdfs:label "hasRiskFactor"@en ;
    rdfs:range xsd:string .

ns1:hasSeverityScore a owl:DatatypeProperty ;
    rdfs:label "hasSeverityScore"@en ;
    rdfs:domain ns1:Injury ;
    rdfs:range xsd:decimal .

ns1:hasTrainingEffect a owl:ObjectProperty ;
    rdfs:label "hasTrainingEffect"@en ;
    rdfs:comment "Trainingseffekt, den die Übung erzielt."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range ns1:TrainingsEffect .

ns1:hasTrainingsLevel a owl:ObjectProperty ;
    rdfs:label "hasTrainingsLevel"@en ;
    rdfs:comment "Trainingsstand der Patientin oder des Patienten."@de ;
    rdfs:domain ns1:Patient ;
    rdfs:range ns1:TrainingsLevel .

ns1:hasVASvalue a owl:DatatypeProperty ;
    rdfs:label "hasVASvalue"@en ;
    rdfs:range xsd:decimal .

ns1:hasWeight a owl:DatatypeProperty ;
    rdfs:label "hasWeight"@en ;
    rdfs:range xsd:decimal .

ns1:isRehabilitatedBy a owl:ObjectProperty ;
    rdfs:label "isRehabilitatedBy"@en ;
    rdfs:comment "Übung, die das Körperteil gezielt wiederherstellt."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range ns1:BodyPart ;
    owl:inverseOf ns1:rehabilitates .

ns1:painOnMotion a owl:DatatypeProperty ;
    rdfs:label "painOnMotion"@en ;
    rdfs:range xsd:boolean .

ns1:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "partOf"@en ;
    rdfs:comment "Übergeordnetes Körperteil, dem dieses Körperteil angehört."@de ;
    rdfs:domain ns1:BodyPart ;
    rdfs:range ns1:BodyPart .

ns1:rangeOfMotion a owl:DatatypeProperty ;
    rdfs:label "rangeOfMotion"@en ;
    rdfs:range xsd:decimal .

ns1:recommendedForInjury a owl:ObjectProperty ;
    rdfs:label "recommendedForInjury"@en ;
    rdfs:comment "Verletzung, bei der diese Übung empfohlen wird."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range ns1:Injury ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:recommendsDifficultyLevel a owl:ObjectProperty ;
    rdfs:label "recommendsDifficultyLevel"@en ;
    rdfs:comment "Schwierigkeitsstufe, die für den jeweiligen Trainingsstand empfohlen wird."@de ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:requiresEquipment a owl:ObjectProperty ;
    rdfs:label "requiresEquipment"@en ;
    rdfs:comment "Hilfsmittel, das für die Ausführung der Übung benötigt wird."@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range ns1:Equipment .

ns1:requiresImprovementOf a owl:ObjectProperty ;
    rdfs:label "requiresImprovementOf"@en ;
    rdfs:comment "Körperteil, das bei dieser Verletzung verbessert oder wiederhergestellt werden soll."@de ;
    rdfs:domain ns1:Injury ;
    rdfs:range ns1:BodyPart .

ns1:severityScore a owl:DatatypeProperty ;
    rdfs:label "severityScore"@en ;
    rdfs:comment "Zahlenwert, der die Schwere eines Gesundheitsproblems beschreibt. Werte über 1,0 stehen für hohes Risiko, um 0,5 für mittleres Risiko und ab 0,2 für geringes Risiko."@de ;
    rdfs:domain ns1:SeverityLevel ;
    rdfs:isDefinedBy "The severity score is used for measurement for condition risk intensity"@en ;
    rdfs:range xsd:decimal .

rdfs:label a owl:AnnotationProperty .

ns1:AcuteLowBackPain a ns1:LowerBackPain,
        owl:NamedIndividual ;
    rdfs:label "Akute Kreuzschmerzen"@de,
        "AcuteLowBackPain"@en ;
    ns1:excludesExercise ns1:LegRaise,
        ns1:MountainClimber ;
    ns1:requiresImprovementOf ns1:LowerBack,
        ns1:SpineJoint ;
    rdfs:comment "Plötzlich auftretende Schmerzen im Bereich der Lendenwirbelsäule, oft durch eine falsche Bewegung ausgelöst."@de .

ns1:AnkleFrac a owl:Class ;
    rdfs:label "AnkleFrac"@en ;
    rdfs:comment "Fraktur im Bereich des oberen Sprunggelenkes (Innen- und/oder Außenknöchel), meist durch Umknicken oder Verdrehen des Fußes verursacht."@de ;
    rdfs:subClassOf ns1:Fracture .

ns1:AnkleJointInjury a owl:Class ;
    rdfs:label "AnkleJointInjury"@en ;
    rdfs:comment "Verletzung des Sprunggelenks, häufig Bänderdehnung oder Bänderriss durch Umknicken des Fußes."@de ;
    rdfs:subClassOf ns1:JointInjury .

ns1:AnkleMuscleInjury a owl:Class ;
    rdfs:label "AnkleMuscleInjury"@en ;
    rdfs:comment "Muskelverletzung im Bereich des Sprunggelenks, etwa eine Muskelzerrung oder ein Muskelfaserriss."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:Archery a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Bogenschießen"@de,
        "Archery"@en ;
    ns1:Calorie 250.0 ;
    ns1:MET 3.5 .

ns1:ArmMuscleInjury a owl:Class ;
    rdfs:label "ArmMuscleInjury"@en ;
    rdfs:comment "Verletzung eines Armmuskels, typischerweise als Muskelzerrung, Muskelfaserriss oder Muskelriss."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:AssistedShoulderRotation a ns1:CoordinationMobility,
        ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Assistierte Schulterrotation"@de,
        "AssistedShoulderRotation"@en ;
    ns1:engagedBodyPart ns1:Arms,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Bewegung wird zu stark gezogen, der Ellenbogen entfernt sich vom Körper oder der Oberkörper dreht mit."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Den Ellenbogen stabil am Körper halten und nur sanften Druck verwenden. Der Bewegungsbereich soll schmerzfrei bleiben."^^xsd:string ;
    ns1:hasDescription "Sanfte Mobilisationsübung für die Schulterrotation mit Unterstützung durch die andere Hand, einen Stab oder ein Hilfsmittel. Sie verbessert die kontrollierte Beweglichkeit der Schulter."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht sitzen oder stehen.
2. Den Ellenbogen des zu bewegenden Arms nah am Körper halten.
3. Einen Stab oder die andere Hand zur Unterstützung verwenden.
4. Den Unterarm langsam in die gewünschte Rotationsrichtung bewegen.
5. Die Bewegung nur passiv oder leicht aktiv unterstützen.
6. Kurz halten und langsam zurückführen.
7. Mehrmals kontrolliert wiederholen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Flexibility,
        ns1:Mobility ;
    ns1:rehabilitates ns1:RotatorCuffs,
        ns1:ShoulderJoint ;
    ns1:requiresEquipment ns1:Stick ;
    rdfs:comment "Sanfte Mobilisationsübung für die Schulterrotation mit Unterstützung durch die andere Hand oder einen Stab."@de .

ns1:BackMuscleInjury a owl:Class ;
    rdfs:label "BackMuscleInjury"@en ;
    rdfs:comment "Verletzung der Rückenmuskulatur, meist Muskelzerrung oder -riss durch Überlastung oder Fehlhaltung."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:Bruecke_LowerBackIssue a owl:NamedIndividual ;
    rdfs:label "Brücke: Problem im unteren Rücken"@de,
        "Bridge_LowerBackIssue"@en ;
    ns1:forCondition ns1:LowerBackIssue ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Beschwerden im unteren Rücken, die bei der Brücke berücksichtigt werden sollten."@de .

ns1:Cardio a owl:Class ;
    rdfs:label "Cardio"@en ;
    rdfs:comment "Aerobe Übung, die Herzfrequenz und Atmung erhöht, um die kardiovaskuläre Ausdauer zu verbessern."@de ;
    rdfs:subClassOf ns1:Exercise .

ns1:DeadBug_LowerBackIssue a owl:NamedIndividual ;
    rdfs:label "Toter Käfer: Problem im unteren Rücken"@de,
        "DeadBug_LowerBackIssue"@en ;
    ns1:forCondition ns1:LowerBackIssue ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Beschwerden im unteren Rücken, die bei der Toten-Käfer-Übung berücksichtigt werden sollten."@de .

ns1:Door a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Türrahmen"@de,
        "Door"@en ;
    rdfs:comment "Tür als Hilfsmittel, um Übungen wie Dehnungen an einem festen Rahmen auszuführen."@de .

ns1:GewichtsverlagerungSeitlich_BalanceIssue a owl:NamedIndividual ;
    rdfs:label "Seitliche Gewichtsverlagerung: Gleichgewichtsproblem"@de,
        "LateralWeightShift_BalanceIssue"@en ;
    ns1:forCondition ns1:BalanceIssue ;
    ns1:severity ns1:LowRisk ;
    rdfs:comment "Hinweis auf Gleichgewichts-Probleme, die bei der seitlichen Gewichtsverlagerung berücksichtigt werden sollten."@de .

ns1:GleichgewichtInstabil_AnkleIssue a owl:NamedIndividual ;
    rdfs:label "Gleichgewicht auf instabilem Untergrund: Sprunggelenkproblem"@de,
        "UnstableBalance_AnkleIssue"@en ;
    ns1:forCondition ns1:AnkleIssue ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Sprunggelenk-Probleme, die bei der Gleichgewichtsübung auf instabilem Untergrund berücksichtigt werden sollten."@de .

ns1:GleichgewichtInstabil_BalanceIssue a owl:NamedIndividual ;
    rdfs:label "Gleichgewicht auf instabilem Untergrund: Gleichgewichtsproblem"@de,
        "UnstableBalance_BalanceIssue"@en ;
    ns1:forCondition ns1:BalanceIssue ;
    ns1:severity ns1:HighRisk ;
    rdfs:comment "Hinweis auf Gleichgewichts-Probleme, die bei der Gleichgewichtsübung auf instabilem Untergrund berücksichtigt werden sollten."@de .

ns1:HipFrac a owl:Class ;
    rdfs:label "HipFrac"@en ;
    rdfs:comment "Bruch des Oberschenkelhalses, meist durch Sturz auf die Hüfte, häufig bei älteren Menschen mit Osteoporose."@de ;
    rdfs:subClassOf ns1:Fracture .

ns1:KneeFrac a owl:Class ;
    rdfs:label "KneeFrac"@en ;
    rdfs:comment "Knochenbruch im Bereich des Kniegelenks, etwa der Kniescheibe oder des Schienbeinkopfes."@de ;
    rdfs:subClassOf ns1:Fracture .

ns1:KniegelenkMobilisation a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Kniegelenk-Mobilisation"@de,
        "KneeJointMobilisation"@en ;
    ns1:engagedBodyPart ns1:Hamstrings,
        ns1:KneeJoint,
        ns1:Knees,
        ns1:Legs,
        ns1:Quadriceps ;
    ns1:hasCommonMistake "Die Ferse wird zu schnell bewegt, das Knie kippt seitlich weg oder die Bewegung wird trotz zunehmender Schmerzen erzwungen."^^xsd:string ;
    ns1:hasContraindication ns1:KneeIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung langsam ausführen und das Knie währenddessen nach oben ausrichten. Nur im schmerzfreien Bewegungsbereich arbeiten. Bei Bedarf den Bewegungsumfang verkleinern."^^xsd:string ;
    ns1:hasDescription "Eine sanfte Mobilisationsübung für das Kniegelenk. Durch das kontrollierte Heranziehen und Wegschieben der Ferse wird die Kniebeugung und Kniestreckung im schmerzfreien Bewegungsbereich trainiert. Das Handtuch reduziert die Reibung auf dem Boden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen und beide Beine ausstrecken.
2. Ein Handtuch unter die Ferse des zu trainierenden Beins legen.
3. Die Ferse langsam in Richtung Gesäß ziehen und dabei das Knie beugen.
4. Nur so weit beugen, wie die Bewegung angenehm und schmerzfrei bleibt.
5. Die Position kurz halten.
6. Die Ferse langsam wieder nach vorne schieben und das Bein kontrolliert strecken.
7. Die Bewegung ruhig und gleichmäßig wiederholen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Flexibility,
        ns1:Mobility ;
    ns1:rehabilitates ns1:KneeJoint ;
    ns1:requiresEquipment ns1:Towel ;
    rdfs:comment "Sanfte Mobilisationsübung zur Verbesserung der Beweglichkeit des Kniegelenks."@de .

ns1:LatStretch a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Latissimus-Dehnung"@de,
        "LatStretch"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Lats,
        ns1:LowerBack,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Spine,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Schulter wird hochgezogen, der Rücken wird stark verdreht oder die Dehnung wird mit zu viel Kraft erzwungen. Häufig wird außerdem ins Hohlkreuz ausgewichen, statt die Dehnung kontrolliert über den seitlichen Rücken auszuführen."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Die Schulter bewusst locker nach unten sinken lassen und den Bewegungsumfang verkleinern, wenn Schmerzen entstehen. Den Bauch leicht anspannen, damit der untere Rücken stabil bleibt. Die Dehnung soll seitlich am Rücken und unterhalb der Schulter spürbar sein, nicht als stechender Schmerz im Schultergelenk."^^xsd:string ;
    ns1:hasDescription "Eine sanfte Dehnübung für den Latissimus, die Schulterregion und den seitlichen Rücken. Die Übung kann helfen, die Beweglichkeit der Schulter und der Brustwirbelsäule zu verbessern und Spannungen im oberen Rücken zu reduzieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen, sitzen oder in eine stabile Kniestand-Position kommen.
2. Einen Arm nach vorne oder leicht diagonal nach oben ausstrecken.
3. Den Oberkörper langsam zur Gegenseite oder nach hinten unten bewegen, bis eine Dehnung an der seitlichen Rücken- und Schulterregion spürbar ist.
4. Die Schulter entspannt lassen und nicht zu den Ohren ziehen.
5. Die Position ruhig halten und gleichmäßig atmen.
6. Die Dehnung nur im angenehmen, schmerzfreien Bereich ausführen.
7. Langsam in die Ausgangsposition zurückkehren und die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:Lats,
        ns1:ShoulderJoint,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Lats,
        ns1:UpperBack ;
    rdfs:comment "Dehnübung für den breiten Rückenmuskel, die die Beweglichkeit der Schulter verbessert."@de .

ns1:LowerLegMuscleInjury a owl:Class ;
    rdfs:label "LowerLegMuscleInjury"@en ;
    rdfs:comment "Verletzung der Unterschenkelmuskulatur, häufig als Wadenkrampf, Zerrung oder Muskelfaserriss."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:LumbarSpinePain a owl:Class ;
    rdfs:label "LumbarSpinePain"@en ;
    rdfs:comment "Schmerzen in der Lendenwirbelsäule, oft als Lumbalgie oder LWS-Syndrom bezeichnet."@de ;
    rdfs:subClassOf ns1:SpinePain .

ns1:Muschel a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Muschel"@de,
        "ClamShell"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint ;
    ns1:hasContraindication ns1:HipIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Seitenlage auf eine Matte legen, Hüfte und Knie ungefähr 45 Grad angewinkelt.
2. Die Füße übereinander halten, der untere Arm stützt den Kopf.
3. Den oberen Arm locker vor die Brust legen und die obere Hand an der Hüfte positionieren.
4. Die Beckenstellung kontrollieren: Hüfte und Schultern bleiben senkrecht übereinander.
5. Das obere Knie langsam und kontrolliert anheben, die Füße bleiben dabei zusammen.
6. Das Knie am oberen Punkt kurz halten, dann langsam wieder absenken.
7. 10 bis 15 Wiederholungen pro Seite durchführen und die Seite wechseln.
8. Optional ein Theraband knapp über den Knien anbringen, um die Intensität zu steigern."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None,
        ns1:Theraband ;
    ns1:strengthens ns1:Glutes ;
    rdfs:comment "Übung in Seitenlage, bei der das obere Knie wie eine Muschel geöffnet wird, um die Hüftaußenrotatoren zu kräftigen."@de .

ns1:NeckMuscleInjury a owl:Class ;
    rdfs:label "NeckMuscleInjury"@en ;
    rdfs:comment "Verletzung oder Verspannung der Hals- und Nackenmuskulatur, oft durch Fehlhaltung oder Überlastung."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:PiriformisStretch a ns1:MobilisationStretching,
        ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Piriformis-Dehnung"@de,
        "PiriformisStretch"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Das Knie wird stark nach unten gedrückt, der Nacken verspannt oder die Dehnung wird trotz Schmerzen erzwungen."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:LowerBackIssue ;
    ns1:hasCorrectionGuidance "Die Dehnung sanft halten und nicht am Knie ziehen. Kopf und Schultern entspannt ablegen und nur im angenehmen Bereich arbeiten."^^xsd:string ;
    ns1:hasDescription "Dehnübung für die tiefe Gesäßmuskulatur, insbesondere den Piriformis. Sie kann Spannungen im Gesäßbereich reduzieren und die Hüftbeweglichkeit unterstützen."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen.
2. Ein Bein anwinkeln.
3. Den Knöchel des anderen Beins auf den Oberschenkel legen.
4. Das untere Bein langsam zum Körper ziehen.
5. Die Dehnung im Gesäß wahrnehmen.
6. Die Position ruhig halten.
7. Langsam lösen und die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:Glutes,
        ns1:HipJoint,
        ns1:LowerBack ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Glutes,
        ns1:Hip ;
    rdfs:comment "Dehnübung für den Piriformis-Muskel in der tiefen Hüftmuskulatur."@de .

ns1:SchulterNackenEntspannung a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Schulter-Nacken-Entspannung"@de,
        "ShoulderNeckRelaxation"@en ;
    ns1:engagedBodyPart ns1:Neck,
        ns1:NeckJoint,
        ns1:ShoulderJoint,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Die Schultern werden hochgezogen gehalten, der Kopf wird mit der Hand stark zur Seite gezogen oder die Bewegungen werden schnell und ruckartig ausgeführt."^^xsd:string ;
    ns1:hasContraindication ns1:NeckIssue,
        ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Den Nacken lang halten und die Schultern bewusst nach unten entspannen. Nur einen kleinen Bewegungsumfang verwenden, wenn Spannung oder Beschwerden auftreten. Keine kreisenden Vollbewegungen des Kopfes erzwingen."^^xsd:string ;
    ns1:hasDescription "Eine sanfte Bewegungsfolge zur Lockerung der Schulter- und Nackenregion. Sie eignet sich besonders nach längerem Sitzen oder Bildschirmarbeit und verbindet bewusste Atmung mit langsamen Schulter- und Kopfbewegungen."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht sitzen oder stehen und die Arme locker neben dem Körper halten.
2. Die Schultern langsam zu den Ohren anheben.
3. Beim Ausatmen die Schultern bewusst nach unten sinken lassen.
4. Die Schultern langsam nach hinten kreisen.
5. Den Kopf anschließend vorsichtig zu einer Seite neigen, ohne die Schulter anzuheben.
6. Die Position für zwei bis drei ruhige Atemzüge halten.
7. Zur Mitte zurückkehren und die andere Seite ausführen.
8. Zum Abschluss den Kopf langsam nach rechts und links drehen.
9. Alle Bewegungen im schmerzfreien Bereich ausführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:Shoulders ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Sanfte Übungen zur Lockerung verspannter Schulter- und Nackenmuskulatur."@de .

ns1:ShoulderFrac a owl:Class ;
    rdfs:label "ShoulderFrac"@en ;
    rdfs:comment "Bruch des körpernahen Oberarmknochens nahe dem Schultergelenk (Humeruskopffraktur), oft durch Sturz auf die Schulter oder den ausgestreckten Arm."@de ;
    rdfs:subClassOf ns1:Fracture .

ns1:ShoulderMuscleInjury a owl:Class ;
    rdfs:label "ShoulderMuscleInjury"@en ;
    rdfs:comment "Verletzung der Schultermuskulatur, zum Beispiel der Rotatorenmanschette."@de ;
    rdfs:subClassOf ns1:MuscleInjury .

ns1:ThoracicSpinePain a owl:Class ;
    rdfs:label "ThoracicSpinePain"@en ;
    rdfs:comment "Schmerzen in der Brustwirbelsäule (thorakale Dorsalgie oder BWS-Syndrom)."@de ;
    rdfs:subClassOf ns1:SpinePain .

ns1:Towel a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Handtuch"@de,
        "Towel"@en ;
    rdfs:comment "Handtuch als vielseitiges Hilfsmittel für Übungen und zur Unterstützung."@de .

ns1:Wadendehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Wadendehnung"@de,
        "CalfStretch"@en ;
    ns1:engagedBodyPart ns1:AnkleJoint,
        ns1:Ankles,
        ns1:Calves,
        ns1:Legs ;
    ns1:hasCommonMistake "Die hintere Ferse hebt sich vom Boden ab, der Fuß dreht nach außen oder das hintere Knie wird unkontrolliert gebeugt."^^xsd:string ;
    ns1:hasContraindication ns1:AnkleIssue ;
    ns1:hasCorrectionGuidance "Die Ferse bewusst in Richtung Boden drücken und den Fuß gerade ausrichten. Den Abstand zur Wand verkleinern, wenn die Ferse nicht unten bleibt oder die Dehnung zu intensiv ist."^^xsd:string ;
    ns1:hasDescription "Eine Dehnübung für die Wadenmuskulatur und den Bereich des Sprunggelenks. Sie kann die Beweglichkeit des Fußgelenks unterstützen und Spannungen in der Wade reduzieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Vor eine Wand stellen und beide Hände an der Wand abstützen.
2. Ein Bein nach hinten setzen.
3. Die hintere Ferse am Boden lassen.
4. Die Fußspitze des hinteren Beins nach vorne ausrichten.
5. Das vordere Knie leicht beugen.
6. Das Becken langsam nach vorne verlagern.
7. Die Dehnung in der Wade des hinteren Beins halten.
8. Ruhig atmen und anschließend die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:rehabilitates ns1:AnkleJoint ;
    ns1:requiresEquipment ns1:Dumble ;
    ns1:strengthens ns1:Calves ;
    rdfs:comment "Dehnübung für die Wadenmuskulatur, oft an einer Wand oder Stufe ausgeführt."@de .

ns1:WallPushUps a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Wandliegestütz"@de,
        "WallPushUps"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Chest,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:SpineJoint,
        ns1:Triceps,
        ns1:WristJoint,
        ns1:Wrists ;
    ns1:hasCommonMistake "Der Rücken hängt durch, die Schultern werden hochgezogen oder die Ellenbogen gehen stark nach außen."^^xsd:string ;
    ns1:hasContraindication ns1:AnkleIssue,
        ns1:ShoulderIssue,
        ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Bauch leicht anspannen und den Körper in einer Linie halten. Die Schultern tief halten und die Ellenbogen leicht schräg nach hinten führen."^^xsd:string ;
    ns1:hasDescription "Eine vereinfachte Liegestützvariante an der Wand. Die Übung kräftigt Brust, Schultern, Arme und Rumpf mit reduzierter Belastung im Vergleich zu klassischen Liegestützen."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Vor eine Wand stellen.
2. Die Hände etwa schulterbreit an die Wand setzen.
3. Die Füße etwas von der Wand entfernen.
4. Den Körper gerade halten.
5. Die Ellenbogen langsam beugen und den Oberkörper zur Wand führen.
6. Kontrolliert zurückdrücken.
7. Die Bewegung ruhig wiederholen."""^^xsd:string ;
    ns1:improves ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Chest,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Triceps ;
    ns1:requiresEquipment ns1:Wall ;
    ns1:strengthens ns1:Abs,
        ns1:Chest,
        ns1:Shoulders,
        ns1:Triceps ;
    rdfs:comment "Variante des Liegestützes an der Wand, die Brust und Arme sanft kräftigt."@de .

ns1:WristFrac a owl:Class ;
    rdfs:label "WristFrac"@en ;
    rdfs:comment "Bruch der Speiche (Radius) nahe am Handgelenk, die häufigste Fraktur beim Menschen."@de ;
    rdfs:subClassOf ns1:Fracture .

ns1:WristJointInjury a owl:Class ;
    rdfs:label "WristJointInjury"@en ;
    rdfs:comment "Verletzung des Handgelenks, zum Beispiel Bänderdehnung, Bänderriss oder Karpaltunnelsyndrom."@de ;
    rdfs:subClassOf ns1:JointInjury .

ns1:Yoga a ns1:SportActivity,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Yoga"@de,
        "Yoga"@en ;
    ns1:Calorie 214.0 ;
    ns1:MET 3.0 ;
    rdfs:comment "Aus Indien stammende philosophische Lehre mit körperlichen und geistigen Übungen wie Asanas und Pranayama."@de ;
    rdfs:subClassOf ns1:Exercise .

ns1:isContraindicationFor a owl:ObjectProperty ;
    rdfs:label "isContraindicationFor"@en ;
    rdfs:comment "Übung, bei der dieses Ausschlusskriterium beachtet werden muss."@de .

ns1:isEngagedBy a owl:ObjectProperty ;
    rdfs:label "isEngagedBy"@en ;
    rdfs:comment "Übung, die das Körperteil beansprucht."@de ;
    rdfs:domain ns1:BodyPart ;
    rdfs:range ns1:Asana .

ns1:isExaminedBy a owl:ObjectProperty ;
    rdfs:label "isExaminedBy"@en ;
    rdfs:comment "Untersuchung oder Test, mit dem das Gelenk geprüft wird."@de ;
    rdfs:domain ns1:Joint .

ns1:isFocusOf a owl:ObjectProperty ;
    rdfs:label "isFocusOf"@en ;
    rdfs:comment "Übung, die diesen Trainingseffekt gezielt fördert."@de ;
    rdfs:domain ns1:TrainingsEffect ;
    rdfs:range ns1:Asana .

ns1:isImprovedBy a owl:ObjectProperty ;
    rdfs:label "isImprovedBy"@en ;
    rdfs:comment "Übung, die diesen Trainingseffekt verbessert."@de ;
    rdfs:domain ns1:TrainingsEffect ;
    rdfs:range ns1:Asana .

ns1:isInjuryOf a owl:ObjectProperty ;
    rdfs:label "isInjuryOf"@en ;
    rdfs:comment "Patientin oder Patient, die oder der diese Verletzung hat."@de ;
    rdfs:domain ns1:Injury .

ns1:rehabilitates a owl:ObjectProperty ;
    rdfs:label "rehabilitates"@en ;
    rdfs:comment "Verknüpft eine Übung mit dem Körperteil (BodyPart), den sie therapeutisch rehabilitiert"@de ;
    rdfs:domain ns1:Exercise ;
    rdfs:range ns1:BodyPart .

ns1:Atemuebung478 a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Atemübung (4-7-8)"@de,
        "BreathingExercise478"@en ;
    ns1:engagedBodyPart ns1:Chest,
        ns1:Core ;
    ns1:hasCommonMistake "Die Luft wird mit Kraft angehalten, die Schultern werden beim Einatmen hochgezogen oder die Atemphasen werden zu schnell ausgeführt."^^xsd:string ;
    ns1:hasContraindication ns1:RespiratoryIssue ;
    ns1:hasCorrectionGuidance "Nur so tief einatmen und so lange pausieren, wie es angenehm möglich ist. Schultern und Gesicht entspannt lassen. Bei Schwierigkeiten kann zunächst ein kürzerer Rhythmus verwendet werden."^^xsd:string ;
    ns1:hasDescription "Eine kontrollierte Atemübung zur Entspannung und zur bewussten Verlangsamung der Atmung. Die Übung lenkt die Aufmerksamkeit auf einen gleichmäßigen Atemrhythmus und kann im Sitzen oder Liegen durchgeführt werden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string,
        "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. Eine bequeme Sitz- oder Liegeposition einnehmen und die Schultern entspannen.
2. Ruhig durch die Nase einatmen und dabei bis vier zählen.
3. Den Atem ohne starkes Pressen halten und bis sieben zählen.
4. Langsam durch den Mund ausatmen und dabei bis acht zählen.
5. Kurz normal weiteratmen.
6. Den Ablauf drei- bis viermal wiederholen."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Kontrollierte Atemübung zur Entspannung und bewussten Verlangsamung der Atmung."@de .

ns1:BrustwirbelsaeulenRotation a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Brustwirbelsäulen-Rotation"@de,
        "ThoracicSpineRotation"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack,
        ns1:Shoulders,
        ns1:Spine,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Rotation erfolgt hauptsächlich aus dem unteren Rücken, das Becken dreht stark mit oder die Bewegung wird ruckartig ausgeführt."^^xsd:string ;
    ns1:hasContraindication ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Das Becken stabil halten und die Bewegung bewusst aus der Brustwirbelsäule einleiten. Den Bewegungsumfang verkleinern, wenn die Lendenwirbelsäule ausweicht oder Schmerzen auftreten."^^xsd:string ;
    ns1:hasDescription "Eine Mobilisationsübung für die Brustwirbelsäule und den oberen Rücken. Die kontrollierte Rotation kann die Beweglichkeit des Oberkörpers verbessern und Spannungen in der Schulterblatt- und Rückenregion reduzieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht sitzen oder in Seitenlage eine stabile Ausgangsposition einnehmen.
2. Die Wirbelsäule lang halten und die Schultern entspannen.
3. Die Arme vor dem Körper positionieren.
4. Einen Arm langsam nach hinten führen und den Oberkörper mitdrehen.
5. Das Becken möglichst ruhig halten.
6. Der Bewegung mit dem Blick folgen.
7. Die Endposition kurz halten.
8. Langsam in die Ausgangsposition zurückkehren und die andere Seite ausführen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Flexibility,
        ns1:Mobility ;
    ns1:rehabilitates ns1:SpineJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Core,
        ns1:UpperBack ;
    rdfs:comment "Mobilisationsübung für die Brustwirbelsäule mit sanften Drehbewegungen."@de .

ns1:DeadBug a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Toter Käfer"@de,
        "DeadBug"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Core,
        ns1:Hip,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Arm oder Bein werden auf dem Boden abgelegt."^^xsd:string,
        "Der Kopf wird angehoben und der Nacken unnötig angespannt."^^xsd:string,
        "Der untere Rücken hebt sich vom Boden ab und bildet ein Hohlkreuz."^^xsd:string,
        "Die Bauchspannung wird während der Bewegung verloren."^^xsd:string ;
    ns1:hasContraindication ns1:AcuteLowBackPain,
        ns1:DeadBug_LowerBackIssue ;
    ns1:hasCorrectionGuidance "Bei Verlust der Rumpfspannung den Bewegungsumfang verkleinern."^^xsd:string,
        "Den unteren Rücken während der gesamten Bewegung sanft gegen den Boden drücken."^^xsd:string,
        "Die Bewegung langsam und kontrolliert ausführen."^^xsd:string,
        "Kopf und Schultern entspannt auf dem Boden lassen."^^xsd:string,
        "Nur so weit strecken, wie die neutrale Rückenposition gehalten werden kann."^^xsd:string ;
    ns1:hasDescription "Der Dead Bug aktiviert vor allem die tiefe Rumpfmuskulatur, insbesondere den Musculus transversus abdominis. Die Übung unterstützt die Stabilisierung von Wirbelsäule und Becken und trainiert die koordinierte Bewegung von Armen und Beinen bei kontrollierter Rumpfspannung."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen und beide Arme senkrecht zur Decke strecken.
2. Hüfte und Knie ungefähr im 90-Grad-Winkel beugen und die Füße vom Boden anheben.
3. Den unteren Rücken kontrolliert auf dem Boden halten und die Bauchmuskulatur anspannen.
4. Einen Arm langsam hinter den Kopf führen und gleichzeitig das gegenüberliegende Bein in Richtung Boden strecken.
5. Arm und Bein nicht ablegen, sondern einige Zentimeter über dem Boden halten.
6. Die Position für ein bis zwei Atemzüge halten.
7. Arm und Bein langsam in die Ausgangsposition zurückführen.
8. Die Bewegung mit dem anderen Arm und dem anderen Bein wiederholen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Core,
        ns1:LowerBack ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Obliques ;
    rdfs:comment "Übung im Liegen, bei der Arme und Beine gegenläufig bewegt werden, um die tiefe Rumpfmuskulatur zu trainieren."@de .

ns1:Deadlift a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Kreuzheben"@de,
        "Deadlift"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Glutes,
        ns1:Hamstrings,
        ns1:HipJoint,
        ns1:Knees,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Der Rücken rundet sich, die Knie schieben zu weit nach vorne oder das Gewicht wird aus dem unteren Rücken gehoben."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:LowerBackIssue,
        ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung aus der Hüfte einleiten und die Wirbelsäule neutral halten. Mit wenig oder keinem Zusatzgewicht beginnen und den Bewegungsumfang reduzieren."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung für hintere Oberschenkelmuskulatur, Gesäß, Rückenstrecker und Rumpf. Der Fokus liegt auf der Hüftbeugebewegung und einer stabilen Wirbelsäule."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken kontrolliert nach hinten schieben.
4. Den Rücken gerade halten.
5. Den Oberkörper nach vorne neigen, ohne den Rücken zu runden.
6. Über Gesäß und hintere Oberschenkel wieder aufrichten.
7. Die Bewegung langsam wiederholen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Glutes,
        ns1:Hamstrings,
        ns1:HipJoint ;
    ns1:requiresEquipment ns1:Dumble ;
    ns1:strengthens ns1:Abs,
        ns1:Glutes,
        ns1:Hamstrings,
        ns1:LowerBack ;
    rdfs:comment "Kraftübung, bei der ein Gewicht vom Boden gehoben wird und Beine, Gesäß und Rücken gleichmäßig arbeiten."@de .

ns1:LowerBackPain a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Kreuzschmerzen"@de,
        "LowerBackPain"@en ;
    ns1:requiresImprovementOf ns1:LowerBack ;
    rdfs:comment "Schmerzen im Bereich der Lendenwirbelsäule (Kreuzschmerzen, Lumbalgie), häufig durch Muskelverspannungen oder Bandscheibenprobleme."@de ;
    rdfs:subClassOf ns1:BackPain .

ns1:PigeonPose a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Taube"@de,
        "PigeonPose"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:Knees,
        ns1:LowerBack,
        ns1:Psoas ;
    ns1:hasCommonMistake "Das Becken kippt stark zur Seite, das vordere Knie wird unter Druck verdreht oder der Körper wird gewaltsam nach unten gedrückt."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue ;
    ns1:hasCorrectionGuidance "Ein Kissen oder einen Block unter die Hüfte legen, wenn das Becken nicht stabil bleibt. Den Winkel des vorderen Beins verkleinern und die Position sofort verlassen, wenn Knieschmerzen auftreten."^^xsd:string ;
    ns1:hasDescription "Eine vereinfachte Hüftdehnung, die insbesondere Gesäß- und Hüftmuskulatur anspricht. Die Übung kann die Beweglichkeit der Hüfte verbessern und Spannungen in der Gesäßregion reduzieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Im Vierfüßlerstand beginnen.
2. Ein Knie nach vorne in Richtung der gleichseitigen Hand führen.
3. Den Unterschenkel bequem vor dem Körper ablegen.
4. Das andere Bein nach hinten ausstrecken.
5. Das Becken möglichst gerade ausrichten.
6. Den Oberkörper aufrecht halten oder langsam nach vorne absenken.
7. Die Position im schmerzfreien Bereich halten und ruhig atmen.
8. Langsam lösen und die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:HipJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Glutes,
        ns1:LowerBack,
        ns1:Psoas ;
    rdfs:comment "Dehnübung im Sitzen, die die äußere Hüftmuskulatur und den Piriformis-Muskel gezielt dehnt."@de .

ns1:ProgressiveMuskelentspannung a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Progressive Muskelentspannung"@de,
        "ProgressiveMuscleRelaxation"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Core ;
    ns1:hasCommonMistake "Die Muskeln werden zu stark angespannt, der Atem wird angehalten oder einzelne Körperbereiche werden ruckartig belastet."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Nur mit leichter bis mittlerer Kraft anspannen. Schmerzhafte oder verletzte Körperbereiche auslassen. Während der gesamten Übung gleichmäßig atmen und zwischen Anspannung und Entspannung ausreichend Zeit lassen."^^xsd:string ;
    ns1:hasDescription "Eine Entspannungsmethode, bei der verschiedene Muskelgruppen nacheinander bewusst angespannt und anschließend wieder gelöst werden. Dadurch kann der Unterschied zwischen Muskelanspannung und Entspannung deutlicher wahrgenommen werden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. Eine bequeme Sitz- oder Liegeposition einnehmen.
2. Die Augen bei Bedarf schließen und ruhig weiteratmen.
3. Mit den Füßen beginnen und die Muskulatur für ungefähr fünf Sekunden sanft anspannen.
4. Die Spannung vollständig lösen und die Entspannung für mehrere Sekunden wahrnehmen.
5. Danach nacheinander Waden, Oberschenkel, Gesäß, Bauch, Hände, Arme, Schultern und Gesicht anspannen und wieder entspannen.
6. Während des Anspannens weiteratmen und nicht pressen.
7. Nach der letzten Muskelgruppe einige Atemzüge ruhig liegen oder sitzen bleiben.
8. Den Körper langsam wieder bewegen und die Übung beenden."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Entspannungsverfahren, bei dem Muskelgruppen nacheinander bewusst angespannt und wieder gelöst werden."@de .

ns1:Quads a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Quadrizeps"@de,
        "Quads"@en ;
    ns1:isEngagedBy ns1:SitzenStehen,
        ns1:Squads,
        ns1:Wandsitzen ;
    ns1:partOf ns1:Thighs ;
    rdfs:comment "Quadrizeps, die große Muskelgruppe an der Vorderseite des Oberschenkels."@de .

ns1:ThighMuscleInjury a owl:Class ;
    rdfs:label "ThighMuscleInjury"@en ;
    rdfs:comment "Verletzung der Oberschenkelmuskulatur, etwa Hamstring- oder Quadrizepszerrung."@de ;
    rdfs:subClassOf ns1:MuscleInjury .


@prefix ns1: <http://purl.org/PhysicalTherapy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/PhysicalTherapy> a owl:Ontology ;
    owl:versionIRI <http://purl.org/PhysicalTherapy/1.0> .

ns1:ACLTear a ns1:KneeJointInjury,
        owl:NamedIndividual ;
    rdfs:label "Riss des vorderen Kreuzbandes"@de,
        "ACLTear"@en ;
    ns1:excludesExercise ns1:Einbeinstand,
        ns1:FerseZehenGang,
        ns1:GleichgewichtInstabil,
        ns1:JumpingJacks,
        ns1:MountainClimber,
        ns1:SitzenStehen,
        ns1:Squads,
        ns1:Wandsitzen ;
    ns1:requiresImprovementOf ns1:KneeJoint ;
    rdfs:comment "Riss des vorderen Kreuzbandes im Knie, häufig durch abrupte Dreh- oder Stoppbewegungen beim Sport."@de .

ns1:AchillesTendinitis a ns1:TendonInjury,

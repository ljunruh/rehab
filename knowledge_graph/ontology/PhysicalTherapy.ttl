    ns1:Calorie 357.0 ;
    ns1:MET 5.0 .

ns1:BasketballGame a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Basketballspiel"@de,
        "BasketballGame"@en ;
    ns1:Calorie 571.0 ;

ns1:Einbeinstand a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Einbeinstand"@de,
        "SingleLegStand"@en ;
    ns1:engagedBodyPart ns1:AnkleJoint,
        ns1:Ankles,
        ns1:KneeJoint,
        ns1:Knees ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:AnkleIssue,
        ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Beine."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht mit hüftbreitem Stand auf einer stabilen, flachen Unterlage stehen.
2. Das Standbein leicht beugen, das Knie dabei weich halten und nicht durchdrücken.
3. Den Rumpf aufrichten, Schulterblätter nach unten ziehen, Blick auf einen festen Punkt vorne richten.
4. Das andere Bein langsam vom Boden abheben, das Knie leicht gebeugt.
5. Die Position 20 bis 30 Sekunden halten und dabei ruhig weiteratmen.
6. Das Bein kontrolliert wieder abstellen und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen, bei Bedarf anfangs mit Fingerkontakt an einer Stuhllehne oder Wand."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Focus,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Balanceübung, bei der auf einem Bein gestanden wird, um Stabilität und Beinkontrolle zu trainieren."@de .


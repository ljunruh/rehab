ns1:WarriorInstruction a owl:NamedIndividual ;
    rdfs:label "Anleitung für Krieger"@de,
        "WarriorInstruction"@en .

ns1:WheelInstruction a owl:NamedIndividual ;
    rdfs:label "Anleitung für Rad"@de,
        "WheelInstruction"@en .

ns1:Wheel_LowerBackIssue a owl:NamedIndividual ;

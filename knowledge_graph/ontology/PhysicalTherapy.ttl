    ns1:hasDuration "4 Min."^^xsd:string ;
    ns1:hasInstruction """1. In Bauchlage oder leichter Vorbeuge starten.
2. Schulterblätter stabilisieren.
3. Arme in der vorgegebenen Form anheben.
4. Langsam absenken."""^^xsd:string ;
    ns1:improves ns1:Posture,

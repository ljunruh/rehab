ns1:Nackendehnungen a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Nackendehnungen"@de,
        "NeckStretches"@en ;
    ns1:engagedBodyPart ns1:Neck,
        ns1:NeckJoint ;
    ns1:hasCommonMistake "Der Kopf wird mit der Hand stark nach unten gezogen, die Schulter wird angehoben oder die Bewegung erfolgt ruckartig."^^xsd:string ;
    ns1:hasContraindication ns1:NeckIssue ;
    ns1:hasCorrectionGuidance "Nur mit dem Eigengewicht des Kopfes arbeiten und die Schultern entspannt halten. Keine kreisenden Vollbewegungen erzwingen. Bei Schwindel, Taubheit oder ausstrahlendem Schmerz sofort abbrechen."^^xsd:string ;
    ns1:hasDescription "Eine sanfte Dehnübung für die seitliche und hintere Nackenmuskulatur. Sie kann Spannungsgefühle reduzieren, die beispielsweise durch langes Sitzen oder eine statische Bildschirmhaltung entstehen."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht sitzen oder stehen.
2. Die Schultern locker nach unten sinken lassen.
3. Den Kopf langsam zu einer Seite neigen.
4. Das gegenüberliegende Ohr bewegt sich dabei von der Schulter weg.
5. Die Position für mehrere ruhige Atemzüge halten.
Langsam zur Mitte zurückkehren.
6. Die Übung auf der anderen Seite wiederholen.
7. Optional den Kopf leicht nach vorne neigen, um die hintere Nackenregion zu dehnen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    rdfs:comment "Sanfte Dehnübungen für die Hals- und Nackenmuskulatur zur Lockerung von Verspannungen."@de .

ns1:Nackendehnungen_NeckIssue a owl:NamedIndividual ;
    rdfs:label "Nackendehnungen: Nackenproblem"@de,
        "NeckStretches_NeckIssue"@en ;
    ns1:forCondition ns1:NeckIssue ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Nacken-Probleme, die bei den Nackendehnungen berücksichtigt werden sollten."@de .

ns1:NeckStiffness a ns1:NeckMuscleInjury,
        owl:NamedIndividual ;
    rdfs:label "Nackenverspannung"@de,
        "NeckStiffness"@en ;
    rdfs:comment "Verspannung oder Versteifung der Hals- und Nackenmuskulatur, oft durch Fehlhaltung oder Stress."@de .

ns1:OberkoerperrotationImStand a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Oberkörperrotation im Stand"@de,
        "Standing Trunk Rotation"@en ;
    ns1:engagedBodyPart ns1:Spine,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .


ns1:DiagonalesArmUndBeinhebenImVierfuesslerstand a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Diagonales Arm- und Beinheben im Vierfüßlerstand"@de,
        "Quadruped Arm-Leg Reach"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Vierfüßlerstand kommen.
2. Rumpf stabilisieren.
3. Arm und/oder Bein kontrolliert strecken.
4. Ohne Beckenrotation zurückführen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:DislocatedShoulder a ns1:ShoulderJointInjury,
        owl:NamedIndividual ;
    rdfs:label "Schulterluxation"@de,
        "DislocatedShoulder"@en ;
    ns1:excludesExercise ns1:Armkreisen,
        ns1:ChestDoorwayStretch,
        ns1:Dancer,
        ns1:KingDancer,
        ns1:MountainClimber,
        ns1:Plank,
        ns1:PushUps,
        ns1:TherabandAussenrotation,
        ns1:Wheel ;
    ns1:requiresImprovementOf ns1:ShoulderJoint ;
    rdfs:comment "Ausrenkung des Schultergelenks, bei der der Oberarmkopf aus der Gelenkpfanne rutscht."@de .

ns1:Down a owl:NamedIndividual ;
    rdfs:label "Unten"@de,
        "Down"@en ;
    rdfs:comment "Richtungsangabe nach unten für die Ausrichtung von Übungen oder Bewegungen."@de .

ns1:DynamischeUmarmung a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Dynamische Umarmung"@de,
        "Dynamic Hug"@en ;
    ns1:engagedBodyPart ns1:Chest,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Brust."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Theraband hinter dem Rücken führen.
2. Arme leicht gebeugt halten.
3. Hände wie bei einer Umarmung nach vorn führen.
4. Langsam öffnen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:EinarmigerFarmerSWalk a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Einarmiger Farmer Laufen"@de,
        "Single Arm Farmer Carry"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core,
        ns1:Legs,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Das Gleichgewicht durch hektische Ausgleichsbewegungen verlieren, statt ruhig gegenzusteuern."^^xsd:string ;
    ns1:hasContraindication ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung verlangsamen, einen festen Punkt fixieren und bei Bedarf eine Wand oder einen Stuhl als Stütze nutzen."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Gewicht sicher aufnehmen.
2. Aufrecht stehen.
3. Mit stabilem Rumpf kontrolliert gehen.
4. Gewicht sicher absetzen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:Dumble .


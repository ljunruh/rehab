    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Theraband sicher fixieren.
2. Schulter tief halten.
3. Arm kontrolliert nach vorn oder seitlich anheben.
4. Langsam absenken."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:Theraband .

ns1:SchulterblattKontrolluebung a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Schulterblatt-Kontrollübung"@de,
        "Scapular Setting"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Schultern locker lassen.
3. Schulterblätter gezielt in verschiedene Richtungen bewegen.
4. Rumpf ruhig halten."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:SchulterblattUhr_2 a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Schulterblatt-Uhr"@de,
        "Scapular Clock"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Schultern locker lassen.
3. Schulterblätter gezielt in verschiedene Richtungen bewegen.
4. Rumpf ruhig halten."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:SchulterdehnungUeberDenKoerper a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Schulterdehnung über den Körper"@de,
        "Cross Body Shoulder Stretch"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "1 Min"^^xsd:string ;
    ns1:hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None .

ns1:SchulterflexionMitStab a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Schulterflexion mit Stab"@de,
        "Wand Assisted Flexion"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Stab mit beiden Händen halten.
2. Der gesunde Arm führt die Bewegung.
3. Arm langsam anheben.
4. Ohne Schmerz zurückführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:Stick .

ns1:Schulterkreisen a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Schulterkreisen"@de,
        "Shoulder Circles"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Schultern locker lassen.
3. Schulterblätter gezielt in verschiedene Richtungen bewegen.
4. Rumpf ruhig halten."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:Schulterpendel a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Schulterpendel"@de,
        "Shoulder Pendulum"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Oberkörper leicht vorbeugen.
2. Arm locker hängen lassen.
3. Kleine Kreise pendeln.
4. Richtung wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:SchultervorhebenMitTheraband a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Schultervorheben mit Theraband"@de,
        "Shoulder Flexion Band"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern."^^xsd:string ;

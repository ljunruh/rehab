    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Führe die Bewegung langsam und kontrolliert aus. Fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl zur Unterstützung."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Lehne deinen Rücken oder deine Unterarme an die Wand.
2. Spanne deinen Rumpf an und halte ihn stabil.
3. Lass deine Arme langsam und kontrolliert an der Wand nach oben gleiten.
4. Senke die Arme anschließend kontrolliert wieder ab."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:Wall .

ns1:Wandschieben a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Wandschieben"@de,
        "Wall Slides"@en ;
    ns1:engagedBodyPart ns1:Back,

ns1:SleeperDehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Sleeper-Dehnung"@de,
        "Sleeper Stretch"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "1 Min"^^xsd:string ;
    ns1:hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None .

ns1:SleeperMobilisation a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Sleeper-Mobilisation"@de,
        "Sleeper Mobilisation"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ausgangsposition sicher einnehmen.
2. Bewegung langsam und kontrolliert ausführen.
3. Ruhig atmen.
4. Bei Schmerzen abbrechen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .


    rdfs:label "Unterarmbeuger"@de,
        "ForearmFlexors"@en ;
    ns1:isEngagedBy ns1:Plank,
        ns1:PushUps ;
    ns1:partOf ns1:Arms ;
    rdfs:comment "Beugemuskeln des Unterarms, die für das Greifen und Beugen im Handgelenk wichtig sind."@de .

ns1:Forward a owl:NamedIndividual ;
    rdfs:label "Vorwärts"@de,

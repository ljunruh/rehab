        "FrozenShoulder"@en ;
    ns1:excludesExercise ns1:Plank,
        ns1:PushUps,
        ns1:WallPushUps ;
    ns1:requiresImprovementOf ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders ;

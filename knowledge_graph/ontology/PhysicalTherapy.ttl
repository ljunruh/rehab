    rdfs:label "Mittleres Risiko"@de,
        "MediumRisk"@en ;
    ns1:severityScore 0.5 ;
    rdfs:comment "Mittleres Risiko: spürbare Beschwerden oder Einschränkungen, die Aufmerksamkeit erfordern."@de .

ns1:Stability a ns1:TrainingsEffect,
        owl:NamedIndividual ;
    rdfs:label "Stabilität"@de,
        "Stability"@en ;
    rdfs:comment "Stabilität, also die Fähigkeit, den Körper oder einzelne Gelenke ruhig zu halten."@de .

ns1:stretches a owl:ObjectProperty ;
    rdfs:label "stretches"@en ;
    rdfs:comment "Körperteil, das durch die Übung gedehnt wird."@de ;
    rdfs:domain ns1:Asana ;
    rdfs:range ns1:BodyPart .

ns1:Hip a ns1:BodyPart,
        owl:NamedIndividual ;
    rdfs:label "Hüfte"@de,
        "Hip"@en ;
    rdfs:comment "Hüfte als Körperregion, die das Hüftgelenk und die umliegende Muskulatur umfasst."@de .

ns1:hasContraindication a owl:ObjectProperty ;
    rdfs:label "hasContraindication"@en ;
    rdfs:comment "Ausschlusskriterium, das bei der Ausführung der Übung beachtet werden muss."@de ;
    rdfs:domain ns1:Asana,
        ns1:Exercise ;
    rdfs:range ns1:Injury ;
    owl:inverseOf ns1:isContraindicationFor .

ns1:strengthens a owl:ObjectProperty ;
    rdfs:label "strengthens"@en ;
    rdfs:comment "Körperteil, das durch die Übung gekräftigt wird."@de ;
    rdfs:domain ns1:Asana ;
    rdfs:range ns1:BodyPart .

ns1:Mobility a ns1:TrainingsEffect,
        owl:NamedIndividual ;
    rdfs:label "Mobilität"@de,
        "Mobility"@en ;
    rdfs:comment "Mobilität, die Fähigkeit, sich frei und kontrolliert zu bewegen."@de .

ns1:Flexibility a ns1:TrainingsEffect,
        owl:NamedIndividual ;
    rdfs:label "Beweglichkeit"@de,
        "Flexibility"@en ;
    rdfs:comment "Beweglichkeit, also der mögliche Bewegungsumfang von Gelenken und Muskeln."@de .

ns1:limb a owl:ObjectProperty ;
    rdfs:label "limb"@en ;
    rdfs:comment "Körperglied (Arm oder Bein), auf das sich die Ausrichtung bezieht."@de ;
    rdfs:domain ns1:LimbAlignment ;
    rdfs:range ns1:Limb .

ns1:LimbAlignment a owl:Class ;
    rdfs:label "LimbAlignment"@en ;
    rdfs:comment "Beschreibung der räumlichen Ausrichtung von Gliedmaßen in Bezug auf den Körper oder auf benachbarte Gelenke."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:Shoulders a ns1:BodyPart,
        ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Schultern"@de,
        "Shoulders"@en ;
    ns1:isRehabilitatedBy ns1:Armkreisen,
        ns1:AssistedShoulderRotation,
        ns1:Cactus,
        ns1:ChestDoorwayStretch,
        ns1:Dancer,
        ns1:PushUps,
        ns1:ScapulaRetraktion,
        ns1:SchulterNackenEntspannung,
        ns1:StandingBackbend,
        ns1:TherabandAussenrotation ;
    rdfs:comment "Schulter als Körperregion, die Schultergelenk und Schultergürtel umfasst."@de .

ns1:hasLimbAlignment a owl:ObjectProperty ;
    rdfs:label "hasLimbAlignment"@en ;
    rdfs:comment "Ausrichtung von Armen, Beinen oder Rumpf bei einer Yoga-Haltung."@de ;
    rdfs:domain ns1:Asana ;
    rdfs:range ns1:LimbAlignment .

ns1:improves a owl:ObjectProperty ;
    rdfs:label "improves"@en ;
    rdfs:comment "Trainingseffekt, der durch die Übung verbessert wird."@de ;
    rdfs:domain ns1:Asana,
        ns1:Exercise ;
    rdfs:range ns1:TrainingsEffect ;
    owl:inverseOf ns1:isImprovedBy .

ns1:engagedBodyPart a owl:ObjectProperty ;
    rdfs:label "engagedBodyPart"@en ;
    rdfs:comment "Körperteil, das bei einer Übung aktiv beansprucht wird."@de ;
    rdfs:domain ns1:Asana,
        ns1:Exercise ;
    rdfs:range ns1:BodyPart ;
    owl:inverseOf ns1:isEngagedBy .


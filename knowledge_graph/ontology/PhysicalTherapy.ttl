ns1:BallkreisenAnDerWand a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Ballkreisen an der Wand"@de,
        "Ball on Wall Circles"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ball mit der Hand an die Wand drücken.
2. Schulter stabilisieren.
3. Kleine Kreise zeichnen.
4. Richtung und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:Ball,
        ns1:Erhöhung .

ns1:Baseball a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Baseball"@de,

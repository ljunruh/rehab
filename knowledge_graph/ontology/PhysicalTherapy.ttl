ns1:RotatorenmanschettenMassageMitBall a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Rotatorenmanschetten-Massage mit Ball"@de,
        "Rotator Cuff Ball Release"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus."^^xsd:string ;
    ns1:hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:Ball,
        ns1:Erhöhung .

ns1:RudernMitTheraband a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Rudern mit Theraband"@de,
        "Resistance Band Row"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. Theraband sicher befestigen.
2. Rumpf aufrecht halten.
3. Band kontrolliert zum Körper ziehen.
4. Schulterblätter zusammenführen und langsam lösen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:Theraband .

ns1:Rueckenstrecker a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Rückenstrecker"@de,
        "Back Extension"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:LowerBackIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Bauchlage gehen.
2. Rumpf und Gesäß leicht anspannen.
3. Brustbein kontrolliert anheben.
4. Nacken neutral halten und absenken."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None .


    rdfs:subClassOf ns1:JointInjury .

ns1:SprainedAnkle a ns1:AnkleJointInjury,
        owl:NamedIndividual ;
    rdfs:label "Verstauchtes Sprunggelenk"@de,
        "SprainedAnkle"@en ;
    ns1:excludesExercise ns1:Einbeinstand,
        ns1:FerseZehenGang,
        ns1:GleichgewichtInstabil,
        ns1:JumpingJacks,
        ns1:MountainClimber,
        ns1:StandingCalfStretch,
        ns1:Tree,
        ns1:Wadendehnung,
        ns1:Warrior2 ;
    ns1:hasDailyLifeAdvice "Das Sprunggelenk in der akuten Phase nicht unnötig belasten."^^xsd:string ;
    ns1:requiresImprovementOf ns1:AnkleJoint,
        ns1:Balance,
        ns1:Stability ;
    rdfs:comment "Verstauchung des Sprunggelenks durch Überdehnung oder Riss der Bänder nach einem Umknicken."@de .

ns1:Squads_KneeIssue a owl:NamedIndividual ;
    rdfs:label "Kniebeugen: Knieschmerzen"@de,
        "Squads_KneeIssue"@en ;
    ns1:forCondition ns1:KneeIssue ;
    ns1:isContraindicationFor ns1:Squads ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Knie-Probleme, die bei der Kniebeuge berücksichtigt werden sollten."@de .

ns1:StandingCalfStretch_AnkleIssue a owl:NamedIndividual ;
    rdfs:label "Wadendehnung im Stehen: Sprunggelenkproblem"@de,
        "StandingCalfStretch_AnkleIssue"@en ;
    ns1:forCondition ns1:AnkleIssue ;
    ns1:isContraindicationFor ns1:StandingCalfStretch ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Sprunggelenk-Probleme, die bei der Waden-Dehnung im Stehen berücksichtigt werden sollten."@de .

ns1:StandingPelvicTilts a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Beckenkippen im Stehen"@de,
        "StandingPelvicTilts"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Glutes,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Die Bewegung wird aus den Knien oder dem Oberkörper gemacht, statt aus dem Becken. Der Rücken wird stark überstreckt."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung klein halten und bewusst aus dem Becken steuern. Bauch- und Gesäßmuskulatur leicht aktivieren."^^xsd:string ;
    ns1:hasDescription "Kontrollübung für Beckenposition und unteren Rücken. Sie verbessert die Wahrnehmung von Beckenkippung und kann helfen, die Lendenwirbelsäule besser zu kontrollieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken langsam nach vorne kippen.
4. Danach das Becken langsam nach hinten kippen.
5. Die Bewegung klein und kontrolliert ausführen.
6. Den Oberkörper möglichst ruhig halten.
7. Mehrere Wiederholungen langsam durchführen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Posture,
        ns1:Stability ;
    ns1:rehabilitates ns1:HipJoint,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Sanfte Übung im Stehen, die das Becken kippt und die Lendenwirbelsäule mobilisiert."@de .

ns1:Standing_sleeper_stretch a ns1:MobilisationStretching,
        ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Sleeper-Stretch im Stehen"@de,
        "StandingSleeperStretch"@en ;
    ns1:engagedBodyPart ns1:RearDeltoids,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Zu viel Druck wird auf die Schulter gegeben, der Oberkörper dreht mit oder die Bewegung verursacht stechende Schmerzen."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Nur leichten Druck verwenden und die Schulter stabil halten. Die Dehnung muss sanft bleiben. Bei Schmerz den Winkel oder Bewegungsumfang reduzieren."^^xsd:string ;
    ns1:hasDescription "Dehnübung für die hintere Schulterkapsel und die Innenrotation der Schulter. Sie kann die Beweglichkeit der Schulter verbessern, sollte aber sehr kontrolliert ausgeführt werden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Seitlich an eine Wand stellen.
2. Den betroffenen Arm auf Schulterhöhe an die Wand bringen.
3. Den Ellenbogen etwa 90 Grad beugen.
4. Den Unterarm langsam nach unten führen.
5. Eine sanfte Dehnung in der hinteren Schulter spüren.
6. Die Position kurz halten.
7. Langsam lösen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Stability ;
    ns1:rehabilitates ns1:RotatorCuffs,
        ns1:ShoulderJoint ;
    ns1:requiresEquipment ns1:Wall ;
    ns1:stretches ns1:RearDeltoids,
        ns1:RotatorCuffs ;
    rdfs:comment "Dehnübung im Liegen, die die Innenrotation der Schulter sanft verbessert."@de .


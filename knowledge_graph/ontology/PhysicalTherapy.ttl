ns1:Seitstuetz a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Seitstütz"@de,
        "Side Plank"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Stützposition einnehmen.
2. Bauch und Gesäß anspannen.
3. Körper in einer stabilen Linie halten.
4. Ruhig atmen und kontrolliert lösen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None .

ns1:SelbstmassageDerHinterenSchulter a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Selbstmassage der hinteren Schulter"@de,
        "Posterior Shoulder Release"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu starken Druck und rolle nicht direkt über Knochen und Gelenke."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Reduziere den Druck, arbeite langsam und spare empfindliche Strukturen wie Knochen und Gelenke gezielt aus."^^xsd:string ;
    ns1:hasDescription "Selbstmassage zur Lockerung und Durchblutungsförderung im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Zielbereich bequem positionieren.
2. Mit Hand, Ball oder Rolle langsamen Druck ausüben.
3. Empfindliche Punkte kurz halten.
4. Bei stechendem Schmerz abbrechen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .


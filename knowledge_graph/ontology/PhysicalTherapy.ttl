ns1:StandingCalfStretch a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Wadendehnung im Stehen"@de,
        "StandingCalfStretch"@en ;
    ns1:engagedBodyPart ns1:Calves ;
    ns1:hasContraindication ns1:AnkleIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Mit beiden Händen an einer Wand auf Schulterhöhe abstützen, Arme gestreckt.
2. Ein Bein nach hinten setzen, das Knie des hinteren Beins gestreckt halten.
3. Die Ferse des hinteren Fußes fest in den Boden drücken, die Zehen zeigen nach vorne.
4. Das vordere Knie langsam beugen und das Becken nach vorne schieben.
5. Die Dehnung in der Wade des hinteren Beins halten, ohne den Fuß nach außen zu drehen.
6. Die Position 30 Sekunden halten und ruhig weiteratmen.
7. Die Seite wechseln und pro Seite 2 bis 3 Wiederholungen durchführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:Wall ;
    ns1:stretches ns1:Calves ;
    rdfs:comment "Dehnübung für die Wadenmuskulatur im Stehen."@de .


    rdfs:label "Innenbandverletzung am Knie"@de,
        "MCLSprain"@en ;
    ns1:excludesExercise ns1:GleichgewichtInstabil,
        ns1:HueftbeugerDehnung,
        ns1:JumpingJacks,
        ns1:MountainClimber,
        ns1:PigeonPose,
        ns1:SitzenStehen,
        ns1:Squads,
        ns1:Wandsitzen ;
    ns1:requiresImprovementOf ns1:KneeJoint,
        ns1:Stability ;
    rdfs:comment "Verletzung des inneren Seitenbandes am Knie durch eine seitliche Krafteinwirkung auf das Gelenk."@de .


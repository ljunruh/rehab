ns1:BrustwirbelsaeulenRotationImVierfuesslerstand a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Brustwirbelsäulen-Rotation im Vierfüßlerstand"@de,
        "Quadruped Thoracic Rotation"@en ;
    ns1:engagedBodyPart ns1:Spine,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren."""^^xsd:string ;

        "TherabandExternalRotation_ShoulderIssue"@en ;
    ns1:forCondition ns1:ShoulderIssue ;
    ns1:severity ns1:MediumRisk ;
    rdfs:comment "Hinweis auf Schulter-Probleme, die bei der Theraband-Außenrotation berücksichtigt werden sollten."@de .

ns1:ThoracicBackPain a ns1:ThoracicSpinePain,
        owl:NamedIndividual ;
    rdfs:label "Brustwirbelsäulen-Schmerzen"@de,
        "ThoracicBackPain"@en ;
    ns1:excludesExercise ns1:BrustwirbelsaeulenRotation,
        ns1:MountainClimber ;

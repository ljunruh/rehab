ns1:EnBlocBedExit a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Aufstehen aus dem Bett"@de,
        "Aufstehen aus dem Bett en bloc"@de,
        "EnBlocBedExit"@en ;
    ns1:hasDailyLifeAdvice "Beim Aufstehen aus dem Bett zunächst auf die Seite rollen, dabei Schultern und Becken gleichzeitig drehen, dann die Beine über die Bettkante schieben und sich mit dem Arm abstützen, um Verdrehungen der Wirbelsäule zu vermeiden."^^xsd:string ;
    rdfs:comment "Aufstehen aus dem Bett"@de .

ns1:EntspannungInDerKindhaltung a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Entspannung in der Kindhaltung"@de,
        "Child's Pose Relaxation"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Hip,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Vermeide es, die Schultern hochzuziehen oder die Luft anzuhalten. Lasse stattdessen bewusst los."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Atme bewusst in die Position hinein und lasse die Schultern aktiv nach unten sinken."^^xsd:string ;
    ns1:hasDescription "Entspannung in der Kindhaltung ist eine entspannende Ruheposition zur bewussten Wahrnehmung von Körper und Atmung im Bereich Rücken, Schultern, Hüfte."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Kniestand kommen.
2. Gesäß Richtung Fersen absenken.
3. Arme nach vorn ablegen.
4. Ruhig atmen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:EntspannungslageInRueckenlage a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Entspannungslage in Rückenlage"@de,
        "Supine Relaxation Position"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core ;
    ns1:hasCommonMistake "Vermeide es, die Schultern hochzuziehen oder die Luft anzuhalten. Lasse stattdessen bewusst los."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Atme bewusst in die Position hinein und lasse die Schultern aktiv nach unten sinken."^^xsd:string ;
    ns1:hasDescription "Entspannungslage in Rückenlage ist eine entspannende Ruheposition zur bewussten Wahrnehmung von Körper und Atmung im Bereich Rumpf, Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen.
2. Beine bequem aufstellen oder unterlagern.
3. Schultern lösen.
4. Ruhig und gleichmäßig atmen."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:ErgonomicSitting a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Ergonomisches Sitzen"@de,
        "ErgonomicSitting"@en ;
    ns1:hasDailyLifeAdvice "Aufrechte, unterstützte Sitzhaltung mit angepasster Stuhl- und Tischhöhe zur Entlastung von Rücken, Nacken und Schultern."^^xsd:string ;
    rdfs:comment "Ergonomisches Sitzen"@de .

ns1:FacePullMitTheraband a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Face Pull mit Theraband"@de,
        "Face Pull"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Theraband sicher befestigen.
2. Rumpf aufrecht halten.
3. Band kontrolliert zum Körper ziehen.
4. Schulterblätter zusammenführen und langsam lösen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:Theraband .

ns1:FadenDurchDieNadel a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Faden-durch-die-Nadel"@de,
        "Thread the Needle"@en ;
    ns1:engagedBodyPart ns1:Spine,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Oberer Rücken mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ausgangsposition stabil einnehmen.
2. Oberkörper langsam rotieren.
3. Becken möglichst ruhig halten.
4. Kontrolliert zur Mitte zurückkehren."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:FarmerSWalk a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Farmer's Walk"@de,
        "Farmer Carry"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core,
        ns1:Legs,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Gewicht sicher aufnehmen.
2. Aufrecht stehen.
3. Mit stabilem Rumpf kontrolliert gehen.
4. Gewicht sicher absetzen."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:Dumble .

ns1:FaszienrolleRueckenWade a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Faszienrolle für Rücken und Waden"@de,
        "FasciaRollerBackCalf"@en ;
    ns1:engagedBodyPart ns1:Calves,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Zu schnelles Rollen, zu starker Druck, direktes Rollen über Knochen oder Gelenke sowie eine angespannte Körperhaltung."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue,
        ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung langsam ausführen und den Druck über Arme und Beine kontrollieren. Bei stechendem Schmerz, Taubheit oder starkem Unwohlsein sofort stoppen. Nicht direkt über verletzte oder akut entzündete Bereiche rollen."^^xsd:string,
        "Direkter Druck auf Knochen, Gelenke und die Lendenwirbelsäule sollte vermieden werden."^^xsd:string ;
    ns1:hasDescription "Eine Selbstmassage mit der Faszienrolle für verspannte Muskelbereiche des oberen Rückens und der Waden. Durch langsamen, kontrollierten Druck können beanspruchte Muskeln bearbeitet und die Beweglichkeit unterstützt werden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Die Faszienrolle auf eine stabile Unterlage legen.
2. Für den oberen Rücken die Rolle unterhalb der Schulterblätter positionieren und den Oberkörper leicht anheben.
3. Langsam zwischen oberem Rücken und Schulterblattregion vor- und zurückrollen.
4. Nicht direkt über die Wirbelsäule oder den Nacken rollen.
5. Für die Wade im Sitzen die Rolle unter eine Wade legen.
6. Das Bein langsam vom Sprunggelenk bis unterhalb des Knies über die Rolle bewegen.
7. Empfindliche Stellen kurz und mit reduziertem Druck bearbeiten.
8. Anschließend die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:Faszienrolle ;
    rdfs:comment "Selbstmassage mit der Faszienrolle für Rücken und Waden zur Lockerung verspannter Muskulatur."@de .

ns1:FaszienrolleRueckenWade_SpineIssue a owl:NamedIndividual ;
    rdfs:label "Faszienrolle für Rücken und Waden: Wirbelsäulenproblem"@de,
        "FasciaRollerBackCalf_SpineIssue"@en ;
    ns1:forCondition ns1:SpineIssue ;
    ns1:severity ns1:HighRisk ;
    rdfs:comment "Hinweis auf Wirbelsäulen-Probleme, die bei FaszienrolleRueckenWade berücksichtigt werden sollten."@de .


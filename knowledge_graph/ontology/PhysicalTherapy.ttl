        "Severe"@en ;
    rdfs:comment "Starke Ausprägung: ausgeprägte Beschwerden, die den Alltag deutlich einschränken."@de .

ns1:Shoulder a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Schulter"@de,
        "Shoulder"@en ;
    rdfs:comment "Schulterregion, die Schultergelenk und umliegende Muskulatur umfasst."@de .

ns1:ShoulderImpingement a ns1:TendonInjury,
        owl:NamedIndividual ;
    rdfs:label "Schulter-Impingement"@de,
        "ShoulderImpingement"@en ;
    ns1:excludesExercise ns1:Plank,
        ns1:PushUps ;
    ns1:requiresImprovementOf ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders ;
    rdfs:comment "Einklemmung von Sehnen oder Schleimbeutel unter dem Schulterdach, die bei Armbewegungen Schmerzen verursacht."@de .

ns1:ShoulderInstability a ns1:ShoulderJointInjury,
        owl:NamedIndividual ;
    rdfs:label "Schulterinstabilität"@de,
        "ShoulderInstability"@en ;
    ns1:requiresImprovementOf ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders ;
    rdfs:comment "Instabilität des Schultergelenks, oft nach Ausrenkungen oder bei schwacher Gelenkführung."@de .

ns1:ShoulderInternalExternalRotation a ns1:CoordinationMobility,
        ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Innen- und Außenrotation der Schulter"@de,
        "ShoulderInternalExternalRotation"@en ;
    ns1:engagedBodyPart ns1:FrontDeltoid,
        ns1:RearDeltoids,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Der Oberkörper dreht mit, der Ellenbogen wandert nach außen oder die Bewegung wird ruckartig ausgeführt."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Den Ellenbogen nah am Körper halten und die Bewegung nur aus dem Schultergelenk ausführen. Den Bewegungsumfang reduzieren, wenn Ausweichbewegungen entstehen."^^xsd:string ;
    ns1:hasDescription "Mobilisations- und Kontrollübung für Innen- und Außenrotation der Schulter. Die Übung verbessert die Bewegungswahrnehmung und unterstützt die funktionelle Schulterbeweglichkeit."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Den Ellenbogen am Körper halten und etwa 90 Grad beugen.
3. Den Unterarm langsam nach außen rotieren.
4. Anschließend kontrolliert nach innen rotieren.
5. Die Bewegung langsam und schmerzfrei ausführen.
6. Die Schulter während der Bewegung stabil halten"""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:rehabilitates ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders ;
    ns1:requiresEquipment ns1:Theraband ;
    ns1:strengthens ns1:RotatorCuffs ;
    rdfs:comment "Mobilisationsübung für die Innen- und Außenrotation des Schultergelenks."@de .


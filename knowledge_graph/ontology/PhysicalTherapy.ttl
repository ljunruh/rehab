ns1:BasketballShootingBaskets a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Basketball-Korbwurf"@de,
        "BasketballShootingBaskets"@en ;
    ns1:Calorie 321.0 ;
    ns1:MET 4.5 .

ns1:BauchatmungInBauchlage a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Bauchatmung in Bauchlage"@de,
        "Crocodile Breathing"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core ;
    ns1:hasCommonMistake "Vermeide eine schnelle und flache Atmung in den Brustkorb. Atme stattdessen bewusst und ruhig in den Bauch."^^xsd:string ;
    ns1:hasContraindication ns1:RespiratoryIssue ;
    ns1:hasCorrectionGuidance "Verlangsame bewusst das Tempo und lasse die Ausatmung etwas länger werden als die Einatmung."^^xsd:string ;
    ns1:hasDescription "Bauchatmung in Bauchlage ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "5 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Bauchlage legen.
2. Stirn auf den Händen ablegen.
3. In den Bauch und die Flanken atmen.
4. Langsam ausatmen."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:BauchlageKobra a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Bauchlage-Kobra"@de,
        "Prone Cobra"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Verlangsame das Tempo, richte deine Wirbelsäule neutral aus und steigere die Belastung erst, wenn du die Technik sauber ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Bauchlage gehen.
2. Rumpf und Gesäß leicht anspannen.
3. Brustbein kontrolliert anheben.
4. Nacken neutral halten und absenken."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None .

ns1:BeachVolleyball a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Beachvolleyball"@de,
        "BeachVolleyball"@en ;
    ns1:Calorie 571.0 ;
    ns1:MET 8.0 .

ns1:Beckenkippen a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Beckenkippen"@de,
        "Pelvic Tilt"@en ;
    ns1:engagedBodyPart ns1:Hip,
        ns1:Pelvic ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Hüfte mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Rückenlage oder Stand einnehmen.
2. Bauch leicht anspannen.
3. Becken vor- und zurückkippen.
4. Bewegung klein und kontrolliert ausführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:BeckenkontrollUebung a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Beckenkontroll-Übung"@de,
        "Pelvic Control Drill"@en ;
    ns1:engagedBodyPart ns1:Hip,
        ns1:Pelvic ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Hüfte."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ausgangsposition sicher einnehmen.
2. Bewegung langsam und kontrolliert ausführen.
3. Ruhig atmen.
4. Bei Schmerzen abbrechen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:Beckenuhr a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Beckenuhr"@de,
        "Pelvic Clock"@en ;
    ns1:engagedBodyPart ns1:Hip,
        ns1:Pelvic ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen kontrolliert Wirbel für Wirbel oder Grad für Grad aus."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius, drossle das Tempo und halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Hüfte mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In Rückenlage die Beine aufstellen.
2. Das Becken wie auf einem Zifferblatt bewegen.
3. Nacheinander 12, 3, 6 und 9 Uhr ansteuern.
4. Kreise verbinden."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:None .

ns1:BeideKnieZurBrust a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Beide Knie zur Brust"@de,
        "Double Knee to Chest"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None .

ns1:BeinhebenImVierfuesslerstand a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Beinheben im Vierfüßlerstand"@de,
        "Quadruped Leg Reach"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BalanceIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Vierfüßlerstand kommen.
2. Rumpf stabilisieren.
3. Arm und/oder Bein kontrolliert strecken.
4. Ohne Beckenrotation zurückführen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:BicepsStrain a ns1:ArmMuscleInjury,

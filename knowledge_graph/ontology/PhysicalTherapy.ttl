ns1:Wheel_NeckIssue a owl:NamedIndividual ;
    rdfs:label "Rad: Nackenproblem"@de,
        "Wheel_NeckIssue"@en ;
    ns1:forCondition ns1:NeckIssue ;
    ns1:severity ns1:MediumRisk .

ns1:Wheel_ShoulderIssue a owl:NamedIndividual ;
    rdfs:label "Rad: Schulterproblem"@de,
        "Wheel_ShoulderIssue"@en ;
    ns1:forCondition ns1:ShoulderIssue ;
    ns1:severity ns1:HighRisk .

ns1:Wheel_WristIssue a owl:NamedIndividual ;
    rdfs:label "Rad: Handgelenkproblem"@de,
        "Wheel_WristIssue"@en ;
    ns1:forCondition ns1:WristIssue ;
    ns1:severity ns1:HighRisk .

ns1:Z-Sits a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Z-Sitz"@de,
        "ZSits"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:Pelvic ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf eine Matte oder ein gefaltetes Handtuch setzen, die Beine zunächst nach vorne ausstrecken.
2. Das vordere Bein im rechten Winkel nach vorne beugen, den Unterschenkel senkrecht zum Körper halten.
3. Das hintere Bein im rechten Winkel zur gegenüberliegenden Seite beugen, sodass beide Unterschenkel parallel zueinander stehen und die Beine zusammen ein Z bilden.
4. Den Oberkörper aufrecht halten, das Brustbein anheben und die Schultern entspannen.
5. Das Gewicht möglichst gleichmäßig auf beide Sitzknochen verteilen und den unteren Rücken nicht runden.
6. Die Position 30 bis 60 Sekunden halten und ruhig weiteratmen.
7. Die Beine langsam in die Ausgangsstellung zurückführen und die Seite wechseln.
8. Pro Seite 2 bis 3 Wiederholungen durchführen, bei eingeschränkter Beweglichkeit ein Kissen unter die Hüfte legen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Stability ;
    ns1:rehabilitates ns1:HipJoint ;
    ns1:stretches ns1:Glutes,
        ns1:LowerBack ;
    rdfs:comment "Sitzposition mit zur Seite angewinkelten Beinen, die zur Mobilisation der Hüfte eingesetzt wird."@de .

ns1:Ball a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Ball"@de,
        "Ball"@en .

ns1:Bruecke a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Brücke"@de,
        "Bridge"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hamstrings,
        ns1:Hip,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Am häufigsten werden die Hüfte zu hoch gestreckt, der untere Rücken durchgedrückt und die Füße vom Boden abgehoben, wodurch die Gesäßmuskeln ausfallen und die Lendenwirbelsäule belastet wird."^^xsd:string ;
    ns1:hasContraindication ns1:Bruecke_LowerBackIssue ;
    ns1:hasCorrectionGuidance "Füße hüftbreit lassen, Fersen in den Boden drücken, Rippen nach unten ziehen und die Bewegung bewusst aus dem Gesäß statt aus dem Rücken initiieren, bis Ohr, Schulter, Hüfte und Knie eine Linie bilden."^^xsd:string ;
    ns1:hasDescription "Die Brücke ist eine Rückenlage-Übung, bei der du die Hüfte durch Anspannen des Gesäßes anhebst und so Gesäß, Beinrückseite und Rumpf stabilisierend trainierst."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Rückenlage, Knie angewinkelt, Füße hüftbreit und flach auf dem Boden.
2. Arme entspannt seitlich am Körper ablegen, Handflächen nach oben.
3. Core aktivieren und den unteren Rücken sanft in den Boden drücken.
4. Gesäß fest anspannen und die Hüfte kontrolliert nach oben schieben.
5. Am oberen Punkt bilden Schulter, Hüfte und Knie eine Linie, Pobacken oben richtig zusammendrücken.
6. Position kurz halten, dann die Hüfte langsam und kontrolliert wieder absenken."""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Spine ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Glutes,
        ns1:LowerBack ;
    rdfs:comment "Übung im Liegen, bei der das Becken angehoben wird, um Gesäß, hintere Oberschenkel und Rumpf zu kräftigen."@de .

ns1:DifficultyLevel a owl:Class ;
    rdfs:label "DifficultyLevel"@en ;
    rdfs:comment "Einstufung des Schwierigkeitsgrads einer Übung, die den Grad der körperlichen, koordinativen und konditionellen Anforderungen beschreibt."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:Erhöhung a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Erhöhung"@de,
        "Elevation"@en ;
    rdfs:comment "Erhöhung oder Stufe, die als Trainingsgerät für Balance- und Kraftübungen dient."@de .

ns1:FigureFourStretch a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Vierer-Dehnung"@de,
        "FigureFourStretch"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hip ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen, beide Knie anwinkeln und die Füße flach auf den Boden stellen.
2. Den äußeren Knöchel eines Fußes auf das gegenüberliegende Knie legen, sodass die Beine eine Vier bilden.
3. Die Hände hinter dem Oberschenkel des unten liegenden Beins verschränken.
4. Das untere Bein langsam in Richtung Brust ziehen, bis eine sanfte Dehnung in Gesäß und Hüfte spürbar ist.
5. Die Position 20 bis 30 Sekunden halten und gleichmäßig weiteratmen.
6. Langsam in die Ausgangsposition zurückkehren und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Glutes,
        ns1:Hip ;
    rdfs:comment "Dehnübung im Liegen, bei der ein Fuß über das gegenseitige Knie gelegt wird, um die Hüftaußenrotatoren zu dehnen."@de .

ns1:GleichgewichtInstabil a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Gleichgewicht auf instabilem Untergrund"@de,
        "UnstableBalance"@en ;
    ns1:engagedBodyPart ns1:AnkleJoint,
        ns1:Ankles,
        ns1:Core ;
    ns1:hasContraindication ns1:GleichgewichtInstabil_AnkleIssue,
        ns1:GleichgewichtInstabil_BalanceIssue ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Eine weiche, instabile Unterlage wie ein Balancekissen oder Schaumstoffpad auf eine rutschfeste Fläche legen.
2. Aufrecht neben einer stabilen Stütze wie einer Küchenzeile stehen und sich anfangs mit den Fingerspitzen festhalten.
3. Beide Füße hüftbreit auf die Unterlage stellen, das Gewicht gleichmäßig verteilen.
4. Rumpf aufrichten, Schultern entspannen, Blick geradeaus richten.
5. Die Position 30 Sekunden halten und das Gleichgewicht halten.
6. Kleine Gewichtsverlagerungen nach vorne, hinten und zur Seite ausprobieren, ohne den Stand zu verlieren.
7. Mit zunehmender Sicherheit den Fingerkontakt lösen, später optional ein Bein anheben.
8. Übung mit langen Pausen über zwei Minuten wiederholen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Übung auf instabilem Untergrund, die Gleichgewicht und tiefe Stabilisationsmuskulatur anspricht."@de .

ns1:MonsterWalk a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Monster-Walk"@de,
        "MonsterWalk"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:Legs,
        ns1:Quadriceps ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Ein leichtes Theraband knapp über den Knien um beide Oberschenkel legen.
2. Aufrecht in Schrittstellung hinstellen, die Füße etwas weiter als hüftbreit auseinander.
3. Die Knie bewusst nach außen drücken, sodass das Band unter Spannung bleibt.
4. Die Hüfte leicht beugen und das Gesäß anspannen.
5. Mit kleinen, bewussten Schritten seitlich nach rechts gehen und dabei das Band gespannt halten.
6. Eine bestimmte Strecke in eine Richtung gehen, dann wenden und zur anderen Seite laufen.
7. Anschließend in Vor- und Rückwärtsrichtung mit kleinen Schritten wiederholen.
8. Pro Richtung 10 bis 20 Schritte ausführen und das Band nicht zu leicht wählen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:HipJoint ;
    ns1:requiresEquipment ns1:Theraband ;
    ns1:strengthens ns1:Core,
        ns1:Glutes,
        ns1:Quadriceps ;
    rdfs:comment "Gangübung mit deutlich angehobenen Knien zur Kräftigung von Hüfte und Oberschenkeln."@de .

ns1:ScapulaRetraktion a ns1:CoordinationMobility,
        ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Skapula-Retraktion"@de,
        "ScapulaRetraction"@en ;
    ns1:engagedBodyPart ns1:RearDeltoids,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Spine,
        ns1:SpineJoint,
        ns1:Trapezius,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Bewegung wird ruckartig ausgeführt."^^xsd:string,
        "Die Schultern werden zu den Ohren gezogen."^^xsd:string,
        "Es entsteht ein starkes Hohlkreuz."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Den Brustkorb nicht übermäßig nach vorne schieben."^^xsd:string,
        "Die Bewegung langsam und nur im schmerzfreien Bereich ausführen."^^xsd:string,
        "Nacken lang und Schultern entspannt halten."^^xsd:string ;
    ns1:hasDescription "Kräftigt die Muskulatur des oberen Rückens und der Schulterregion und kann helfen, Verspannungen durch langes Sitzen oder Bildschirmarbeit zu reduzieren."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen und die Ellenbogen im 90-Grad-Winkel halten.
2. Schultern und Ellenbogen langsam nach hinten bewegen.
3. Schulterblätter kontrolliert zusammenziehen.
4. Kurz halten.
5. Langsam in die Ausgangsposition zurückkehren.\""""^^xsd:string ;
    ns1:improves ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Trapezius,
        ns1:UpperBack ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Lats,
        ns1:RearDeltoids,
        ns1:RotatorCuffs,
        ns1:Shoulders,
        ns1:Trapezius ;
    rdfs:comment "Übung zur Kräftigung und Stabilisierung der Schulterblattmuskulatur."@de .

ns1:TrainingsLevel a owl:Class ;
    rdfs:label "TrainingsLevel"@en ;
    rdfs:comment "Einstufung des sportlichen Leistungsstands einer Person, üblicherweise in Stufen wie Anfänger, Fortgeschritten und Profi."@de ;
    rdfs:subClassOf ns1:Patient .

ns1:Trapezius a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Trapezmuskel"@de,
        "Trapezius"@en ;
    ns1:isEngagedBy ns1:MountainClimber,
        ns1:ScapulaRetraktion ;
    ns1:partOf ns1:Neck,
        ns1:Shoulders,
        ns1:UpperBack ;
    rdfs:comment "Trapezmuskel, ein großer Muskel im oberen Rücken und Nacken, der die Schultern bewegt."@de .

ns1:WristJoint a ns1:Joint,
        owl:NamedIndividual ;
    rdfs:label "Handgelenk"@de,
        "WristJoint"@en ;
    ns1:partOf ns1:Wrists ;
    rdfs:comment "Handgelenk"@de .

ns1:Armkreisen a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Armkreisen"@de,
        "ArmCircles"@en ;
    ns1:engagedBodyPart ns1:Chest,
        ns1:Glutes,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Trapezius,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Schultern werden hochgezogen, die Bewegung wird zu schnell ausgeführt oder der Oberkörper weicht stark aus."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Die Schultern bewusst locker lassen und die Bewegung langsam kontrollieren. Den Bewegungsradius verkleinern, wenn Schmerzen oder Ausweichbewegungen auftreten."^^xsd:string ;
    ns1:hasDescription "Eine einfache Mobilisationsübung für Schultergelenke, Schultergürtel und oberen Rücken. Die Übung verbessert die Beweglichkeit der Schultern und bereitet die Muskulatur auf weitere Bewegungen vor."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Die Arme seitlich ausstrecken oder locker neben dem Körper halten.
3. Kleine kontrollierte Kreise mit den Armen ausführen.
4. Die Kreise langsam größer werden lassen.
5. Nach einigen Wiederholungen die Richtung wechseln.
6. Die Schultern entspannt halten und gleichmäßig atmen"""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Mobility ;
    ns1:rehabilitates ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:UpperBack ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Einfache Mobilisationsübung für Schultergelenke, Schultergürtel und oberen Rücken."@de .

ns1:CenterSplitsInstruction a owl:NamedIndividual ;
    rdfs:label "Anleitung für Mittelspaltung"@de,
        "CenterSplitsInstruction"@en ;
    ns1:forCondition ns1:BalanceIssue ;
    ns1:severity ns1:MediumRisk .

ns1:Dumble a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Kurzhantel"@de,
        "Dumble"@en ;
    rdfs:comment "Kurzhantel als Trainingsgerät zur Kräftigung einzelner Muskelgruppen."@de .

ns1:Elbows a ns1:BodyPart,
        owl:NamedIndividual ;
    rdfs:label "Ellbogen"@de,
        "Elbows"@en ;
    rdfs:comment "Ellbogen als Körperregion, die das Ellenbogengelenk und die umliegenden Strukturen umfasst."@de .

ns1:ExerciseProperties a owl:Class ;
    rdfs:label "ExerciseProperties"@en ;
    rdfs:comment "Eigenschaften und Merkmale, die eine Übung charakterisieren, etwa Schwierigkeitsgrad, betroffene Körperregionen oder benötigte Ausrüstung."@de ;
    rdfs:subClassOf owl:Thing .

ns1:HueftbeugerDehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Hüftbeuger-Dehnung"@de,
        "HipFlexorStretch"@en ;
    ns1:engagedBodyPart ns1:Hip,
        ns1:HipJoint,
        ns1:Knees,
        ns1:LowerBack,
        ns1:Psoas,
        ns1:Quadriceps ;
    ns1:hasCommonMistake "Das Becken wird stark nach vorne geschoben, der untere Rücken bildet ein Hohlkreuz oder der Oberkörper kippt weit nach vorne."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue ;
    ns1:hasCorrectionGuidance "Das Becken leicht nach hinten kippen und die Bauchmuskulatur sanft anspannen. Den Oberkörper aufrecht halten und nur so weit nach vorne gehen, bis eine angenehme Dehnung spürbar ist."^^xsd:string ;
    ns1:hasDescription "Eine Dehnübung für die Hüftbeugemuskulatur. Sie kann die Beweglichkeit der Hüfte unterstützen und Spannungsgefühle reduzieren, die beispielsweise durch langes Sitzen entstehen."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In einen halben Kniestand kommen, wobei ein Knie am Boden liegt.
2. Das vordere Bein ungefähr im rechten Winkel aufstellen.
3. Den Oberkörper aufrecht halten.
4. Das Becken leicht nach hinten kippen.
5. Das Becken langsam nach vorne verlagern, ohne ein Hohlkreuz zu bilden.
6. Die Dehnung an der Vorderseite der Hüfte des hinteren Beins wahrnehmen.
7. Die Position ruhig halten und gleichmäßig atmen.
8. Anschließend die Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:rehabilitates ns1:HipJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Psoas,
        ns1:Quadriceps ;
    rdfs:comment "Dehnübung für die Hüftbeugemuskulatur an der Vorderseite der Hüfte."@de .

ns1:Kindpose a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Kindhaltung"@de,
        "ChildPose"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Back,
        ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:Legs,
        ns1:LowerBack,
        ns1:Thighs ;
    ns1:hasCommonMistake "Das Becken wird gewaltsam zu den Fersen gedrückt, der Nacken bleibt angespannt oder die Knieposition verursacht Schmerzen."^^xsd:string ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue,
        ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Nur so weit zurückgehen, wie es angenehm möglich ist. Bei eingeschränkter Beweglichkeit ein Kissen unter Brust oder Gesäß legen. Die Knie weiter oder enger positionieren, bis Hüfte und Knie entspannt bleiben."^^xsd:string ;
    ns1:hasDescription "Eine ruhige Bodenposition zur Entspannung und sanften Mobilisation von Rücken und Hüfte. Der Oberkörper wird nach vorne abgesenkt, während das Becken in Richtung Fersen bewegt wird. Die Position kann mit einem Kissen oder Block angepasst werden."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Vierfüßlerstand kommen.
2. Die Knie bequem auseinanderstellen und die großen Zehen zueinander führen.
3. Das Becken langsam in Richtung Fersen zurückschieben.
4. Den Oberkörper zwischen oder auf den Oberschenkeln ablegen.
5. Die Arme nach vorne ausstrecken oder entspannt neben dem Körper ablegen.
6. Die Stirn auf dem Boden, einem Kissen oder einem Block ablegen.
7. Ruhig und gleichmäßig atmen.
8. Die Position für mehrere Atemzüge halten und anschließend langsam verlassen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:LowerBack,
        ns1:Spine,
        ns1:SpineJoint ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Ruhestellung im Sitzen mit nach vorne geneigtem Oberkörper, die Rücken und Hüfte sanft dehnt."@de .

ns1:RespiratoryIssue a ns1:Contraindication,
        owl:NamedIndividual ;
    rdfs:label "Atemwegsproblem"@de,
        "RespiratoryIssue"@en ;
    rdfs:comment "Vorsicht bei fortgeschrittenen Atemwegserkrankungen wie COPD oder Asthma, da längere Atempausen oder forcierte Atemmuster die Symptome verschlechtern können. Rücksprache mit einem Arzt wird empfohlen."@de,
        "Caution for advanced respiratory conditions such as COPD or asthma, as extended breath holds or forced breathing patterns may worsen symptoms. Consulting a physician is recommended."@en .

ns1:Wandsitzen a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Wandsitzen"@de,
        "WallSit"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:KneeJoint,
        ns1:Quadriceps ;
    ns1:hasContraindication ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Mit dem Rücken an eine Wand stellen, die Füße etwa schulterbreit auseinander und einen halben Schritt von der Wand entfernt.
2. Den Rücken langsam an der Wand nach unten gleiten lassen, bis die Oberschenkel ungefähr parallel zum Boden sind.
3. Die Knie ungefähr im rechten Winkel beugen, die Füße bleiben fest am Boden.
4. Den Rücken vollständig an die Wand pressen, den Rumpf aufrichten und die Schultern entspannen.
5. Die Arme locker seitlich an die Wand legen oder auf den Oberschenkeln ablegen.
6. Die Position 20 bis 40 Sekunden halten und ruhig weiteratmen.
7. Mit der Ferse gegen den Boden drücken, um die Oberschenkelmuskulatur zu aktivieren.
8. Den Rücken an der Wand nach oben schieben, um die Position zu beenden.
9. Zwei bis drei Sätze absolvieren und die Haltezeit langsam steigern."""^^xsd:string ;
    ns1:improves ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:Wall ;
    ns1:strengthens ns1:Calves,
        ns1:Glutes,
        ns1:Hamstrings,
        ns1:Quadriceps ;
    rdfs:comment "Statische Halteübung an der Wand mit angewinkelten Beinen, die Oberschenkel kräftigt."@de .

ns1:HamstringStretch a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Oberschenkelrückseiten-Dehnung"@de,
        "HamstringStretch"@en ;
    ns1:engagedBodyPart ns1:Hamstrings ;
    ns1:hasContraindication ns1:HamstringIssue,
        ns1:LowerBackIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen, beide Beine ausstrecken.
2. Ein Handtuch oder einen Gurt um den Mittelfuß eines Beins legen.
3. Das Bein am Handtuch hochheben und das Knie langsam strecken, bis eine sanfte Dehnung an der Oberschenkelrückseite spürbar ist.
4. Das Knie dabei leicht gebeugt halten, falls die Dehnung zu intensiv wird.
5. Die Position 20 bis 30 Sekunden halten und ruhig weiteratmen.
6. Das Bein kontrolliert ablegen und die Seite wechseln.
7. Pro Seite 2 bis 3 Wiederholungen durchführen."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Hamstrings ;
    rdfs:comment "Dehnübung für die rückseitige Oberschenkelmuskulatur."@de .

ns1:Limb a owl:Class ;
    rdfs:label "Limb"@en ;
    rdfs:comment "Repräsentiert die Gliedmaßen des menschlichen Körpers."@de ;
    rdfs:subClassOf ns1:BodyPart .

ns1:RearDeltoids a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Hintere Deltamuskeln"@de,
        "RearDeltoids"@en ;
    ns1:isEngagedBy ns1:ScapulaRetraktion,
        ns1:TherabandAussenrotation ;
    ns1:partOf ns1:Shoulders ;
    rdfs:comment "Hintere Schultermuskulatur, die den Arm nach hinten zieht."@de .

ns1:TherabandAussenrotation a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Außenrotation mit Theraband"@de,
        "TherabandExternalRotation"@en ;
    ns1:engagedBodyPart ns1:RearDeltoids,
        ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Trapezius ;
    ns1:hasCommonMistake "Der Ellenbogen entfernt sich vom Körper, das Handgelenk knickt ab oder der Oberkörper dreht mit."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Den Ellenbogen nah am Körper halten, eventuell ein kleines Handtuch zwischen Ellenbogen und Oberkörper klemmen. Nur so weit nach außen rotieren, wie die Schulter stabil bleibt."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung für die Außenrotatoren der Schulter und die Rotatorenmanschette. Sie unterstützt die Schulterstabilität und kann bei kontrolliertem Training die Haltung des Schultergelenks verbessern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen oder sitzen.
2. Das Theraband mit beiden Händen halten.
3. Die Ellenbogen nah am Körper halten und etwa 90 Grad beugen.
4. Einen Unterarm langsam nach außen drehen.
5. Das Handgelenk stabil halten.
6. Langsam in die Ausgangsposition zurückkehren.
7. Die Bewegung kontrolliert wiederholen."""^^xsd:string ;
    ns1:improves ns1:Mobility,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:RotatorCuffs,
        ns1:ShoulderJoint,
        ns1:Shoulders ;
    ns1:requiresEquipment ns1:Theraband ;
    ns1:strengthens ns1:RearDeltoids,
        ns1:RotatorCuffs ;
    rdfs:comment "Kräftigungsübung mit Theraband für die Außenrotatoren der Schulter."@de .

ns1:Wrists a ns1:BodyPart,
        owl:NamedIndividual ;
    rdfs:label "Handgelenke"@de,
        "Wrists"@en ;
    rdfs:comment "Handgelenke als Körperregion, die Unterarm und Hand verbinden."@de .

ns1:ChestDoorwayStretch a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "Brustdehnung im Türrahmen"@de,
        "ChestDoorwayStretch"@en ;
    ns1:engagedBodyPart ns1:Chest,
        ns1:Shoulders ;
    ns1:hasCommonMistake "Achte darauf, dass du bei der Bewegungsausführung nicht ins Hohlkreuz gelangst. Du darfst dein Kinn nicht nach vorne Schieben. Die Schultern dürfen hierbei nicht hochgezpgen werden. Die 90 Grad der Ellbogen müssen eingehalten werden, weil sonst die Belastung verschoben wird."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Lehne dich aus der Brust, nicht aus dem Rücken. Die Vorwärtsbewegung kommt aus dem Brustbein. Das Kinn bildet eine Linie mit dem Brustbein, du darfst kein Doppelkinn erzwingen. Beim langsamen Ausatmen kann sich das Brustbein besser senen und die Dehnung wird tiefer."^^xsd:string ;
    ns1:hasDescription "Dehnübung, die mithilfe eines Türrahmens die Brustmuskulatur sowie die vordere Schulter dehnt. Die Übung öffnet die Körpervorderseite, wirkt die nach vorne gerollten Schultern entgegen und verbessert die Schulter- und Nackenmobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Stelle dich aufrecht in einen offenen Türrahmen, Füße schulterbreit.
2. Hebe beide Arme seitlich auf Schulterhöhe an und winke die Ellbogen im 90-Grad-Winkel ab, die Unterarme liegen flach am Türrahmen an, Handflächen zeigen nach vorne.
3. Ziehe die Schulterblätter bewusst nach unten und hinten (nicht hochziehen).
4. Mache einen kleinen Schritt mit einem Fuß nach vorne durch den Türrahmen.
5. Lehne den Brustkorb langsam nach vorne, bis du eine sanfte Dehnung quer über Brust und Vorderschultern spürst.
6. Halte den Hals neutral, das Kinn parallel zum Boden, Blick nach vorne.
7. Löse die Dehnung, indem du langsam zurücktrittst."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:rehabilitates ns1:Shoulders ;
    ns1:requiresEquipment ns1:Door ;
    ns1:stretches ns1:Chest,
        ns1:Shoulders ;
    rdfs:comment "Dehnübung für Brust und vordere Schulter im Türrahmen."@de .

ns1:JointInjury a owl:Class ;
    rdfs:label "JointInjury"@en ;
    rdfs:comment "Verletzungen oder Beschwerden im Gelenk Bereich"@de ;
    rdfs:subClassOf ns1:Injury .

ns1:LegRaise a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Beinheben"@de,
        "LegRaise"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:Quadriceps,
        ns1:Spine,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Der untere Rücken hebt stark vom Boden ab, die Beine werden schwungvoll bewegt oder der Nacken verspannt."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue,
        ns1:HipIssue,
        ns1:LowerBackIssue,
        ns1:SpineIssue ;
    ns1:hasCorrectionGuidance "Den Bewegungsumfang verkleinern oder nur ein Bein bewegen. Bauchspannung halten und die Bewegung langsam ausführen."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung für Bauchmuskulatur und Hüftbeuger. Die Übung trainiert die Kontrolle der Beckenposition und die Stabilität des unteren Rückens."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen.
2. Beine ausstrecken oder leicht beugen.
3. Den unteren Rücken kontrolliert Richtung Boden stabilisieren.
4. Ein Bein oder beide Beine langsam anheben.
5. Die Beine kontrolliert wieder absenken.
6. Nur so tief gehen, wie der Rücken stabil bleibt.
7. Gleichmäßig atmen."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Abs,
        ns1:HipJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Obliques,
        ns1:Quadriceps ;
    rdfs:comment "Übung im Liegen, bei der die Beine angehoben werden, um die vordere Rumpf- und Hüftmuskulatur zu kräftigen."@de .

ns1:SeverityLevel a owl:Class ;
    rdfs:label "SeverityLevel"@en ;
    rdfs:comment "Stufe zur Einstufung der Schwere eines Risikos oder Zustands, etwa in abgestuften Klassen wie niedrig, mittel und hoch."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:SitzenStehen a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Hinsetzen-Aufstehen"@de,
        "SitToStand"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:Glutes,
        ns1:KneeJoint,
        ns1:Knees,
        ns1:Quads,
        ns1:Thighs ;
    ns1:hasContraindication ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht auf einen stabilen Stuhl ohne Armlehne setzen, Füße hüftbreit und flach auf dem Boden.
2. Die Arme vor der Brust verschränken, um den Einsatz der Hände auszuschließen.
3. Den Oberkörper leicht nach vorne lehnen, die Füße fest in den Boden drücken.
4. Mit kontrolliertem Tempo aus dem Sitz aufstehen, bis die Beine vollständig gestreckt sind.
5. Kurz aufrecht stehen bleiben, dann langsam und gleichmäßig wieder hinsetzen.
6. Die Knie während der gesamten Bewegung in Richtung Fußspitzen halten.
7. 8 bis 12 Wiederholungen als ein Satz durchführen, insgesamt drei Sätze mit etwa einer Minute Pause."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Mobility,
        ns1:Stability,
        ns1:Strength ;
    rdfs:comment "Übung, bei der aus dem Sitzen ohne Hilfe der Hände aufgestanden wird, um Bein- und Rumpfkraft zu trainieren."@de .

ns1:Wall a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Wand"@de,
        "Wall"@en ;
    rdfs:comment "Wand als stabile Fläche zur Unterstützung von Balance- und Mobilisationsübungen."@de .

ns1:Biceps a ns1:BodyPart,
        ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Bizeps"@de,
        "Biceps"@en ;
    ns1:partOf ns1:Arms ;
    rdfs:comment "Bizeps, der große Beugemuskel an der Vorderseite des Oberarms."@de .

ns1:Patient a owl:Class ;
    rdfs:label "Patient"@en ;
    rdfs:comment "Diese Klasse repräsentiert einen Reha-Patienten, der die Physiotherapie in Anspruch nimmt"@de .

ns1:Theraband a ns1:Equipment,
        owl:NamedIndividual ;
    rdfs:label "Theraband"@de,
        "Theraband"@en ;
    rdfs:comment "Theraband als elastisches Band für Kräftigungs- und Mobilisationsübungen."@de .

ns1:AnkleJoint a ns1:Joint,
        owl:NamedIndividual ;
    rdfs:label "Sprunggelenk"@de,
        "AnkleJoint"@en ;
    ns1:partOf ns1:Ankles ;
    rdfs:comment "Sprunggelenk"@de .

ns1:CoreWeakness a ns1:Contraindication,
        owl:NamedIndividual ;
    rdfs:label "Rumpfmuskelschwäche"@de,
        "CoreWeakness"@en ;
    ns1:requiresImprovementOf ns1:Core ;
    rdfs:comment "Schwäche der Rumpfmuskulatur, die Haltung und Stabilität beeinträchtigt."@de .

ns1:Fracture a owl:Class ;
    rdfs:label "Fracture"@en ;
    rdfs:comment "Knochenbruch als vollständige oder unvollständige Unterbrechung des Knochens, die durch direkte Gewalteinwirkung, Sturz oder wiederholte Überlastung entstehen kann."@de ;
    rdfs:subClassOf ns1:Injury .

ns1:MuscleInjury a owl:Class ;
    rdfs:label "MuscleInjury"@en ;
    rdfs:comment "Verletzungen oder Beschwerden von Muskeln oder Muskelgruppen"@de ;
    rdfs:subClassOf ns1:Injury .

ns1:Stretching a ns1:SportActivity,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dehnen"@de,
        "Stretching"@en ;
    ns1:Calorie 178.0 ;
    ns1:MET 2.5 ;
    rdfs:comment "Übungen mit Schwerpunkt auf Flexibilität und Muskeldehnung."@de ;
    rdfs:subClassOf ns1:Exercise .

ns1:Joint a owl:Class ;
    rdfs:label "Joint"@en ;
    rdfs:comment "Gelenk des menschlichen Körpers; Oberklasse aller spezifischen Gelenke"@de ;
    rdfs:subClassOf ns1:BodyPart .

ns1:KneeJoint a ns1:Joint,
        owl:NamedIndividual ;
    rdfs:label "Kniegelenk"@de,
        "KneeJoint"@en ;
    ns1:isRehabilitatedBy ns1:Bruecke,
        ns1:Chair,
        ns1:Einbeinstand,
        ns1:FerseZehenGang,
        ns1:GleichgewichtInstabil,
        ns1:HighLunge,
        ns1:KniegelenkMobilisation,
        ns1:LegRaise,
        ns1:MonsterWalk,
        ns1:MountainClimber,
        ns1:SitzenStehen,
        ns1:Squads,
        ns1:Tree,
        ns1:Wandsitzen,
        ns1:Warrior1,
        ns1:Warrior2 ;
    ns1:partOf ns1:Knees ;
    rdfs:comment "Kniegelenk"@de .

ns1:SpineIssue a ns1:Contraindication,
        owl:NamedIndividual ;
    rdfs:label "Wirbelsäulenprobleme"@de,
        "SpineIssue"@en ;
    ns1:requiresImprovementOf ns1:Spine ;
    rdfs:comment "Allgemeine Empfindlichkeit oder Instabilität im Bereich der Wirbelsäule."@de .

ns1:DailyRoutine a owl:Class ;
    rdfs:label "DailyRoutine"@en ;
    rdfs:comment "Schonung im Alltag"@de .

ns1:JumpingJacks a ns1:Cardio,
        owl:NamedIndividual ;
    rdfs:label "Hampelmann"@de,
        "JumpingJacks"@en ;
    ns1:engagedBodyPart ns1:Calves,
        ns1:Core,
        ns1:Glutes,
        ns1:Hip,
        ns1:Quadriceps,
        ns1:Shoulders ;
    ns1:hasContraindication ns1:AnkleIssue,
        ns1:BackIssue,
        ns1:KneeIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen, Füße zusammen, Arme seitlich am Körper.
2. Mit beiden Füßen gleichzeitig etwas mehr als hüftbreit springen und die Arme in einem Bogen über den Kopf führen.
3. Weich auf den Fußballen landen, die Knie dabei leicht gebeugt halten.
4. Mit einem weiteren Sprung in die Ausgangsposition zurückkehren und die Arme senken.
5. Die Knie während der gesamten Bewegung über den Fußspitzen ausrichten und den Rumpf stabil halten.
6. Anfangs 20 bis 30 Sekunden in gemäßigtem Tempo durchführen, dann 30 bis 60 Sekunden steigern.
7. Zwei bis drei Sätze mit jeweils 20 bis 30 Sekunden Pause absolvieren."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Mobility,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Hampelmann, eine klassische Aufwärmübung, die den gesamten Kreislauf aktiviert."@de .

ns1:NeckIssue a ns1:Contraindication,
        owl:NamedIndividual ;
    rdfs:label "Nackenprobleme"@de,
        "NeckIssue"@en ;
    ns1:requiresImprovementOf ns1:Neck ;
    rdfs:comment "Verspannung oder Schmerz im Bereich der Halswirbelsäule."@de .

ns1:Equipment a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:comment "Trainingsgeräte und Hilfsmittel, die in Physiotherapie und Rehabilitation eingesetzt werden, um Übungen zu erleichtern oder Belastungen gezielt zu dosieren."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:Injury a owl:Class ;
    rdfs:label "Injury"@en ;
    rdfs:comment "Konkrete Verletzung des Patienten (Spezialisierung von Condition)"@de .

ns1:Obliques a ns1:BodyPart,
        ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Schräge Bauchmuskeln"@de,
        "Obliques"@en ;
    ns1:isEngagedBy ns1:Bruecke,
        ns1:DeadBug,
        ns1:LegRaise,
        ns1:Plank,
        ns1:SitzenStehen,
        ns1:Squads ;
    ns1:partOf ns1:Core ;
    rdfs:comment "Schräge Bauchmuskeln, die seitlich am Rumpf verlaufen und die Rotation unterstützen."@de .

ns1:Plank a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Unterarmstütz"@de,
        "Plank"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Chest,
        ns1:Core,
        ns1:Glutes,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Das Becken sinkt ab, das Gesäß wird zu hoch gehalten oder der Nacken wird überstreckt."^^xsd:string ;
    ns1:hasContraindication ns1:LowerBackIssue,
        ns1:ShoulderIssue,
        ns1:SpineIssue,
        ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Bauchspannung aktivieren und den Blick zum Boden richten. Die Übung abbrechen oder verkürzen, wenn die Körperlinie nicht mehr gehalten werden kann."^^xsd:string ;
    ns1:hasDescription "Statische Kräftigungsübung für Rumpf, Bauchmuskulatur, Schultern und Hüfte. Sie verbessert die Körperstabilität und die Kontrolle der Wirbelsäulenposition."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Unterarmstütz kommen.
2. Ellenbogen unter den Schultern positionieren.
3. Beine nach hinten ausstrecken.
4. Bauch und Gesäß leicht anspannen.
5. Den Körper in einer geraden Linie halten.
6. Ruhig weiteratmen.
7. Die Position nur so lange halten, wie die Kontrolle erhalten bleibt."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Abs,
        ns1:LowerBack,
        ns1:Spine,
        ns1:SpineJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:FrontDeltoid,
        ns1:LowerBack,
        ns1:Obliques,
        ns1:Shoulders ;
    rdfs:comment "Statische Halteübung in Bauchlage auf Unterarmen und Zehen, die den gesamten Rumpf kräftigt."@de .

ns1:PushUps a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Liegestütz"@de,
        "PushUps"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Chest,
        ns1:Core,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:SpineJoint,
        ns1:Triceps,
        ns1:WristJoint ;
    ns1:hasCommonMistake "Das Becken hängt durch, die Ellenbogen gehen zu weit nach außen oder der Kopf wird nach vorne geschoben."^^xsd:string ;
    ns1:hasContraindication ns1:AnkleIssue,
        ns1:ShoulderIssue,
        ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Rumpf aktiv stabilisieren und die Bewegung langsam ausführen. Bei zu hoher Belastung auf Knie-Liegestütze oder Wall Push Ups ausweichen."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung für Brust, Schultern, Trizeps und Rumpf. Klassische Liegestütze erfordern gute Körperspannung und Schulterkontrolle."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """1. In die Liegestützposition kommen.
2. Hände etwas breiter als schulterbreit platzieren.
3. Beine nach hinten ausstrecken und den Körper gerade halten.
4. Den Oberkörper kontrolliert absenken.
5. Ellenbogen leicht schräg nach hinten führen.
6. Den Körper wieder nach oben drücken.
7. Die Bewegung kontrolliert wiederholen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Chest,
        ns1:ShoulderJoint,
        ns1:Shoulders,
        ns1:Triceps ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Chest,
        ns1:FrontDeltoid,
        ns1:Triceps ;
    rdfs:comment "Klassische Liegestützübung, die Brust, Schulter und Arme kräftigt."@de .

ns1:TrainingsEffect a owl:Class ;
    rdfs:label "TrainingsEffect"@en ;
    rdfs:comment "Ziele oder Effekte einer Übung so wie Mobilität, Kraft, Stabilität oder Entspannung."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:Contraindication a owl:Class ;
    rdfs:label "Contraindication"@en ;
    rdfs:comment "Bedingungen oder Ausschlusskriterien, bei denen eine Übung nicht empfohlen wird."@de ;
    rdfs:subClassOf ns1:ExerciseProperties .

ns1:Squads a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Kniebeugen"@de,
        "Squads"@en ;
    ns1:engagedBodyPart ns1:Glutes,
        ns1:Hamstrings,
        ns1:Hip,
        ns1:Quadriceps ;
    ns1:hasContraindication ns1:HipIssue,
        ns1:KneeIssue,
        ns1:LowerBackIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht hinstellen, Füße etwas mehr als hüftbreit, Zehen leicht nach außen gedreht.
2. Den Blick nach vorne richten und den Rumpf aufrichten.
3. Die Arme zur Stabilisation nach vorne strecken oder vor der Brust verschränken.
4. Langsam die Knie beugen und die Hüfte nach hinten schieben, als würde man sich auf einen Stuhl setzen.
5. Die Knie in Richtung Fußspitzen halten, den Rücken gerade lassen und nicht ins Hohlkreuz fallen.
6. Soweit absenken, wie eine kontrollierte, schmerzfreie Bewegung möglich ist, und kurz halten.
7. Über die Fersen kontrolliert wieder in den Stand aufrichten.
8. 12 bis 15 Wiederholungen pro Satz durchführen, insgesamt zwei bis drei Sätze."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Mobility,
        ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Calves,
        ns1:Glutes,
        ns1:Hamstrings,
        ns1:LowerBack,
        ns1:Quadriceps ;
    rdfs:comment "Kniebeuge, eine Grundübung zur Kräftigung von Oberschenkeln, Gesäß und Rumpf."@de .

ns1:HamstringIssue a ns1:Contraindication,
        owl:NamedIndividual ;
    rdfs:label "Oberschenkelrückseiten-Beschwerden"@de,
        "HamstringIssue"@en ;
    ns1:requiresImprovementOf ns1:Hamstrings ;
    rdfs:comment "Verspannung oder Schmerz in der hinteren Oberschenkelmuskulatur."@de .

ns1:RotatorCuffs a ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Rotatorenmanschetten"@de,
        "RotatorCuffs"@en ;
    ns1:isEngagedBy ns1:ScapulaRetraktion,
        ns1:TherabandAussenrotation ;
    ns1:partOf ns1:Shoulders ;
    rdfs:comment "Rotatorenmanschette, die Muskelgruppe rund um das Schultergelenk."@de .

ns1:Entspannung a owl:Class ;
    rdfs:label "Entspannung"@de ;
    rdfs:comment "Übungen zur körperlichen und geistigen Entspannung"@de ;
    rdfs:subClassOf ns1:Exercise .

ns1:Triceps a ns1:BodyPart,
        ns1:Muscle,
        owl:NamedIndividual ;
    rdfs:label "Trizeps"@de,
        "Triceps"@en ;
    ns1:partOf ns1:Arms ;
    rdfs:comment "Trizeps, der Streckmuskel an der Rückseite des Oberarms."@de .

ns1:Exercise a owl:Class ;
    rdfs:label "Exercise"@en ;
    rdfs:comment "Repräsentiert eine physiotherapeutische, sportliche oder mobilisierende Übung."@de ;
    rdfs:subClassOf owl:Thing .

ns1:Muscle a owl:Class ;
    rdfs:label "Muscle"@en ;
    rdfs:comment "Repräsentiert die Muskeln des menschlichen Körpers."@de ;

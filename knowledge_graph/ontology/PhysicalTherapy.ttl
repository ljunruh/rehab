    rdfs:label "Step-Aerobic"@de,
        "AerobicStepping"@en ;
    ns1:Calorie 607.0 ;
    ns1:MET 8.5 .

ns1:AgeGroup a ns1:Patient,
        owl:NamedIndividual ;
    rdfs:label "Altersgruppe"@de,
        "AgeGroup"@en ;
    rdfs:comment "Gruppe von Patienten, die durch gemeinsame Merkmale wie Alter oder Fitnessstand zusammengefasst werden."@de .

ns1:AllFourswithLegExtension a ns1:CoordinationMobility,
        ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Vierfüßlerstand mit Beinstreckung"@de,
        "AllFourswithLegExtension"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Glutes,
        ns1:HipJoint,
        ns1:Knees,
        ns1:LowerBack,
        ns1:ShoulderJoint,
        ns1:SpineJoint ;
    ns1:hasCommonMistake "Das Becken kippt zur Seite, der untere Rücken geht ins Hohlkreuz oder das Bein wird zu hoch gehoben."^^xsd:string ;
    ns1:hasContraindication ns1:KneeIssue,
        ns1:LowerBackIssue,
        ns1:SpineIssue,
        ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Das Bein nur bis auf Hüfthöhe anheben und den Rücken neutral halten. Die Bewegung langsam und ohne Schwung ausführen."^^xsd:string ;
    ns1:hasDescription "Stabilisationsübung für Rumpf, Gesäß und unteren Rücken im Vierfüßlerstand. Die Übung trainiert Kontrolle, Gleichgewicht und Beckenstabilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Bauch leicht anspannen.
4. Ein Bein langsam nach hinten ausstrecken.
5. Das Becken möglichst stabil halten.
6. Das Bein kontrolliert wieder absetzen.
7. Die Seite wechseln und wiederholen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Posture,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:Glutes,
        ns1:Hip,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:SpineJoint ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Glutes,
        ns1:LowerBack ;
    rdfs:comment "Stabilisationsübung für Rumpf, Gesäß und unteren Rücken im Vierfüßlerstand."@de .

ns1:AlternateSittingAndStanding a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Abwechselnd Sitzen und Stehen"@de,
        "AlternateSittingAndStanding"@en ;
    ns1:hasDailyLifeAdvice "Regelmäßiger Wechsel zwischen Sitzen und Stehen, um einseitige Belastungen zu reduzieren und die Wirbelsäule zu entlasten."^^xsd:string ;
    rdfs:comment "Wechsle Sitzen und Stehen"@de .

ns1:AnkleFracture a ns1:AnkleFrac,
        owl:NamedIndividual ;
    rdfs:label "Sprunggelenkfraktur"@de,
        "AnkleFracture"@en ;
    ns1:excludesExercise ns1:Einbeinstand,
        ns1:GleichgewichtInstabil ;
    ns1:requiresImprovementOf ns1:AnkleJoint ;
    rdfs:comment "Bruch eines oder mehrerer Knochen am Sprunggelenk, meist durch Umknicken oder Verdrehen."@de .

ns1:ArmhebenImVierfuesslerstand a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Armheben im Vierfüßlerstand"@de,
        "Quadruped Arm Reach"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:Hip,
        ns1:LowerBack,
        ns1:Obliques ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Versuche stattdessen, ruhig und kontrolliert gegenzusteuern, um das Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Führe die Bewegung langsam und kontrolliert aus. Fixiere dabei einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Unterstützung."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Gehe in den Vierfüßlerstand.
2. Spanne deinen Rumpf an und halte den Rücken stabil.
3. Strecke einen Arm, ein Bein oder beides langsam und kontrolliert aus.
4. Führe Arm und Bein zurück, ohne das Becken zur Seite zu drehen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Mobility,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Eine Übung im Vierfüßlerstand zur Verbesserung der Rumpfstabilität, Körperkontrolle und Koordination durch das kontrollierte Strecken von Arm und Bein."@de .

ns1:Armkreisen_ShoulderIssue a owl:NamedIndividual ;
    rdfs:label "Armkreisen: Schulterproblem"@de,
        "ArmCircles_ShoulderIssue"@en ;
    ns1:forCondition ns1:ShoulderIssue ;
    ns1:severity ns1:LowRisk ;
    rdfs:comment "Hinweis auf Schulter-Probleme, die bei den Armkreisen berücksichtigt werden sollten."@de .

ns1:AvoidForwardHeadPosture a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Vermeide nach vorne geschobene Kopfhaltung"@de,
        "AvoidForwardHeadPosture"@en ;
    ns1:hasDailyLifeAdvice "Vermeidung einer nach vorne geschobenen Kopfhaltung, um Nacken- und Schulterbelastungen zu verringern."^^xsd:string ;
    rdfs:comment "Vermeide eine nach vorne geschobene Kopfhaltung"@de .

ns1:AvoidLongSitting a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Vermeide langes Sitzen"@de,
        "AvoidLongSitting"@en ;
    ns1:hasDailyLifeAdvice "Langes ununterbrochenes Sitzen vermeiden, da es Rücken, Hüfte und Kreislauf belasten kann."^^xsd:string ;
    rdfs:comment "Vermeide langes Sitzen"@de .

ns1:BackFriendlyLifting a ns1:DailyRoutine,
        owl:NamedIndividual ;
    rdfs:label "Rückengerechtes Heben"@de,
        "BackFriendlyLifting"@en ;
    ns1:hasDailyLifeAdvice "Rückenschonendes Heben durch Beugen der Knie, Halten der Last nah am Körper und Vermeiden von Rundrücken."^^xsd:string ;
    rdfs:comment "Hebe aus den Knien"@de .

ns1:Backpacking a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Wandern mit Rucksack"@de,
        "Backpacking"@en ;
    ns1:Calorie 500.0 ;
    ns1:MET 7.0 .

ns1:Backward a owl:NamedIndividual ;
    rdfs:label "Rückwärts"@de,

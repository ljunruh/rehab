    rdfs:label "Wandengel"@de,
        "Wall Angels"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide zu große oder schwungvolle Bewegungen. Führe die Bewegung stattdessen langsam und kontrolliert aus."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Verkleinere den Bewegungsradius und führe die Bewegung langsamer aus. Halte deinen Rumpf dabei ruhig und stabil."^^xsd:string ;
    ns1:hasDescription "Mobilisationsübung zur sanften Bewegungserweiterung im Bereich Schultern mit Schwerpunkt auf mobilität."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Lehne deinen Rücken oder deine Unterarme an die Wand.
2. Spanne deinen Rumpf an und halte ihn stabil.
3. Lass deine Arme langsam an der Wand nach oben gleiten.
4. Senke die Arme anschließend kontrolliert wieder ab."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture ;
    ns1:requiresEquipment ns1:Wall .

ns1:WandgleitenMitArmabheben a ns1:CoordinationMobility,

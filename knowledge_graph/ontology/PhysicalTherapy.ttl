ns1:SingleLegBridge a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Einbein-Brücke"@de,
        "SingleLegBridge"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:Glutes,
        ns1:Hamstrings,
        ns1:HipJoint,
        ns1:LowerBack,
        ns1:Pelvic ;
    ns1:hasContraindication ns1:KneeIssue,
        ns1:LowerBackIssue ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Auf den Rücken legen, beide Knie anwinkeln und die Füße hüftbreit aufstellen.
2. Ein Knie zur Brust ziehen, sodass der Oberschenkel senkrecht steht und der Unterschenkel parallel zum Boden bleibt.
3. Die Bauchmuskulatur anspannen und das Becken in eine neutrale Position bringen.
4. Über die Ferse des stehenden Beins das Becken kontrolliert anheben, bis Schulter, Hüfte und Knie eine Linie bilden.
5. Das Gesäß am oberen Punkt kurz anspannen und die Hüfte waagerecht halten.
6. Die Hüfte langsam wieder absenken, ohne den unteren Rücken ins Hohlkreuz fallen zu lassen.
7. 10 bis 15 Wiederholungen pro Seite durchführen, dann die Seite wechseln.
8. Pro Seite 2 bis 3 Sätze absolvieren."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Stability,
        ns1:Strength ;
    ns1:rehabilitates ns1:HipJoint,
        ns1:LowerBack ;
    ns1:strengthens ns1:Core,
        ns1:Glutes,
        ns1:Hamstrings ;
    rdfs:comment "Variante der Brücke, bei der ein Bein angehoben wird, um Gesäß und hintere Oberschenkel einseitig zu kräftigen."@de .


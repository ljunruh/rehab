ns1:Kastenatmung4444Atmung a ns1:Entspannung,
        owl:NamedIndividual ;
    rdfs:label "Kastenatmung (4-4-4-4-Atmung)"@de,
        "Box Breathing"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Core ;
    ns1:hasCommonMistake "Zu schnell oder nur flach in den Brustkorb atmen, statt den Atem bewusst in den Bauch fließen zu lassen."^^xsd:string ;
    ns1:hasContraindication ns1:RespiratoryIssue ;
    ns1:hasCorrectionGuidance "Das Tempo bewusst verlangsamen und die Ausatmung etwas länger werden lassen als die Einatmung."^^xsd:string ;
    ns1:hasDescription "Kastenatmung (4-4-4-4-Atmung) ist eine ruhige Atemübung, die Entspannung, Körperwahrnehmung und eine bewusste Atemkontrolle fördert."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht sitzen.
2. Vier Sekunden einatmen.
3. Vier Sekunden halten.
4. Vier Sekunden ausatmen.
5. Vier Sekunden pausieren."""^^xsd:string ;
    ns1:improves ns1:Focus,
        ns1:Relaxation ;
    ns1:requiresEquipment ns1:None .

ns1:Katze-Kuh-Übung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Katze-Kuh-Übung"@de,
        "CatCow"@en ;
    ns1:engagedBodyPart ns1:Abs,
        ns1:Back,
        ns1:Chest,
        ns1:Core,
        ns1:LowerBack,
        ns1:Neck,
        ns1:NeckJoint,
        ns1:Spine,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Die Bewegung wird zu schnell ausgeführt, der Nacken wird stark überstreckt oder die Ellenbogen werden gebeugt."^^xsd:string ;
    ns1:hasContraindication ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Die Bewegung Wirbel für Wirbel ausführen und den Nacken als Verlängerung der Wirbelsäule halten. Die Arme gestreckt lassen und den Bewegungsumfang bei Beschwerden reduzieren."^^xsd:string ;
    ns1:hasDescription "Eine dynamische Mobilisationsübung für die Wirbelsäule. Durch den kontrollierten Wechsel zwischen Rundrücken und sanfter Streckung werden Rücken, Nacken und Rumpf bewegt und die Wahrnehmung der Wirbelsäulenposition verbessert."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Beim Ausatmen den Rücken langsam runden.
4. Das Kinn leicht zur Brust führen und den Bauchnabel nach innen ziehen.
5. Beim Einatmen das Becken kippen und die Wirbelsäule sanft nach unten bewegen.
6. Brustbein und Blick leicht nach vorne anheben.
7. Die Bewegung langsam und fließend wiederholen.
8. Nur im angenehmen Bewegungsbereich arbeiten."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Flexibility,
        ns1:Mobility,
        ns1:Posture,
        ns1:Relaxation ;
    ns1:rehabilitates ns1:LowerBack,
        ns1:NeckJoint,
        ns1:SpineJoint,
        ns1:UpperBack ;
    ns1:requiresEquipment ns1:None ;
    ns1:stretches ns1:Core,
        ns1:LowerBack,
        ns1:UpperBack ;
    rdfs:comment "Mobilisationsübung für die Wirbelsäule im Vierfüßlerstand, die abwechselnd den Rücken rund und hohl macht."@de .


ns1:Badminton a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Badminton"@de,
        "Badminton"@en ;
    ns1:Calorie 321.0 ;
    ns1:MET 4.5 .

ns1:Baerenlauf a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Bärenlauf"@de,
        "Bear Crawl"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Vierfüßlerstand einnehmen.
2. Knie knapp anheben.
3. Gegengleichen Arm und Fuß versetzen.
4. Rumpf stabil halten."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:Baerenstuetz a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Bärenstütz"@de,
        "Bear Hold"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:LowerBack ;
    ns1:hasCommonMistake "Vermeide hektische Ausgleichsbewegungen. Steuere stattdessen ruhig und kontrolliert gegen, um dein Gleichgewicht zu halten."^^xsd:string ;
    ns1:hasContraindication ns1:WristIssue ;
    ns1:hasCorrectionGuidance "Verlangsame die Bewegung, fixiere einen festen Punkt und nutze bei Bedarf eine Wand oder einen Stuhl als Stütze."^^xsd:string ;
    ns1:hasDescription "Koordinations- und Gleichgewichtsübung zur Verbesserung der Körperkontrolle im Bereich Rumpf."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "3 Min"^^xsd:string ;
    ns1:hasInstruction """1. Stützposition einnehmen.
2. Bauch und Gesäß anspannen.
3. Körper in einer stabilen Linie halten.
4. Ruhig atmen und kontrolliert lösen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Stability ;
    ns1:requiresEquipment ns1:None .

ns1:Ballet a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Ballett"@de,

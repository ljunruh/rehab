ns1:StandingBackbend a ns1:Stretching,
        owl:NamedIndividual ;
    rdfs:label "StandingBackBend"^^xsd:string,
        "Rückbeuge im Stehen"@de,
        "StandingBackbend"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Chest,
        ns1:LowerBack,
        ns1:Neck,
        ns1:Psoas,
        ns1:UpperBack ;
    ns1:hasBreathingGuidance ns1:StandingBackbendInstruction ;
    ns1:hasCommonMistake "Das ruckartige Nach-hinten-Werfen des Kopfes mit Nackenkompression gilt es zu vermeiden, das Überstrecken nur im unteren Rücken (Hohlkreuz), das Hochziehen der Schultern, das Anwinkeln der Knie und ein schlaffer Bauch."^^xsd:string ;
    ns1:hasContraindication ns1:StandingBackBend_LowerBackIssue,
        ns1:StandingBackBend_NeckIssue,
        ns1:StandingBackBend_ShoulderIssue,
        ns1:StandingBackBend_SpineIssue ;
    ns1:hasCorrectionGuidance "Zur Korrektur das Kinn Richtung Mitte der Schlüsselbein ziehen, den Hinterkopf lang nach hinten führen, das Brustbein aktiv heben, das Becken nach vorn schieben und den Rumpf sowie die Beine durchgehend angespannt halten, sodass die Biegung gleichmäßig über die Brustwirbelsäule verteilt wird."^^xsd:string ;
    ns1:hasDescription "Die Standing Back Bend ist eine stehende Rückbeuge, die Brust und Körpervorderseite öffnet, die Wirbelsäule mobilisiert und gleichzeitig Rumpf, Gesäß und Beine aktiviert."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Advanced ;
    ns1:hasFocusOn ns1:Flexibility ;
    ns1:hasInstruction """1. Stell dich hüftbreit und aufrecht hin, die Hände an die Hüften oder den unteren Rücken.
2. Aktivier den Core, die Oberschenkel und das Gesäß, und strecke die Wirbelsäule nach oben.
3. Atme ein, heb das Brustbein an und zieh die Schultern bewusst nach unten und zurück.
4. Schieb das Becken leicht nach vorn und lehn dich dann kontrolliert aus der Brustwirbelsäule nach hinten.
5. Lass den Kopf nur locker folgen und halt den Nacken lang, statt ihn ruckartig nach hinten zu werfen.
6. Bleib für einige ruhige Atemzüge in der Position und halt Spannung im Bauch und in den Beinen.
7. Spann den Core an und kehr Wirbel für Wirbel langsam in den aufrechten Stand zurück."""^^xsd:string ;
    ns1:hasLimbAlignment ns1:StandingBackbendInstruction,
        ns1:StandingBackbend_Left_Arm,
        ns1:StandingBackbend_Left_Leg,
        ns1:StandingBackbend_Right_Arm,
        ns1:StandingBackbend_Right_Leg,
        ns1:StandingBackbend_Torso ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Flexibility,
        ns1:Focus,
        ns1:Mobility,
        ns1:Posture,
        ns1:Relaxation,
        ns1:Stability ;
    ns1:opens ns1:Chest,
        ns1:Shoulders ;
    ns1:rehabilitates ns1:Shoulders ;
    ns1:strengthens ns1:Back ;
    ns1:stretches ns1:Back,
        ns1:Core,
        ns1:Hip ;
    rdfs:comment "Tittibhasana B"^^xsd:string ;
    rdfs:isDefinedBy "A gentle backbend that helps improve spinal flexibility."^^xsd:string .


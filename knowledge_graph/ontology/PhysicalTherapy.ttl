        ns1:Calves,
        ns1:Legs ;
    ns1:hasContraindication ns1:AnkleIssue,
        ns1:BalanceIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen und die Arme seitlich ausstrecken, um das Gleichgewicht zu erleichtern.
2. Den Blick nach vorne richten und den Rumpf stabil halten.
3. Einen Fuß direkt vor den anderen setzen, sodass die Ferse des vorderen Fußes die Zehen des hinteren berührt.
4. Langsam und bewusst vorwärts gehen, dabei die Füße in einer Linie halten.
5. Beim Wenden große Schritte machen, damit sich die Beine nicht kreuzen.
6. Die Übung idealerweise entlang einer Theke oder Wand durchführen, an der man sich bei Bedarf festhalten kann.
7. Ungefähr zwei Minuten in der Linie vor- und zurückgehen."""^^xsd:string ;
    ns1:improves ns1:Coordination,
        ns1:Flexibility,
        ns1:Mobility ;
    ns1:rehabilitates ns1:AnkleJoint ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Gangübung, bei der abwechselnd auf Fersen und Zehen gegangen wird, um Unterschenkel und Balance zu stärken."@de .


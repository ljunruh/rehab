ns1:WHeben a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "W-Heben"@de,
        "W Raise"@en ;
    ns1:engagedBodyPart ns1:Shoulders,
        ns1:UpperBack ;
    ns1:hasCommonMistake "Vermeide es, die Rumpfspannung zu verlieren oder die Bewegung mit Schwung auszuführen. Halte deinen Rumpf stabil und bewege dich langsam und kontrolliert."^^xsd:string ;
    ns1:hasContraindication ns1:ShoulderIssue ;
    ns1:hasCorrectionGuidance "Führe die Bewegung langsamer aus und halte deine Wirbelsäule in einer neutralen Position. Steigere die Belastung erst, wenn du die Übung sauber und kontrolliert ausführen kannst."^^xsd:string ;
    ns1:hasDescription "Kräftigungsübung zum gezielten Aufbau von kraft im Bereich Schultern."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "4 Min"^^xsd:string ;
    ns1:hasInstruction """Lege dich auf den Bauch oder beuge deinen Oberkörper leicht nach vorne.

* Ziehe deine Schulterblätter sanft nach hinten und unten.
* Hebe deine Arme langsam in der vorgegebenen Position an.
* Senke die Arme anschließend kontrolliert wieder ab."""^^xsd:string ;

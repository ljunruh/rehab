    ns1:partOf ns1:Core ;
    rdfs:comment "Bauchmuskulatur, die den Rumpf stabilisiert und die Körpermitte kräftigt."@de .

ns1:Mountain a ns1:Asana,
        owl:NamedIndividual ;
    rdfs:label "Berg"@de,
        "Mountain"@en ;
    ns1:engagedBodyPart ns1:Ankles,
        ns1:Arms,
        ns1:Back,
        ns1:Hip,
        ns1:Shoulders ;
    ns1:hasBreathingGuidance ns1:MountainInstruction ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasFocusOn ns1:Focus,
        ns1:Posture,
        ns1:Relaxation ;
    ns1:hasLimbAlignment ns1:MountainInstruction,
        ns1:Mountain_Left_Arm,
        ns1:Mountain_Left_Leg,
        ns1:Mountain_Right_Arm,
        ns1:Mountain_Right_Leg,
        ns1:Mountain_Torso ;
    ns1:improves ns1:Focus,
        ns1:Posture,
        ns1:Stability ;
    ns1:strengthens ns1:Ankles,
        ns1:Calves,
        ns1:Core,
        ns1:Glutes,
        ns1:Knees,
        ns1:Thighs ;
    rdfs:comment "Tadasana"^^xsd:string ;
    rdfs:isDefinedBy "A foundational standing pose that encourages proper alignment in the body."^^xsd:string .

ns1:MountainClimber a ns1:Strength,
        owl:NamedIndividual ;
    rdfs:label "Bergsteiger"@de,
        "MountainClimber"@en ;
    ns1:engagedBodyPart ns1:Core,
        ns1:Glutes,
        ns1:Hip,
        ns1:Quadriceps,
        ns1:Shoulders,
        ns1:Triceps ;
    ns1:hasContraindication ns1:BackIssue,
        ns1:ShoulderIssue,
        ns1:WristIssue ;
    ns1:hasDifficultyLevel ns1:Intermediate ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. In die Liegestützposition kommen, Hände unter den Schultern, Arme gestreckt.
2. Den Rumpf stabilisieren, sodass Schultern, Hüfte und Knie eine Linie bilden.
3. Ein Knie kontrolliert in Richtung Brust ziehen.
4. Das Bein zügig, aber kontrolliert wieder in die Ausgangsposition bringen und gleichzeitig das andere Knie nach vorne ziehen.
5. Die Beine in einem gleichmäßigen Rhythmus abwechseln, ohne dass das Becken stark nach oben oder unten schwingt.
6. Anfangs 20 Sekunden arbeiten, 20 Sekunden Pause, insgesamt drei Sätze.
7. Bei besserer Ausdauer auf 30 bis 45 Sekunden pro Satz steigern."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Mobility,
        ns1:Strength ;
    ns1:rehabilitates ns1:Back,
        ns1:Spine ;
    ns1:requiresEquipment ns1:None ;
    ns1:strengthens ns1:Abs,
        ns1:Chest,
        ns1:FrontDeltoid,
        ns1:Quadriceps,
        ns1:Triceps ;
    rdfs:comment "Dynamische Übung im Liegestütz, bei der die Beine abwechselnd zur Brust gezogen werden."@de .

ns1:SpineJoint a ns1:Joint,
        owl:NamedIndividual ;
    rdfs:label "Wirbelsäulengelenke"@de,

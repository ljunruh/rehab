ns1:Gardening a ns1:SportActivity,
        owl:NamedIndividual ;
    rdfs:label "Gartenarbeit"@de,
        "Gardening"@en ;
    ns1:Calorie 286.0 ;
    ns1:MET 4.0 .

ns1:GebetshaltungDehnung a ns1:MobilisationStretching,
        owl:NamedIndividual ;
    rdfs:label "Gebetshaltung-Dehnung"@de,
        "Prayer Stretch"@en ;
    ns1:engagedBodyPart ns1:Back,
        ns1:Spine ;
    ns1:hasCommonMistake "Vermeide federnde Bewegungen und halte nicht die Luft an. Dehne nur so weit, wie es angenehm bleibt und keine Schmerzen verursacht."^^xsd:string ;
    ns1:hasContraindication ns1:BackIssue ;
    ns1:hasCorrectionGuidance "Atme ruhig weiter und halte die Position nur so weit, wie du ein deutliches, aber angenehmes Ziehen spürst."^^xsd:string ;
    ns1:hasDescription "Dehnübung zur gezielten Verbesserung der Beweglichkeit im Bereich Rücken."^^xsd:string ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Geeignete Ausgangsposition einnehmen.
2. Zielbereich langsam bis zu einem deutlichen, schmerzfreien Zug bewegen.
3. Position halten.
4. Langsam lösen und Seite wechseln."""^^xsd:string ;
    ns1:improves ns1:Flexibility,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None .

ns1:GewichtsverlagerungSeitlich a ns1:CoordinationMobility,
        owl:NamedIndividual ;
    rdfs:label "Seitliche Gewichtsverlagerung"@de,
        "LateralWeightShift"@en ;
    ns1:engagedBodyPart ns1:AnkleJoint,
        ns1:Core,
        ns1:Hip,
        ns1:HipJoint,
        ns1:KneeJoint ;
    ns1:hasContraindication ns1:GewichtsverlagerungSeitlich_BalanceIssue ;
    ns1:hasDifficultyLevel ns1:Beginner ;
    ns1:hasDuration "2 Min"^^xsd:string ;
    ns1:hasInstruction """1. Aufrecht stehen, Füße etwas mehr als hüftbreit auseinander, Hände seitlich an den Hüften.
2. Den Blick nach vorne richten, Knie leicht gebeugt und Rumpf aufrecht halten.
3. Das Gewicht langsam auf das rechte Bein verlagern, bis ungefähr 80 Prozent des Gewichts auf der rechten Seite lastet.
4. Das rechte Knie dabei leicht beugen, ohne den Rumpf zur Seite zu neigen.
5. Die Endposition kurz halten, dann langsam zur Mitte zurückkehren.
6. Die Bewegung zur anderen Seite wiederholen.
7. Pro Seite 8 bis 10 Wiederholungen mit bewussten Pausen durchführen."""^^xsd:string ;
    ns1:improves ns1:Balance,
        ns1:Coordination,
        ns1:Mobility ;
    ns1:requiresEquipment ns1:None ;
    rdfs:comment "Übung, bei der das Körpergewicht langsam von einem Bein auf das andere verlagert wird."@de .


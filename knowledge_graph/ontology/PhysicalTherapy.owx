    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#TherabandAussenrotation"/>
        <Literal>Der Ellenbogen entfernt sich vom Körper, das Handgelenk knickt ab oder der Oberkörper dreht mit.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#TherabandAussenrotation"/>
        <Literal>Den Ellenbogen nah am Körper halten, eventuell ein kleines Handtuch zwischen Ellenbogen und Oberkörper klemmen. Nur so weit nach außen rotieren, wie die Schulter stabil bleibt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#TherabandAussenrotation"/>
        <Literal>Kräftigungsübung für die Außenrotatoren der Schulter und die Rotatorenmanschette. Sie unterstützt die Schulterstabilität und kann bei kontrolliertem Training die Haltung des Schultergelenks verbessern.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#TherabandAussenrotation"/>
        <Literal>4 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#TherabandAussenrotation"/>
        <Literal>1. Aufrecht stehen oder sitzen.
2. Das Theraband mit beiden Händen halten.
3. Die Ellenbogen nah am Körper halten und etwa 90 Grad beugen.
4. Einen Unterarm langsam nach außen drehen.
5. Das Handgelenk stabil halten.
6. Langsam in die Ausgangsposition zurückkehren.
7. Die Bewegung kontrolliert wiederholen.</Literal>
    </DataPropertyAssertion>

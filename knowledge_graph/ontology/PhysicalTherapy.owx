    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#RespiratoryIssue</IRI>
        <Literal xml:lang="en">RespiratoryIssue</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#RespiratoryIssue</IRI>
        <Literal xml:lang="de">Atemwegsproblem</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RespiratoryIssue</IRI>
        <Literal xml:lang="de">Vorsicht bei fortgeschrittenen Atemwegserkrankungen wie COPD oder Asthma, da längere Atempausen oder forcierte Atemmuster die Symptome verschlechtern können. Rücksprache mit einem Arzt wird empfohlen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RespiratoryIssue</IRI>
        <Literal xml:lang="en">Caution for advanced respiratory conditions such as COPD or asthma, as extended breath holds or forced breathing patterns may worsen symptoms. Consulting a physician is recommended.</Literal>
    </AnnotationAssertion>


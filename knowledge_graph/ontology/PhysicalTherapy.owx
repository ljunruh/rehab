    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Standing_sleeper_stretch"/>
        <Literal>Zu viel Druck wird auf die Schulter gegeben, der Oberkörper dreht mit oder die Bewegung verursacht stechende Schmerzen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Standing_sleeper_stretch"/>
        <Literal>Nur leichten Druck verwenden und die Schulter stabil halten. Die Dehnung muss sanft bleiben. Bei Schmerz den Winkel oder Bewegungsumfang reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Standing_sleeper_stretch"/>
        <Literal>Dehnübung für die hintere Schulterkapsel und die Innenrotation der Schulter. Sie kann die Beweglichkeit der Schulter verbessern, sollte aber sehr kontrolliert ausgeführt werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Standing_sleeper_stretch"/>
        <Literal>1. Seitlich an eine Wand stellen.
2. Den betroffenen Arm auf Schulterhöhe an die Wand bringen.
3. Den Ellenbogen etwa 90 Grad beugen.
4. Den Unterarm langsam nach unten führen.
5. Eine sanfte Dehnung in der hinteren Schulter spüren.
6. Die Position kurz halten.
7. Langsam lösen.</Literal>
    </DataPropertyAssertion>

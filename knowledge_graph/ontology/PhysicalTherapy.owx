        <NamedIndividual IRI="#Karate"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">10.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Katze-Kuh-Übung"/>
        <Literal>Die Bewegung wird zu schnell ausgeführt, der Nacken wird stark überstreckt oder die Ellenbogen werden gebeugt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Katze-Kuh-Übung"/>
        <Literal>Die Bewegung Wirbel für Wirbel ausführen und den Nacken als Verlängerung der Wirbelsäule halten. Die Arme gestreckt lassen und den Bewegungsumfang bei Beschwerden reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Katze-Kuh-Übung"/>
        <Literal>Eine dynamische Mobilisationsübung für die Wirbelsäule. Durch den kontrollierten Wechsel zwischen Rundrücken und sanfter Streckung werden Rücken, Nacken und Rumpf bewegt und die Wahrnehmung der Wirbelsäulenposition verbessert.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Katze-Kuh-Übung"/>
        <Literal>1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Beim Ausatmen den Rücken langsam runden.
4. Das Kinn leicht zur Brust führen und den Bauchnabel nach innen ziehen.
5. Beim Einatmen das Becken kippen und die Wirbelsäule sanft nach unten bewegen.
6. Brustbein und Blick leicht nach vorne anheben.
7. Die Bewegung langsam und fließend wiederholen.
8. Nur im angenehmen Bewegungsbereich arbeiten.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Calorie"/>
        <NamedIndividual IRI="#Kayaking"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">357.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#MET"/>
        <NamedIndividual IRI="#Kayaking"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">5.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Kindpose"/>
        <Literal>Das Becken wird gewaltsam zu den Fersen gedrückt, der Nacken bleibt angespannt oder die Knieposition verursacht Schmerzen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Kindpose"/>
        <Literal>Nur so weit zurückgehen, wie es angenehm möglich ist. Bei eingeschränkter Beweglichkeit ein Kissen unter Brust oder Gesäß legen. Die Knie weiter oder enger positionieren, bis Hüfte und Knie entspannt bleiben.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Kindpose"/>
        <Literal>Eine ruhige Bodenposition zur Entspannung und sanften Mobilisation von Rücken und Hüfte. Der Oberkörper wird nach vorne abgesenkt, während das Becken in Richtung Fersen bewegt wird. Die Position kann mit einem Kissen oder Block angepasst werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Kindpose"/>
        <Literal>1. In den Vierfüßlerstand kommen.
2. Die Knie bequem auseinanderstellen und die großen Zehen zueinander führen.
3. Das Becken langsam in Richtung Fersen zurückschieben.
4. Den Oberkörper zwischen oder auf den Oberschenkeln ablegen.
5. Die Arme nach vorne ausstrecken oder entspannt neben dem Körper ablegen.
6. Die Stirn auf dem Boden, einem Kissen oder einem Block ablegen.
7. Ruhig und gleichmäßig atmen.
8. Die Position für mehrere Atemzüge halten und anschließend langsam verlassen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#KingDancer_Left_Arm"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">90.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#KingDancer_Left_Leg"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">0.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#KingDancer_Right_Arm"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">90.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>

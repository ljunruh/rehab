    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#AllFourswithLegExtension"/>
        <Literal>Das Becken kippt zur Seite, der untere Rücken geht ins Hohlkreuz oder das Bein wird zu hoch gehoben.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#AllFourswithLegExtension"/>
        <Literal>Das Bein nur bis auf Hüfthöhe anheben und den Rücken neutral halten. Die Bewegung langsam und ohne Schwung ausführen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#AllFourswithLegExtension"/>
        <Literal>Stabilisationsübung für Rumpf, Gesäß und unteren Rücken im Vierfüßlerstand. Die Übung trainiert Kontrolle, Gleichgewicht und Beckenstabilität.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#AllFourswithLegExtension"/>
        <Literal>3 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#AllFourswithLegExtension"/>
        <Literal>1. In den Vierfüßlerstand kommen.
2. Hände unter den Schultern und Knie unter der Hüfte positionieren.
3. Bauch leicht anspannen.
4. Ein Bein langsam nach hinten ausstrecken.
5. Das Becken möglichst stabil halten.
6. Das Bein kontrolliert wieder absetzen.
7. Die Seite wechseln und wiederholen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDailyLifeAdvice"/>
        <NamedIndividual IRI="#AlternateSittingAndStanding"/>
        <Literal xml:lang="de">Regelmäßiger Wechsel zwischen Sitzen und Stehen, um einseitige Belastungen zu reduzieren und die Wirbelsäule zu entlasten.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Calorie"/>
        <NamedIndividual IRI="#Archery"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">250.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#MET"/>
        <NamedIndividual IRI="#Archery"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">3.5</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Armkreisen"/>
        <Literal>Die Schultern werden hochgezogen, die Bewegung wird zu schnell ausgeführt oder der Oberkörper weicht stark aus.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Armkreisen"/>
        <Literal>Die Schultern bewusst locker lassen und die Bewegung langsam kontrollieren. Den Bewegungsradius verkleinern, wenn Schmerzen oder Ausweichbewegungen auftreten.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Armkreisen"/>
        <Literal>Eine einfache Mobilisationsübung für Schultergelenke, Schultergürtel und oberen Rücken. Die Übung verbessert die Beweglichkeit der Schultern und bereitet die Muskulatur auf weitere Bewegungen vor.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#Armkreisen"/>
        <Literal>2 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Armkreisen"/>
        <Literal>1. Aufrecht stehen oder sitzen.
2. Die Arme seitlich ausstrecken oder locker neben dem Körper halten.
3. Kleine kontrollierte Kreise mit den Armen ausführen.
4. Die Kreise langsam größer werden lassen.
5. Nach einigen Wiederholungen die Richtung wechseln.
6. Die Schultern entspannt halten und gleichmäßig atmen</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#AssistedShoulderRotation"/>
        <Literal>Die Bewegung wird zu stark gezogen, der Ellenbogen entfernt sich vom Körper oder der Oberkörper dreht mit.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#AssistedShoulderRotation"/>
        <Literal>Den Ellenbogen stabil am Körper halten und nur sanften Druck verwenden. Der Bewegungsbereich soll schmerzfrei bleiben.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#AssistedShoulderRotation"/>
        <Literal>Sanfte Mobilisationsübung für die Schulterrotation mit Unterstützung durch die andere Hand, einen Stab oder ein Hilfsmittel. Sie verbessert die kontrollierte Beweglichkeit der Schulter.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#AssistedShoulderRotation"/>
        <Literal>2 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#AssistedShoulderRotation"/>
        <Literal>1. Aufrecht sitzen oder stehen.
2. Den Ellenbogen des zu bewegenden Arms nah am Körper halten.
3. Einen Stab oder die andere Hand zur Unterstützung verwenden.
4. Den Unterarm langsam in die gewünschte Rotationsrichtung bewegen.
5. Die Bewegung nur passiv oder leicht aktiv unterstützen.
6. Kurz halten und langsam zurückführen.
7. Mehrmals kontrolliert wiederholen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Atemuebung478"/>
        <Literal>Die Luft wird mit Kraft angehalten, die Schultern werden beim Einatmen hochgezogen oder die Atemphasen werden zu schnell ausgeführt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Atemuebung478"/>
        <Literal>Nur so tief einatmen und so lange pausieren, wie es angenehm möglich ist. Schultern und Gesicht entspannt lassen. Bei Schwierigkeiten kann zunächst ein kürzerer Rhythmus verwendet werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Atemuebung478"/>
        <Literal>Eine kontrollierte Atemübung zur Entspannung und zur bewussten Verlangsamung der Atmung. Die Übung lenkt die Aufmerksamkeit auf einen gleichmäßigen Atemrhythmus und kann im Sitzen oder Liegen durchgeführt werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Atemuebung478"/>
        <Literal>1. Eine bequeme Sitz- oder Liegeposition einnehmen und die Schultern entspannen.
2. Ruhig durch die Nase einatmen und dabei bis vier zählen.
3. Den Atem ohne starkes Pressen halten und bis sieben zählen.
4. Langsam durch den Mund ausatmen und dabei bis acht zählen.
5. Kurz normal weiteratmen.
6. Den Ablauf drei- bis viermal wiederholen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDailyLifeAdvice"/>
        <NamedIndividual IRI="#AvoidForwardHeadPosture"/>
        <Literal xml:lang="de">Vermeidung einer nach vorne geschobenen Kopfhaltung, um Nacken- und Schulterbelastungen zu verringern.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>

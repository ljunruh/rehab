    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#WallPushUps"/>
        <Literal>Der Rücken hängt durch, die Schultern werden hochgezogen oder die Ellenbogen gehen stark nach außen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#WallPushUps"/>
        <Literal>Bauch leicht anspannen und den Körper in einer Linie halten. Die Schultern tief halten und die Ellenbogen leicht schräg nach hinten führen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#WallPushUps"/>
        <Literal>Eine vereinfachte Liegestützvariante an der Wand. Die Übung kräftigt Brust, Schultern, Arme und Rumpf mit reduzierter Belastung im Vergleich zu klassischen Liegestützen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#WallPushUps"/>
        <Literal>3 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#WallPushUps"/>
        <Literal>1. Vor eine Wand stellen.
2. Die Hände etwa schulterbreit an die Wand setzen.
3. Die Füße etwas von der Wand entfernen.
4. Den Körper gerade halten.
5. Die Ellenbogen langsam beugen und den Oberkörper zur Wand führen.
6. Kontrolliert zurückdrücken.
7. Die Bewegung ruhig wiederholen.</Literal>
    </DataPropertyAssertion>

    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Arm oder Bein werden auf dem Boden abgelegt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Der Kopf wird angehoben und der Nacken unnötig angespannt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Der untere Rücken hebt sich vom Boden ab und bildet ein Hohlkreuz.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Die Bauchspannung wird während der Bewegung verloren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Bei Verlust der Rumpfspannung den Bewegungsumfang verkleinern.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Den unteren Rücken während der gesamten Bewegung sanft gegen den Boden drücken.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Die Bewegung langsam und kontrolliert ausführen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Kopf und Schultern entspannt auf dem Boden lassen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Nur so weit strecken, wie die neutrale Rückenposition gehalten werden kann.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>Der Dead Bug aktiviert vor allem die tiefe Rumpfmuskulatur, insbesondere den Musculus transversus abdominis. Die Übung unterstützt die Stabilisierung von Wirbelsäule und Becken und trainiert die koordinierte Bewegung von Armen und Beinen bei kontrollierter Rumpfspannung.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#DeadBug"/>
        <Literal>1. Auf den Rücken legen und beide Arme senkrecht zur Decke strecken.
2. Hüfte und Knie ungefähr im 90-Grad-Winkel beugen und die Füße vom Boden anheben.
3. Den unteren Rücken kontrolliert auf dem Boden halten und die Bauchmuskulatur anspannen.
4. Einen Arm langsam hinter den Kopf führen und gleichzeitig das gegenüberliegende Bein in Richtung Boden strecken.
5. Arm und Bein nicht ablegen, sondern einige Zentimeter über dem Boden halten.
6. Die Position für ein bis zwei Atemzüge halten.
7. Arm und Bein langsam in die Ausgangsposition zurückführen.
8. Die Bewegung mit dem anderen Arm und dem anderen Bein wiederholen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Deadlift"/>
        <Literal>Der Rücken rundet sich, die Knie schieben zu weit nach vorne oder das Gewicht wird aus dem unteren Rücken gehoben.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Deadlift"/>
        <Literal>Die Bewegung aus der Hüfte einleiten und die Wirbelsäule neutral halten. Mit wenig oder keinem Zusatzgewicht beginnen und den Bewegungsumfang reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Deadlift"/>
        <Literal>Kräftigungsübung für hintere Oberschenkelmuskulatur, Gesäß, Rückenstrecker und Rumpf. Der Fokus liegt auf der Hüftbeugebewegung und einer stabilen Wirbelsäule.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#Deadlift"/>
        <Literal>5 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Deadlift"/>
        <Literal>1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken kontrolliert nach hinten schieben.
4. Den Rücken gerade halten.
5. Den Oberkörper nach vorne neigen, ohne den Rücken zu runden.
6. Über Gesäß und hintere Oberschenkel wieder aufrichten.
7. Die Bewegung langsam wiederholen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#Eagle_Left_Arm"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">90.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#Eagle_Left_Leg"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">45.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#Eagle_Right_Arm"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">90.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#Eagle_Right_Leg"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">45.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#angle"/>
        <NamedIndividual IRI="#Eagle_Torso"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">0.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDailyLifeAdvice"/>
        <NamedIndividual IRI="#EnBlocBedExit"/>
        <Literal xml:lang="de">Beim Aufstehen aus dem Bett zunächst auf die Seite rollen, dabei Schultern und Becken gleichzeitig drehen, dann die Beine über die Bettkante schieben und sich mit dem Arm abstützen, um Verdrehungen der Wirbelsäule zu vermeiden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDailyLifeAdvice"/>
        <NamedIndividual IRI="#ErgonomicSitting"/>
        <Literal xml:lang="de">Aufrechte, unterstützte Sitzhaltung mit angepasster Stuhl- und Tischhöhe zur Entlastung von Rücken, Nacken und Schultern.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#FaszienrolleRueckenWade"/>
        <Literal>Zu schnelles Rollen, zu starker Druck, direktes Rollen über Knochen oder Gelenke sowie eine angespannte Körperhaltung.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#FaszienrolleRueckenWade"/>
        <Literal>Die Bewegung langsam ausführen und den Druck über Arme und Beine kontrollieren. Bei stechendem Schmerz, Taubheit oder starkem Unwohlsein sofort stoppen. Nicht direkt über verletzte oder akut entzündete Bereiche rollen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#FaszienrolleRueckenWade"/>
        <Literal>Direkter Druck auf Knochen, Gelenke und die Lendenwirbelsäule sollte vermieden werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#FaszienrolleRueckenWade"/>
        <Literal>Eine Selbstmassage mit der Faszienrolle für verspannte Muskelbereiche des oberen Rückens und der Waden. Durch langsamen, kontrollierten Druck können beanspruchte Muskeln bearbeitet und die Beweglichkeit unterstützt werden.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#FaszienrolleRueckenWade"/>
        <Literal>1. Die Faszienrolle auf eine stabile Unterlage legen.
2. Für den oberen Rücken die Rolle unterhalb der Schulterblätter positionieren und den Oberkörper leicht anheben.
3. Langsam zwischen oberem Rücken und Schulterblattregion vor- und zurückrollen.
4. Nicht direkt über die Wirbelsäule oder den Nacken rollen.
5. Für die Wade im Sitzen die Rolle unter eine Wade legen.
6. Das Bein langsam vom Sprunggelenk bis unterhalb des Knies über die Rolle bewegen.
7. Empfindliche Stellen kurz und mit reduziertem Druck bearbeiten.
8. Anschließend die Seite wechseln.</Literal>
    </DataPropertyAssertion>

    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#Wadendehnung"/>
        <Literal>Die hintere Ferse hebt sich vom Boden ab, der Fuß dreht nach außen oder das hintere Knie wird unkontrolliert gebeugt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#Wadendehnung"/>
        <Literal>Die Ferse bewusst in Richtung Boden drücken und den Fuß gerade ausrichten. Den Abstand zur Wand verkleinern, wenn die Ferse nicht unten bleibt oder die Dehnung zu intensiv ist.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#Wadendehnung"/>
        <Literal>Eine Dehnübung für die Wadenmuskulatur und den Bereich des Sprunggelenks. Sie kann die Beweglichkeit des Fußgelenks unterstützen und Spannungen in der Wade reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#Wadendehnung"/>
        <Literal>1. Vor eine Wand stellen und beide Hände an der Wand abstützen.
2. Ein Bein nach hinten setzen.
3. Die hintere Ferse am Boden lassen.
4. Die Fußspitze des hinteren Beins nach vorne ausrichten.
5. Das vordere Knie leicht beugen.
6. Das Becken langsam nach vorne verlagern.
7. Die Dehnung in der Wade des hinteren Beins halten.
8. Ruhig atmen und anschließend die Seite wechseln.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Calorie"/>
        <NamedIndividual IRI="#Walking11MinMile"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">785.0</Literal>
    </DataPropertyAssertion>

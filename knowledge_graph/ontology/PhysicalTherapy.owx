    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Die Bewegung wird ruckartig ausgeführt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Die Schultern werden zu den Ohren gezogen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Es entsteht ein starkes Hohlkreuz.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Den Brustkorb nicht übermäßig nach vorne schieben.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Die Bewegung langsam und nur im schmerzfreien Bereich ausführen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Nacken lang und Schultern entspannt halten.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>Kräftigt die Muskulatur des oberen Rückens und der Schulterregion und kann helfen, Verspannungen durch langes Sitzen oder Bildschirmarbeit zu reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#ScapulaRetraktion"/>
        <Literal>1. Aufrecht stehen und die Ellenbogen im 90-Grad-Winkel halten.
2. Schultern und Ellenbogen langsam nach hinten bewegen.
3. Schulterblätter kontrolliert zusammenziehen.
4. Kurz halten.
5. Langsam in die Ausgangsposition zurückkehren.&quot;</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#SchulterNackenEntspannung"/>
        <Literal>Die Schultern werden hochgezogen gehalten, der Kopf wird mit der Hand stark zur Seite gezogen oder die Bewegungen werden schnell und ruckartig ausgeführt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#SchulterNackenEntspannung"/>
        <Literal>Den Nacken lang halten und die Schultern bewusst nach unten entspannen. Nur einen kleinen Bewegungsumfang verwenden, wenn Spannung oder Beschwerden auftreten. Keine kreisenden Vollbewegungen des Kopfes erzwingen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#SchulterNackenEntspannung"/>
        <Literal>Eine sanfte Bewegungsfolge zur Lockerung der Schulter- und Nackenregion. Sie eignet sich besonders nach längerem Sitzen oder Bildschirmarbeit und verbindet bewusste Atmung mit langsamen Schulter- und Kopfbewegungen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#SchulterNackenEntspannung"/>
        <Literal>1. Aufrecht sitzen oder stehen und die Arme locker neben dem Körper halten.
2. Die Schultern langsam zu den Ohren anheben.
3. Beim Ausatmen die Schultern bewusst nach unten sinken lassen.
4. Die Schultern langsam nach hinten kreisen.
5. Den Kopf anschließend vorsichtig zu einer Seite neigen, ohne die Schulter anzuheben.
6. Die Position für zwei bis drei ruhige Atemzüge halten.
7. Zur Mitte zurückkehren und die andere Seite ausführen.
8. Zum Abschluss den Kopf langsam nach rechts und links drehen.
9. Alle Bewegungen im schmerzfreien Bereich ausführen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#SealStretch"/>
        <Literal>Die Schultern werden hochgezogen, die Ellenbogen werden durchgedrückt oder die Bewegung wird trotz Rückenschmerzen erzwungen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#SealStretch"/>
        <Literal>Die Arme nur so weit strecken, wie es angenehm ist. Schultern tief halten und bei Druck im unteren Rücken die Höhe reduzieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#SealStretch"/>
        <Literal>Mobilisations- und Dehnübung für die vordere Rumpfseite und die Wirbelsäulenstreckung. Die Übung wird häufig zur sanften Extension der Wirbelsäule genutzt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#SealStretch"/>
        <Literal>1. In Bauchlage starten.
2. Hände neben oder leicht vor den Schultern aufstützen.
3. Den Oberkörper langsam anheben.
4. Das Becken bleibt möglichst am Boden.
5. Schultern weg von den Ohren halten.
6. Die Position kurz halten und ruhig atmen.
7. Langsam wieder absenken.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#date"/>
        <NamedIndividual IRI="#Session0001"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-11T00:00:00</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#duration"/>
        <NamedIndividual IRI="#Session0001"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">60</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#ShoulderInternalExternalRotation"/>
        <Literal>Der Oberkörper dreht mit, der Ellenbogen wandert nach außen oder die Bewegung wird ruckartig ausgeführt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#ShoulderInternalExternalRotation"/>
        <Literal>Den Ellenbogen nah am Körper halten und die Bewegung nur aus dem Schultergelenk ausführen. Den Bewegungsumfang reduzieren, wenn Ausweichbewegungen entstehen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#ShoulderInternalExternalRotation"/>
        <Literal>Mobilisations- und Kontrollübung für Innen- und Außenrotation der Schulter. Die Übung verbessert die Bewegungswahrnehmung und unterstützt die funktionelle Schulterbeweglichkeit.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#ShoulderInternalExternalRotation"/>
        <Literal>1. Aufrecht stehen oder sitzen.
2. Den Ellenbogen am Körper halten und etwa 90 Grad beugen.
3. Den Unterarm langsam nach außen rotieren.
4. Anschließend kontrolliert nach innen rotieren.
5. Die Bewegung langsam und schmerzfrei ausführen.
6. Die Schulter während der Bewegung stabil halten</Literal>
    </DataPropertyAssertion>

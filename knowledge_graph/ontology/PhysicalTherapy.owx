    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#HueftbeugerDehnung"/>
        <Literal>Das Becken wird stark nach vorne geschoben, der untere Rücken bildet ein Hohlkreuz oder der Oberkörper kippt weit nach vorne.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#HueftbeugerDehnung"/>
        <Literal>Das Becken leicht nach hinten kippen und die Bauchmuskulatur sanft anspannen. Den Oberkörper aufrecht halten und nur so weit nach vorne gehen, bis eine angenehme Dehnung spürbar ist.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#HueftbeugerDehnung"/>
        <Literal>Eine Dehnübung für die Hüftbeugemuskulatur. Sie kann die Beweglichkeit der Hüfte unterstützen und Spannungsgefühle reduzieren, die beispielsweise durch langes Sitzen entstehen.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#HueftbeugerDehnung"/>
        <Literal>1. In einen halben Kniestand kommen, wobei ein Knie am Boden liegt.
2. Das vordere Bein ungefähr im rechten Winkel aufstellen.
3. Den Oberkörper aufrecht halten.
4. Das Becken leicht nach hinten kippen.
5. Das Becken langsam nach vorne verlagern, ohne ein Hohlkreuz zu bilden.
6. Die Dehnung an der Vorderseite der Hüfte des hinteren Beins wahrnehmen.
7. Die Position ruhig halten und gleichmäßig atmen.
8. Anschließend die Seite wechseln.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Calorie"/>
        <NamedIndividual IRI="#IceSkating"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">393.0</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#MET"/>
        <NamedIndividual IRI="#IceSkating"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#decimal">5.5</Literal>
    </DataPropertyAssertion>

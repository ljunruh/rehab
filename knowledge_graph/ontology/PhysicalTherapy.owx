    <DataPropertyAssertion>
        <DataProperty IRI="#hasCommonMistake"/>
        <NamedIndividual IRI="#StandingPelvicTilts"/>
        <Literal>Die Bewegung wird aus den Knien oder dem Oberkörper gemacht, statt aus dem Becken. Der Rücken wird stark überstreckt.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasCorrectionGuidance"/>
        <NamedIndividual IRI="#StandingPelvicTilts"/>
        <Literal>Die Bewegung klein halten und bewusst aus dem Becken steuern. Bauch- und Gesäßmuskulatur leicht aktivieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDescription"/>
        <NamedIndividual IRI="#StandingPelvicTilts"/>
        <Literal>Kontrollübung für Beckenposition und unteren Rücken. Sie verbessert die Wahrnehmung von Beckenkippung und kann helfen, die Lendenwirbelsäule besser zu kontrollieren.</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasDuration"/>
        <NamedIndividual IRI="#StandingPelvicTilts"/>
        <Literal>2 Min</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasInstruction"/>
        <NamedIndividual IRI="#StandingPelvicTilts"/>
        <Literal>1. Aufrecht stehen, Füße etwa hüftbreit.
2. Knie leicht beugen.
3. Das Becken langsam nach vorne kippen.
4. Danach das Becken langsam nach hinten kippen.
5. Die Bewegung klein und kontrolliert ausführen.
6. Den Oberkörper möglichst ruhig halten.
7. Mehrere Wiederholungen langsam durchführen.</Literal>
    </DataPropertyAssertion>
